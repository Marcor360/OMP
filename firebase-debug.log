',\n          'description',\n          'status',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && hasAllKeys(data, [\n          'congregationId',\n          'number',\n          'name',\n          'description',\n          'status',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == congregationId\n        && (data.number == null || data.number is number)\n        && isNonEmptyString(data.name)\n        && data.name.size() <= 50\n        && data.description is string\n        && data.description.size() <= 160\n        && data.status in ['active', 'inactive']\n        && data.createdBy is string\n        && data.updatedBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function validTerritoryCreate(data, congregationId) {\n      return validTerritoryData(data, congregationId)\n        && data.status == 'active'\n        && data.createdBy == currentUid()\n        && data.updatedBy == currentUid();\n    }\n\n    function validTerritoryUpdate(data, congregationId) {\n      return validTerritoryData(data, congregationId)\n        && data.congregationId == resource.data.congregationId\n        && data.createdBy == resource.data.createdBy\n        && data.createdAt == resource.data.createdAt\n        && data.updatedBy == currentUid();\n    }\n\n    function validTerritoryScheduleData(data, congregationId, scheduleId) {\n      return hasOnlyKeys(data, [\n          'congregationId',\n          'dayOfWeek',\n          'territoryIds',\n          'note',\n          'isActive',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && hasAllKeys(data, [\n          'congregationId',\n          'dayOfWeek',\n          'territoryIds',\n          'note',\n          'isActive',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == congregationId\n        && data.dayOfWeek == scheduleId\n        && isValidTerritoryDay(data.dayOfWeek)\n        && data.territoryIds is list\n        && data.territoryIds.size() <= 50\n        && data.note is string\n        && data.note.size() <= 300\n        && data.isActive is bool\n        && data.createdBy is string\n        && data.updatedBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function validTerritoryScheduleCreate(data, congregationId, scheduleId) {\n      return validTerritoryScheduleData(data, congregationId, scheduleId)\n        && data.createdBy == currentUid()\n        && data.updatedBy == currentUid();\n    }\n\n    function validTerritoryScheduleUpdate(data, congregationId, scheduleId) {\n      return validTerritoryScheduleData(data, congregationId, scheduleId)\n        && data.congregationId == resource.data.congregationId\n        && data.dayOfWeek == resource.data.dayOfWeek\n        && data.createdBy == resource.data.createdBy\n        && data.createdAt == resource.data.createdAt\n        && data.updatedBy == currentUid();\n    }\n\n    // =========================================================================\n    // CLEANING GROUPS\n    // =========================================================================\n\n    function allowedCleaningGroupKeys() {\n      return [\n        'name',\n        'description',\n        'congregationId',\n        'groupType',\n        'memberIds',\n        'memberCount',\n        'isActive',\n        'createdBy',\n        'createdAt',\n        'updatedAt'\n      ];\n    }\n\n    function validCleaningGroupData(data, congregationId) {\n      return hasOnlyKeys(data, allowedCleaningGroupKeys())\n        && hasAllKeys(data, [\n          'name',\n          'congregationId',\n          'groupType',\n          'memberIds',\n          'memberCount',\n          'isActive',\n          'createdBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.name)\n        && data.name.size() <= 80\n        && data.groupType in ['standard', 'family']\n        && data.memberIds is list\n        && data.memberIds.size() <= 200\n        && data.memberCount is int\n        && data.memberCount >= 0\n        && data.memberCount <= 200\n        && data.memberCount == data.memberIds.size()\n        && data.isActive is bool\n        && data.createdBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && (!('description' in data) || (data.description is string && data.description.size() <= 300));\n    }\n\n    // =========================================================================\n    // NOTIFICATIONS\n    // =========================================================================\n\n    function allowedNotificationKeys() {\n      return [\n        'congregationId',\n        'userId',\n        'title',\n        'body',\n        'type',\n        'isRead',\n        'relatedId',\n        'createdAt',\n        'readAt'\n      ];\n    }\n\n    function validNotificationData(data, congregationId) {\n      return hasOnlyKeys(data, allowedNotificationKeys())\n        && hasAllKeys(data, ['congregationId', 'title', 'body', 'type', 'isRead'])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.title)\n        && isNonEmptyString(data.body)\n        && isNonEmptyString(data.type)\n        && data.isRead is bool\n        && (!('userId' in data) || data.userId is string)\n        && (!('relatedId' in data) || data.relatedId is string);\n    }\n\n    function validOutgoingTalkStatus(status) {\n      return status is string && status in ['scheduled', 'cancelled', 'completed'];\n    }\n\n    function validDateKey(value) {\n      return value is string\n        && value.matches('^\\\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');\n    }\n\n    function validTimeKey(value) {\n      return value is string\n        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');\n    }\n\n    function validOutgoingTalkData(data, congregationId) {\n      return hasOnlyKeys(data, [\n          'congregationId',\n          'speakerUserId',\n          'speakerName',\n          'destinationCongregationName',\n          'talkDate',\n          'talkTime',\n          'weekStartDate',\n          'weekEndDate',\n          'status',\n          'notes',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && hasAllKeys(data, [\n          'congregationId',\n          'speakerUserId',\n          'speakerName',\n          'destinationCongregationName',\n          'talkDate',\n          'talkTime',\n          'weekStartDate',\n          'weekEndDate',\n          'status',\n          'createdBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.speakerUserId)\n        && isNonEmptyString(data.speakerName)\n        && isNonEmptyString(data.destinationCongregationName)\n        && validDateKey(data.talkDate)\n        && validTimeKey(data.talkTime)\n        && validDateKey(data.weekStartDate)\n        && validDateKey(data.weekEndDate)\n        && data.weekStartDate <= data.talkDate\n        && data.talkDate <= data.weekEndDate\n        && validOutgoingTalkStatus(data.status)\n        && data.createdBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && (!('updatedBy' in data) || data.updatedBy is string)\n        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));\n    }\n\n    // =========================================================================\n    // CHANGE LOGS\n    // =========================================================================\n\n    function allowedChangeLogKeys() {\n      return [\n        'congregationId',\n        'actorUserId',\n        'actorName',\n        'action',\n        'entityType',\n        'entityId',\n        'description',\n        'metadata',\n        'createdAt'\n      ];\n    }\n\n    function validChangeLogData(data, congregationId) {\n      return hasOnlyKeys(data, allowedChangeLogKeys())\n        && hasAllKeys(data, ['congregationId', 'actorUserId', 'action', 'entityType', 'entityId', 'createdAt'])\n        && data.congregationId == congregationId\n        && data.actorUserId == currentUid()\n        && isNonEmptyString(data.action)\n        && isNonEmptyString(data.entityType)\n        && isNonEmptyString(data.entityId)\n        && (!('actorName' in data) || data.actorName is string)\n        && (!('description' in data) || data.description is string)\n        && (!('metadata' in data) || data.metadata is map);\n    }\n\n    function validMonthId(monthId) {\n      return monthId is string\n        && monthId.matches('^\\\\d{4}-(0[1-9]|1[0-2])$');\n    }\n\n    function allowedPreachingReportKeys() {\n      return [\n        'userId',\n        'userName',\n        'congregationId',\n        'congregationName',\n        'monthId',\n        'monthName',\n        'participated',\n        'bibleStudies',\n        'returnVisits',\n        'comments',\n        'isPioneer',\n        'pioneerType',\n        'hours',\n        'submittedAt',\n        'updatedAt',\n        'submittedBy'\n      ];\n    }\n\n    function validPreachingReportWrite(data, congregationId, monthId, userId) {\n      return hasOnlyKeys(data, allowedPreachingReportKeys())\n        && hasAllKeys(data, [\n          'userId',\n          'userName',\n          'congregationId',\n          'monthId',\n          'monthName',\n          'participated',\n          'bibleStudies',\n          'returnVisits',\n          'isPioneer',\n          'submittedAt',\n          'updatedAt',\n          'submittedBy'\n        ])\n        && validMonthId(monthId)\n        && data.userId == userId\n        && data.userId == currentUid()\n        && data.submittedBy == currentUid()\n        && data.congregationId == congregationId\n        && data.monthId == monthId\n        && data.userName is string\n        && data.monthName is string\n        && (!('congregationName' in data) || data.congregationName is string)\n        && data.participated is bool\n        && data.bibleStudies is int\n        && data.bibleStudies >= 0\n        && data.returnVisits is int\n        && data.returnVisits >= 0\n        && (\n          !('comments' in data)\n          || data.comments == null\n          || (data.comments is string && data.comments.size() <= 500)\n        )\n        && data.isPioneer is bool\n        && data.isPioneer == isPioneer()\n        && (\n          !('pioneerType' in data)\n          || data.pioneerType == null\n          || data.pioneerType in ['regular', 'auxiliary']\n        )\n        && data.submittedAt is timestamp\n        && data.updatedAt is timestamp\n        && (\n          isPioneer()\n          || !('hours' in data)\n          || data.hours == null\n        )\n        && (\n          !isPioneer()\n          || data.hours is number\n          || data.hours == null\n        )\n        && (\n          !isPioneer()\n          || data.hours == null\n          || data.hours >= 0\n        );\n    }\n\n    // =========================================================================\n    // REGLAS: SYSTEM\n    // Solo lectura para usuarios autenticados.\n    // Usado por cache-control-service.ts para leer system/cacheControl.\n    // Escritura reservada exclusivamente para Cloud Functions / consola admin.\n    // =========================================================================\n\n    match /system/{docId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    // =========================================================================\n    // REGLAS: SYSTEM ANNOUNCEMENTS\n    // Avisos globales administrados desde la app administrativa.\n    // =========================================================================\n\n    match /systemAnnouncements/{announcementId} {\n      allow read: if isAuthenticated();\n      allow create, update, delete: if isSuperAdmin();\n    }\n\n    // =========================================================================\n    // REGLAS: SUPER ADMINS\n    // =========================================================================\n\n    match /superAdmins/{userId} {\n      allow read: if request.auth != null && request.auth.uid == userId;\n      allow create, update, delete: if false;\n    }\n\n    // =========================================================================\n    // REGLAS: USERS\n    // =========================================================================\n\n    match /events/{eventId} {\n      allow get, list: if isActive()\n        && resource.data.congregationId == myCongregationId()\n        && canAccessCongregationData(resource.data.congregationId);\n      allow create: if validEventCreate();\n      allow update: if validEventUpdate();\n      allow delete: if isAdminOrSupervisor()\n        && resource.data.congregationId == myCongregationId();\n    }\n\n    match /users/{userId} {\n      allow get: if isSuperAdmin() \n        || isSameUser(userId)\n        || (canReadUsers() && storedDocInMyCongregation());\n\n      // list sólo dentro de la propia congregación.\n      // Firestore Security Rules no permiten inspeccionar filtros de query,\n      // por lo que la restricción real se aplica en la app (siempre filtra por congregationId).\n      // myCongregationId() != null garantiza que el solicitante tiene perfil activo con congregación.\n      allow list: if isSuperAdmin() \n        || (canListCongregationUsers() && myCongregationId() != null);\n\n      allow create: if isSuperAdmin() || (canCreateUsers()\n        && validUserCreate(userId)\n        && targetDocInMyCongregation()\n        && safeDelegatedUserCreate());\n\n      allow update: if isSuperAdmin() || (\n          canEditUsers()\n          && storedDocInMyCongregation()\n          && targetDocInMyCongregation()\n          && validUserUpdateByAdmin(userId)\n          && safeDelegatedUserUpdate()\n        ) || (\n          validSelfUserUpdate(userId)\n        ) || (\n          // Registro de token push: el propio usuario actualiza SOLO su token.\n          validPushTokenUpdate(userId)\n        ) || (\n          // Gestion de grupos de limpieza: solo campos de membresia de limpieza.\n          validCleaningMembershipUserUpdate()\n        );\n\n      allow delete: if isSuperAdmin() || (\n          canDeleteUsers()\n          && storedDocInMyCongregation()\n          && resource.data.role != 'admin'\n          && resource.data.role != 'administrador'\n          && !isSystemPrincipalUserData(resource.data)\n        );\n\n      match /pushTokens/{tokenDocId} {\n        allow get, list: if isSameUser(userId);\n        allow create, update: if validExpoPushTokenDoc(userId);\n        allow delete: if isSameUser(userId);\n      }\n\n      match /viewedAnnouncements/{announcementId} {\n        allow get, list: if isSameUser(userId);\n        allow create, update: if isSameUser(userId)\n          && validViewedAnnouncementData(announcementId);\n        allow delete: if false;\n      }\n    }\n\n    // =========================================================================\n    // REGLAS: CONGREGATIONS\n    // =========================================================================\n\n    match /congregations/{congregationId} {\n      allow get: if isSuperAdmin() || sameCongregation(congregationId);\n      allow list: if isSuperAdmin();\n\n      allow create: if isSuperAdmin() || (isAdmin()\n        && canAccessCongregationData(congregationId)\n        && validCongregationData(request.resource.data));\n\n      allow update: if isSuperAdmin() || (isAdmin()\n        && canAccessCongregationData(congregationId)\n        && validCongregationData(request.resource.data)\n        && preservesCreatedAt());\n\n      allow delete: if false;\n\n      match /private/{privateDocId} {\n        allow get, list: if sameCongregation(congregationId)\n          && canAccessCongregationData(congregationId)\n          && isAdmin();\n        allow write: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // PERSONS\n      // -----------------------------------------------------------------------\n      match /persons/{personId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validPersonData(request.resource.data, congregationId);\n\n        allow update: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validPersonData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin();\n      }\n\n      // -----------------------------------------------------------------------\n      // MEETINGS\n      // -----------------------------------------------------------------------\n      match /meetings/{meetingId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isMeetingsManager()\n          && canAccessCongregationData(congregationId)\n          && validMeetingData(request.resource.data, congregationId);\n\n        allow update: if isMeetingsManager()\n          && canAccessCongregationData(congregationId)\n          && validMeetingData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin();\n\n        // ---------------------------------------------------------------------\n        // ASSIGNMENTS\n        // ---------------------------------------------------------------------\n        match /assignments/{assignmentId} {\n          allow get, list: if canAccessCongregationData(congregationId);\n\n          allow create, update: if false;\n\n          allow delete: if isAdmin();\n        }\n      }\n\n      // -----------------------------------------------------------------------\n      // ASSIGNMENTS (congregation scoped: limpieza, hospitalidad u otras tareas)\n      // -----------------------------------------------------------------------\n      match /assignments/{assignmentId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if (isAdminOrSupervisor() || hasPermission('asignaciones', 'create') || hasPermission('asignaciones', 'manage'))\n          && canAccessCongregationData(congregationId)\n          && validStandaloneAssignmentData(request.resource.data, congregationId);\n\n        allow update: if (isAdminOrSupervisor() || hasPermission('asignaciones', 'edit') || hasPermission('asignaciones', 'manage'))\n          && canAccessCongregationData(congregationId)\n          && validStandaloneAssignmentData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin();\n      }\n\n      // -----------------------------------------------------------------------\n      // TERRITORIES\n      // -----------------------------------------------------------------------\n      match /territories/{territoryId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if canCreateTerritories()\n          && canAccessCongregationData(congregationId)\n          && validTerritoryCreate(request.resource.data, congregationId);\n\n        allow update: if (\n            (resource.data.status == 'active' && request.resource.data.status == 'inactive' && canDeactivateTerritories())\n            || (\n              request.resource.data.status == resource.data.status\n              && canEditTerritories()\n            )\n          )\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId\n          && validTerritoryUpdate(request.resource.data, congregationId);\n\n        allow delete: if false;\n      }\n\n      match /territorySchedule/{scheduleId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if canAssignTerritories()\n          && canAccessCongregationData(congregationId)\n          && validTerritoryScheduleCreate(request.resource.data, congregationId, scheduleId);\n\n        allow update: if canAssignTerritories()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId\n          && validTerritoryScheduleUpdate(request.resource.data, congregationId, scheduleId);\n\n        allow delete: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // OUTGOING TALKS\n      // Escritura directa cerrada: las altas/cambios pasan por Cloud Functions.\n      // -----------------------------------------------------------------------\n      match /outgoingTalks/{outgoingTalkId} {\n        allow get, list: if canAccessCongregationData(congregationId)\n          && isOutgoingTalksManager();\n\n        allow create, update: if false\n          && canAccessCongregationData(congregationId)\n          && isOutgoingTalksManager()\n          && validOutgoingTalkData(request.resource.data, congregationId);\n\n        allow delete: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // CLEANING GROUPS\n      // -----------------------------------------------------------------------\n      match /cleaningGroups/{groupId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && validCleaningGroupData(request.resource.data, congregationId);\n\n        allow update: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId\n          && validCleaningGroupData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId;\n      }\n\n      // Compatibilidad con el nombre legacy usado por versiones anteriores.\n      match /cleaning_groups/{groupId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && validCleaningGroupData(request.resource.data, congregationId);\n\n        allow update: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId\n          && validCleaningGroupData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId;\n      }\n\n      // -----------------------------------------------------------------------\n      // NOTIFICATIONS\n      // -----------------------------------------------------------------------\n      match /notifications/{notificationId} {\n        allow get: if canAccessCongregationData(congregationId)\n          && (\n            !('userId' in resource.data)\n            || resource.data.userId == currentUid()\n            || isAdminOrSupervisor()\n          );\n\n        allow list: if canAccessCongregationData(congregationId) && isAdminOrSupervisor();\n\n        allow create: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validNotificationData(request.resource.data, congregationId);\n\n        allow update: if (\n            isAdminOrSupervisor()\n            && canAccessCongregationData(congregationId)\n            && validNotificationData(request.resource.data, congregationId)\n          ) || (\n            canAccessCongregationData(congregationId)\n            && resource.data.userId == currentUid()\n            && request.resource.data.congregationId == resource.data.congregationId\n            && request.resource.data.userId == resource.data.userId\n            && request.resource.data.title == resource.data.title\n            && request.resource.data.body == resource.data.body\n            && request.resource.data.type == resource.data.type\n            && request.resource.data.relatedId == resource.data.relatedId\n            && sameKeysOnUpdate(['isRead', 'readAt'])\n            && request.resource.data.isRead is bool\n            && (!('readAt' in request.resource.data) || request.resource.data.readAt is string)\n          );\n\n        allow delete: if isAdmin();\n      }\n\n      // -----------------------------------------------------------------------\n      // PREACHING REPORTS\n      // -----------------------------------------------------------------------\n      match /preachingReports/{monthId}/submissions/{userId} {\n        allow get: if canAccessCongregationData(congregationId)\n          && (\n            isSameUser(userId)\n            || isPreachingManager()\n            || isAdminOrSupervisor()\n          );\n\n        allow list: if canAccessCongregationData(congregationId)\n          && (\n            isPreachingManager()\n            || isAdminOrSupervisor()\n          );\n\n        allow create, update: if canAccessCongregationData(congregationId)\n          && isSameUser(userId)\n          && validPreachingReportWrite(request.resource.data, congregationId, monthId, userId);\n\n        allow delete: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // CHANGE LOGS\n      // -----------------------------------------------------------------------\n      match /changeLogs/{logId} {\n        allow get, list: if isAdminOrSupervisor() && canAccessCongregationData(congregationId);\n\n        allow create: if isActive()\n          && canAccessCongregationData(congregationId)\n          && validChangeLogData(request.resource.data, congregationId);\n\n        allow update, delete: if false;\n      }\n    }\n\n    // =========================================================================\n    // REGLAS: DASHBOARD SUMMARY\n    // Documento de resumen pre-calculado por Cloud Functions.\n    // Solo lectura para usuarios activos de la misma congregación.\n    // Escritura reservada exclusivamente para Cloud Functions.\n    // =========================================================================\n\n    match /dashboardSummary/{congregationId} {\n      allow read: if isSuperAdmin() || canAccessCongregationData(congregationId);\n      allow write: if false;\n    }\n\n    // =========================================================================\n    // REGLAS: CLEANING GROUPS\n    // Grupos de limpieza — acceso por congregación.\n    // =========================================================================\n\n    match /cleaningGroups/{groupId} {\n      allow get: if isActive()\n        && resource.data.congregationId is string\n        && canAccessCongregationData(resource.data.congregationId);\n\n      // list restringido a usuarios activos de la misma congregación que el documento.\n      // myCongregationId() != null garantiza que el solicitante tiene congregación asignada.\n      allow list: if isActive() && canAccessCongregationData(myCongregationId());\n\n      allow create: if isCleaningManager()\n        && targetDocInMyCongregation()\n        && validCleaningGroupData(request.resource.data, request.resource.data.congregationId);\n\n      allow update: if isCleaningManager()\n        && storedDocInMyCongregation()\n        && targetDocInMyCongregation()\n        && validCleaningGroupData(request.resource.data, request.resource.data.congregationId)\n        && preservesCreatedAt();\n\n      allow delete: if isAdmin() && storedDocInMyCongregation();\n    }\n\n    // =========================================================================\n    // REGLAS: NOTIFICATIONS (colección raíz)\n    // Nota: las notificaciones de congregación están en\n    // /congregations/{id}/notifications. Esta colección raíz es para\n    // notificaciones globales o de sistema (si se usan).\n    // =========================================================================\n\n    match /notifications/{notificationId} {\n      allow read: if isSuperAdmin() || (isAuthenticated()\n        && (\n          !('userId' in resource.data)\n          || resource.data.userId == currentUid()\n          || isAdminOrSupervisor()\n        ));\n\n      allow create: if isSuperAdmin() || isAdminOrSupervisor();\n\n      allow update: if isSuperAdmin() || (isAuthenticated()\n        && resource.data.userId == currentUid()\n        && sameKeysOnUpdate(['isRead', 'readAt']));\n\n      allow delete: if isSuperAdmin() || isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-22T03:06:52.686415Z","metadata":{"services":["cloud.firestore"]}}
