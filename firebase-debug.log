[debug] [2026-05-11T03:36:36.809Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ormeprassig-public/rulesets {"name":"projects/ormeprassig-public/rulesets/b217ed54-0c97-45a5-8b21-eb664d02998d","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =========================================================================\n    // AUTENTICACIÓN Y USUARIO ACTUAL\n    // =========================================================================\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function currentUid() {\n      return request.auth != null ? request.auth.uid : null;\n    }\n\n    function currentUserPath() {\n      return /databases/$(database)/documents/users/$(currentUid());\n    }\n\n    function hasCurrentUserDoc() {\n      return isAuthenticated() && exists(currentUserPath());\n    }\n\n    function currentUserData() {\n      return get(currentUserPath()).data;\n    }\n\n    // =========================================================================\n    // VALIDACIONES BASE\n    // =========================================================================\n\n    function isNonEmptyString(value) {\n      return value is string && value.size() > 0;\n    }\n\n    function isValidRole(role) {\n      return role is string && role in ['admin', 'supervisor', 'user'];\n    }\n\n    function hasOnlyKeys(data, allowed) {\n      return data.keys().hasOnly(allowed);\n    }\n\n    function hasAllKeys(data, required) {\n      return data.keys().hasAll(required);\n    }\n\n    function sameKeysOnUpdate(allowedChangedKeys) {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedChangedKeys);\n    }\n\n    function preservesCreatedAt() {\n      return !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt;\n    }\n\n    // =========================================================================\n    // ESTADO DEL USUARIO ACTUAL\n    // =========================================================================\n\n    function currentUserHasRequiredShape() {\n      return hasCurrentUserDoc()\n        && isNonEmptyString(currentUserData().email)\n        && isValidRole(currentUserData().role)\n        && isNonEmptyString(currentUserData().congregationId)\n        && currentUserData().isActive is bool;\n    }\n\n    function isActive() {\n      return currentUserHasRequiredShape()\n        && currentUserData().isActive == true;\n    }\n\n    function isAdmin() {\n      return isActive() && currentUserData().role == 'admin';\n    }\n\n    function isSupervisor() {\n      return isActive() && currentUserData().role == 'supervisor';\n    }\n\n    function isAdminOrSupervisor() {\n      return isAdmin() || isSupervisor();\n    }\n\n    function isElder() {\n      return isActive()\n        && (\n          currentUserData().isElder == true\n          || (\n            currentUserData().privileges is map\n            && currentUserData().privileges.isElder == true\n          )\n        );\n    }\n\n    function isCleaningManager() {\n      return isAdminOrSupervisor()\n        || (\n          isActive()\n          && (\n            (\n              currentUserData().servicePosition == 'encargado'\n              && (\n                !('serviceDepartment' in currentUserData())\n                || currentUserData().serviceDepartment == 'limpieza'\n              )\n            )\n            || (\n              currentUserData().serviceAssignments is list\n              && currentUserData().serviceAssignments.hasAny([\n                { 'position': 'encargado', 'department': 'limpieza', 'label': 'Encargado de Limpieza' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isPreachingManager() {\n      return isActive()\n        && (\n          (\n            currentUserData().serviceDepartment == 'predicacion'\n            && (\n              (\n                currentUserData().servicePosition == 'encargado'\n                && currentUserData().privileges is map\n                && currentUserData().privileges.isElder == true\n              )\n              || currentUserData().servicePosition == 'auxiliar'\n            )\n          )\n          || (\n            currentUserData().serviceAssignments is list\n            && (\n              (\n                currentUserData().privileges is map\n                && currentUserData().privileges.isElder == true\n                && currentUserData().serviceAssignments.hasAny([\n                  { 'position': 'encargado', 'department': 'predicacion', 'label': 'Encargado de Predicacion' }\n                ])\n              )\n              || currentUserData().serviceAssignments.hasAny([\n                { 'position': 'auxiliar', 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isOutgoingTalksManager() {\n      return isAdmin()\n        || (\n          isActive()\n          && (\n            (\n              currentUserData().servicePosition == 'encargado'\n              && currentUserData().serviceDepartment == 'discursos'\n            )\n            || (\n              currentUserData().serviceAssignments is list\n              && currentUserData().serviceAssignments.hasAny([\n                { 'position': 'encargado', 'department': 'discursos', 'label': 'Encargado de Discursos' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isPioneer() {\n      return isActive()\n        && currentUserData().privileges is map\n        && (\n          currentUserData().privileges.isRegularPioneer == true\n          || currentUserData().privileges.isAuxiliaryPioneer == true\n        );\n    }\n\n    function canListCongregationUsers() {\n      return canAccessCongregationData(myCongregationId())\n        && (\n          isCleaningManager()\n          || isPreachingManager()\n          || isOutgoingTalksManager()\n          || isAdminOrSupervisor()\n        );\n    }\n\n    function isSameUser(userId) {\n      return isAuthenticated() && currentUid() == userId;\n    }\n\n    function myCongregationId() {\n      return hasCurrentUserDoc() ? currentUserData().congregationId : null;\n    }\n\n    function sameCongregation(congregationId) {\n      return isActive()\n        && isNonEmptyString(congregationId)\n        && myCongregationId() == congregationId;\n    }\n\n    function congregationPath(congregationId) {\n      return /databases/$(database)/documents/congregations/$(congregationId);\n    }\n\n    function congregationAccessBlocked(congregationId) {\n      return exists(congregationPath(congregationId))\n        && !accessBlockExpired(get(congregationPath(congregationId)).data)\n        && (\n          get(congregationPath(congregationId)).data.disabled == true\n          || get(congregationPath(congregationId)).data.deactivated == true\n          || get(congregationPath(congregationId)).data.accessDisabled == true\n          || get(congregationPath(congregationId)).data.isActive == false\n          || get(congregationPath(congregationId)).data.active == false\n          || get(congregationPath(congregationId)).data.enabled == false\n          || get(congregationPath(congregationId)).data.status in [\n            'inactive',\n            'inactivo',\n            'disabled',\n            'desactivada',\n            'suspended',\n            'suspendida',\n            'maintenance',\n            'mantenimiento'\n          ]\n        );\n    }\n\n    function systemMaintenanceBlocked() {\n      return systemMaintenanceDocBlocked(/databases/$(database)/documents/system/maintenance)\n        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/congregationAccess)\n        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/platform);\n    }\n\n    function systemMaintenanceDocBlocked(systemDocPath) {\n      return exists(systemDocPath)\n        && !accessBlockExpired(get(systemDocPath).data)\n        && (\n          get(systemDocPath).data.maintenanceMode == true\n          || get(systemDocPath).data.systemMaintenance == true\n          || get(systemDocPath).data.disableCongregations == true\n          || get(systemDocPath).data.allCongregationsDisabled == true\n          || get(systemDocPath).data.congregationsDisabled == true\n          || get(systemDocPath).data.enabled == false\n          || get(systemDocPath).data.isActive == false\n        );\n    }\n\n    function accessBlockExpired(data) {\n      return explicitAccessBlockExpired(data)\n        || maxAccessBlockExpired(data);\n    }\n\n    function explicitAccessBlockExpired(data) {\n      return (\n        ('blockedUntil' in data)\n        && data.blockedUntil is timestamp\n        && data.blockedUntil <= request.time\n      ) || (\n        ('disabledUntil' in data)\n        && data.disabledUntil is timestamp\n        && data.disabledUntil <= request.time\n      ) || (\n        ('deactivatedUntil' in data)\n        && data.deactivatedUntil is timestamp\n        && data.deactivatedUntil <= request.time\n      ) || (\n        ('maintenanceUntil' in data)\n        && data.maintenanceUntil is timestamp\n        && data.maintenanceUntil <= request.time\n      ) || (\n        ('maintenanceEndsAt' in data)\n        && data.maintenanceEndsAt is timestamp\n        && data.maintenanceEndsAt <= request.time\n      ) || (\n        ('unlockAt' in data)\n        && data.unlockAt is timestamp\n        && data.unlockAt <= request.time\n      ) || (\n        ('reactivateAt' in data)\n        && data.reactivateAt is timestamp\n        && data.reactivateAt <= request.time\n      ) || (\n        ('reactivationAt' in data)\n        && data.reactivationAt is timestamp\n        && data.reactivationAt <= request.time\n      ) || (\n        ('expiresAt' in data)\n        && data.expiresAt is timestamp\n        && data.expiresAt <= request.time\n      ) || (\n        ('endsAt' in data)\n        && data.endsAt is timestamp\n        && data.endsAt <= request.time\n      );\n    }\n\n    function maxAccessBlockExpired(data) {\n      return accessStartExpired(data, 'deactivatedAt')\n        || accessStartExpired(data, 'disabledAt')\n        || accessStartExpired(data, 'blockedAt')\n        || accessStartExpired(data, 'maintenanceStartedAt')\n        || accessStartExpired(data, 'startedAt')\n        || accessStartExpired(data, 'updatedAt')\n        || accessStartExpired(data, 'createdAt');\n    }\n\n    function accessStartExpired(data, field) {\n      return field in data\n        && data[field] is timestamp\n        && data[field] + duration.value(5, 'h') <= request.time;\n    }\n\n    function canAccessCongregationData(congregationId) {\n      return sameCongregation(congregationId)\n        && !congregationAccessBlocked(congregationId)\n        && !systemMaintenanceBlocked();\n    }\n\n    function storedDocInMyCongregation() {\n      return resource.data.congregationId is string\n        && canAccessCongregationData(resource.data.congregationId);\n    }\n\n    function targetDocInMyCongregation() {\n      return request.resource.data.congregationId is string\n        && canAccessCongregationData(request.resource.data.congregationId);\n    }\n\n    // =========================================================================\n    // USERS\n    // =========================================================================\n\n    function allowedUserKeys() {\n      return [\n        'uid',\n        'email',\n        'firstName',\n        'middleName',\n        'lastName',\n        'secondLastName',\n        'displayName',\n        'phone',\n        'gender',\n        'photoURL',\n        'role',\n        'isActive',\n        // 'status' es gestionado exclusivamente por Cloud Functions (createUserByAdmin / updateUserByAdmin).\n        // Se incluye aquí para que validUserData no rechace documentos que ya lo contienen\n        // cuando el cliente realiza actualizaciones parciales.\n        'status',\n        'congregationId',\n        'congregationDomain',\n        // Campos de asignación de servicio — escritura por Cloud Functions.\n        'servicePosition',\n        'serviceDepartment',\n        'serviceAssignments',\n        'department',\n        'privileges',\n        'responsibilities',\n        'isElder',\n        'isMinisterialServant',\n        'createdAt',\n        'updatedAt',\n        // Campos de notificaciones push — escritura controlada por validPushTokenUpdate()\n        'notificationTokens',\n        'pushTokenUpdatedAt',\n        // Campos de preferencias de notificación\n        'notificationsEnabled',\n        'platformNotifications',\n        'cleaningNotifications',\n        'hospitalityNotifications',\n        // Campos de módulo de limpieza\n        'cleaningEligible',\n        'cleaningGroupId',\n        'cleaningGroupName',\n        'createdBy',\n        'createdByName',\n        'createdByEmail',\n        'updatedBy',\n        'updatedByName',\n        'updatedByEmail'\n      ];\n    }\n\n    function requiredUserKeys() {\n      return [\n        'email',\n        'firstName',\n        'lastName',\n        'role',\n        'isActive',\n        'congregationId'\n      ];\n    }\n\n    function validUserData(data, userId) {\n      return hasOnlyKeys(data, allowedUserKeys())\n        && hasAllKeys(data, requiredUserKeys())\n        && isNonEmptyString(data.email)\n        && isNonEmptyString(data.firstName)\n        && isNonEmptyString(data.lastName)\n        && isValidRole(data.role)\n        && data.isActive is bool\n        && isNonEmptyString(data.congregationId)\n        && (\n          !('uid' in data)\n          || (data.uid is string && data.uid == userId)\n        )\n        && (\n          !('displayName' in data)\n          || data.displayName is string\n        )\n        && (\n          !('phone' in data)\n          || data.phone is string\n        )\n        && (\n          !('gender' in data)\n          || data.gender in ['masculino', 'femenino']\n        )\n        && (\n          !('photoURL' in data)\n          || data.photoURL is string\n        )\n        && (\n          !('notificationTokens' in data)\n          || data.notificationTokens is list\n        )\n        && (\n          !('pushTokenUpdatedAt' in data)\n          || data.pushTokenUpdatedAt is timestamp\n        )\n        && (\n          !('cleaningEligible' in data)\n          || data.cleaningEligible is bool\n        )\n        && (\n          !('cleaningGroupId' in data)\n          || data.cleaningGroupId == null\n          || data.cleaningGroupId is string\n        )\n        && (\n          !('cleaningGroupName' in data)\n          || data.cleaningGroupName == null\n          || data.cleaningGroupName is string\n        )\n        && (\n          !('privileges' in data)\n          || validUserPrivileges(data.privileges)\n        )\n        && (\n          !('responsibilities' in data)\n          || validUserResponsibilities(data.responsibilities)\n        )\n        && (\n          !('serviceAssignments' in data)\n          || validUserServiceAssignments(data.serviceAssignments)\n        )\n        && (\n          !('isElder' in data)\n          || data.isElder is bool\n        )\n        && (\n          !('isMinisterialServant' in data)\n          || data.isMinisterialServant is bool\n        )\n        && (\n          !('createdBy' in data)\n          || data.createdBy is string\n        )\n        && (\n          !('createdByName' in data)\n          || data.createdByName is string\n        )\n        && (\n          !('createdByEmail' in data)\n          || data.createdByEmail is string\n        )\n        && (\n          !('updatedBy' in data)\n          || data.updatedBy is string\n        )\n        && (\n          !('updatedByName' in data)\n          || data.updatedByName is string\n        )\n        && (\n          !('updatedByEmail' in data)\n          || data.updatedByEmail is string\n        );\n    }\n\n    function validUserServiceAssignments(assignments) {\n      return assignments is list\n        && assignments.size() <= 20;\n    }\n\n    function validUserPrivileges(privileges) {\n      return privileges is map\n        && privileges.keys().hasOnly([\n          'isElder',\n          'isMinisterialServant',\n          'isRegularPioneer',\n          'isAuxiliaryPioneer'\n        ])\n        && (!('isElder' in privileges) || privileges.isElder is bool)\n        && (!('isMinisterialServant' in privileges) || privileges.isMinisterialServant is bool)\n        && (!('isRegularPioneer' in privileges) || privileges.isRegularPioneer is bool)\n        && (!('isAuxiliaryPioneer' in privileges) || privileges.isAuxiliaryPioneer is bool)\n        && !(privileges.isElder == true && privileges.isMinisterialServant == true)\n        && !(privileges.isRegularPioneer == true && privileges.isAuxiliaryPioneer == true);\n    }\n\n    function validUserResponsibilities(responsibilities) {\n      return responsibilities is map\n        && responsibilities.keys().hasOnly(['isPreachingManager'])\n        && (!('isPreachingManager' in responsibilities) || responsibilities.isPreachingManager is bool);\n    }\n\n    function validUserCreate(userId) {\n      return validUserData(request.resource.data, userId);\n    }\n\n    function validUserUpdateByAdmin(userId) {\n      return validUserData(request.resource.data, userId)\n        && preservesCreatedAt();\n    }\n\n    function validSelfUserUpdate(userId) {\n      return isSameUser(userId)\n        && validUserData(request.resource.data, userId)\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.role == resource.data.role\n        && request.resource.data.isActive == resource.data.isActive\n        && request.resource.data.congregationId == resource.data.congregationId\n        && preservesCreatedAt()\n        && sameKeysOnUpdate([\n          'firstName',\n          'lastName',\n          'displayName',\n          'phone',\n          'photoURL',\n          'updatedAt'\n        ]);\n    }\n\n    // Permite al propio usuario actualizar SOLO su token de notificación push.\n    // El cliente llama setDoc(..., { uid, notificationTokens: arrayUnion(token),\n    //   pushTokenUpdatedAt: serverTimestamp(), updatedAt: serverTimestamp() }, { merge: true }).\n    // Esta condición es independiente de validSelfUserUpdate para no interferir\n    // con las validaciones de perfil.\n    function validPushTokenUpdate(userId) {\n      return isSameUser(userId)\n        && isActive()\n        && sameKeysOnUpdate(['notificationTokens', 'pushTokenUpdatedAt', 'updatedAt', 'uid']);\n    }\n\n    function isValidEventType(type) {\n      return type in [\n        'conmemoracion',\n        'asamblea_circuito',\n        'asamblea_regional',\n        'visita_superintendente',\n        'reunion_especial',\n        'capacitacion',\n        'reunion_anual_precursores',\n        'reunion_precursores_visita_superintendente',\n        'reunion_ancianos_siervos_ministeriales'\n      ];\n    }\n\n    function validEventData(data) {\n      return hasOnlyKeys(data, [\n          'congregationId',\n          'type',\n          'title',\n          'superintendentName',\n          'superintendentWifeName',\n          'startDate',\n          'endDate',\n          'deleteAt',\n          'location',\n          'color',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == myCongregationId()\n        && isValidEventType(data.type)\n        && data.startDate is timestamp\n        && data.endDate is timestamp\n        && data.deleteAt is timestamp\n        && data.color is string\n        && data.createdBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && (\n          !('updatedBy' in data)\n          || data.updatedBy is string\n        )\n        && (\n          !('location' in data)\n          || data.location is string\n        )\n        && (\n          !('superintendentWifeName' in data)\n          || data.superintendentWifeName is string\n        )\n        && (\n          data.type == 'visita_superintendente'\n          ? (\n            isNonEmptyString(data.superintendentName)\n            && !('title' in data)\n          )\n          : (\n            isNonEmptyString(data.title)\n            && !('superintendentName' in data)\n            && !('superintendentWifeName' in data)\n          )\n        );\n    }\n\n    function validEventCreate() {\n      return isAdminOrSupervisor()\n        && validEventData(request.resource.data)\n        && request.resource.data.createdBy == currentUid();\n    }\n\n    function validEventUpdate() {\n      return isAdminOrSupervisor()\n        && resource.data.congregationId == myCongregationId()\n        && validEventData(request.resource.data)\n        && request.resource.data.createdBy == resource.data.createdBy\n        && request.resource.data.createdAt == resource.data.createdAt;\n    }\n\n    function validExpoPushTokenDoc(userId) {\n      return isSameUser(userId)\n        && isActive()\n        && hasOnlyKeys(request.resource.data, [\n          'token',\n          'userId',\n          'congregationId',\n          'platform',\n          'deviceName',\n          'isActive',\n          'updatedAt'\n        ])\n        && isNonEmptyString(request.resource.data.token)\n        && request.resource.data.userId == userId\n        && request.resource.data.congregationId == currentUserData().congregationId\n        && request.resource.data.platform in ['ios', 'android']\n        && (\n          request.resource.data.deviceName == null\n          || request.resource.data.deviceName is string\n        )\n        && request.resource.data.isActive is bool\n        && request.resource.data.updatedAt is timestamp;\n    }\n\n    function validCleaningMembershipUserUpdate() {\n      return isCleaningManager()\n        && storedDocInMyCongregation()\n        && targetDocInMyCongregation()\n        && preservesCreatedAt()\n        && request.resource.data.email == resource.data.email\n        && request.resource.data.role == resource.data.role\n        && request.resource.data.isActive == resource.data.isActive\n        && request.resource.data.congregationId == resource.data.congregationId\n        && (\n          !('cleaningGroupId' in request.resource.data)\n          || request.resource.data.cleaningGroupId == null\n          || request.resource.data.cleaningGroupId is string\n        )\n        && (\n          !('cleaningGroupName' in request.resource.data)\n          || request.resource.data.cleaningGroupName == null\n          || request.resource.data.cleaningGroupName is string\n        )\n        && sameKeysOnUpdate([\n          'cleaningGroupId',\n          'cleaningGroupName',\n          'updatedAt'\n        ]);\n    }\n\n    // =========================================================================\n    // CONGREGATIONS\n    // =========================================================================\n\n    function allowedCongregationKeys() {\n      return [\n        'name',\n        'code',\n        'country',\n        'state',\n        'city',\n        'language',\n        'timezone',\n        'isActive',\n        'createdAt',\n        'updatedAt'\n      ];\n    }\n\n    function validCongregationData(data) {\n      return hasOnlyKeys(data, allowedCongregationKeys())\n        && hasAllKeys(data, ['name', 'isActive'])\n        && isNonEmptyString(data.name)\n        && data.isActive is bool\n        && (!('code' in data) || data.code is string)\n        && (!('country' in data) || data.country is string)\n        && (!('state' in data) || data.state is string)\n        && (!('city' in data) || data.city is string)\n        && (!('language' in data) || data.language is string)\n        && (!('timezone' in data) || data.timezone is string);\n    }\n\n    // =========================================================================\n    // PERSONS\n    // =========================================================================\n\n    function allowedPersonKeys() {\n      return [\n        'congregationId',\n        'firstName',\n        'lastName',\n        'displayName',\n        'gender',\n        'phone',\n        'email',\n        'isBaptized',\n        'isPublisher',\n        'isActive',\n        'notes',\n        'createdAt',\n        'updatedAt'\n      ];\n    }\n\n    function validPersonData(data, congregationId) {\n      return hasOnlyKeys(data, allowedPersonKeys())\n        && hasAllKeys(data, ['congregationId', 'firstName', 'lastName', 'isActive'])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.firstName)\n        && isNonEmptyString(data.lastName)\n        && data.isActive is bool\n        && (!('displayName' in data) || data.displayName is string)\n        && (!('gender' in data) || data.gender is string)\n        && (!('phone' in data) || data.phone is string)\n        && (!('email' in data) || data.email is string)\n        && (!('isBaptized' in data) || data.isBaptized is bool)\n        && (!('isPublisher' in data) || data.isPublisher is bool)\n        && (!('notes' in data) || data.notes is string);\n    }\n\n    // =========================================================================\n    // MEETINGS\n    // =========================================================================\n\n    function allowedMeetingKeys() {\n      return [\n        'congregationId',\n        'type',\n        'meetingCategory',\n        'title',\n        'description',\n        'date',\n        'status',\n        'notes',\n        'createdAt',\n        'updatedAt'\n      ];\n    }\n\n    function validMeetingType(value) {\n      return value is string\n        && value in ['midweek', 'weekend', 'cleaning', 'hospitality'];\n    }\n\n    function validMeetingData(data, congregationId) {\n      return hasOnlyKeys(data, allowedMeetingKeys())\n        && hasAllKeys(data, ['congregationId', 'type', 'date'])\n        && data.congregationId == congregationId\n        && validMeetingType(data.type)\n        && isNonEmptyString(data.date)\n        && (!('meetingCategory' in data) || data.meetingCategory is string)\n        && (!('title' in data) || data.title is string)\n        && (!('description' in data) || data.description is string)\n        && (!('status' in data) || data.status is string)\n        && (!('notes' in data) || data.notes is string);\n    }\n\n    // =========================================================================\n    // ASSIGNMENTS\n    // =========================================================================\n\n    function allowedAssignmentKeys() {\n      return [\n        'congregationId',\n        'meetingId',\n        'category',\n        'type',\n        'section',\n        'title',\n        'description',\n        'priority',\n        'assignedToUid',\n        'assignedByUid',\n        'assignedByName',\n        'createdBy',\n        'updatedBy',\n        'cleaningGroupId',\n        'cleaningGroupName',\n        'assignedUsers',\n        'date',\n        'dueDate',\n        'assignedToUserId',\n        'assignedToPersonId',\n        'assignedToName',\n        'assistantUserId',\n        'assistantPersonId',\n        'assistantName',\n        'startTime',\n        'endTime',\n        'durationMinutes',\n        'status',\n        'notes',\n        'createdAt',\n        'updatedAt'\n      ];\n    }\n\n    function validAssignmentData(data, congregationId, meetingId) {\n      return hasOnlyKeys(data, allowedAssignmentKeys())\n        && hasAllKeys(data, ['congregationId', 'meetingId', 'type', 'title'])\n        && data.congregationId == congregationId\n        && data.meetingId == meetingId\n        && isNonEmptyString(data.type)\n        && isNonEmptyString(data.title)\n        && (!('category' in data) || data.category is string)\n        && (!('section' in data) || data.section is string)\n        && (!('description' in data) || data.description is string)\n        && (!('priority' in data) || data.priority is string)\n        && (!('assignedToUid' in data) || data.assignedToUid is string)\n        && (!('assignedByUid' in data) || data.assignedByUid is string)\n        && (!('assignedByName' in data) || data.assignedByName is string)\n        && (!('createdBy' in data) || data.createdBy is string)\n        && (!('updatedBy' in data) || data.updatedBy is string)\n        && (!('cleaningGroupId' in data) || data.cleaningGroupId is string)\n        && (!('cleaningGroupName' in data) || data.cleaningGroupName is string)\n        && (!('assignedUsers' in data) || data.assignedUsers is list)\n        && (!('assignedToUserId' in data) || data.assignedToUserId is string)\n        && (!('assignedToPersonId' in data) || data.assignedToPersonId is string)\n        && (!('assignedToName' in data) || data.assignedToName is string)\n        && (!('assistantUserId' in data) || data.assistantUserId is string)\n        && (!('assistantPersonId' in data) || data.assistantPersonId is string)\n        && (!('assistantName' in data) || data.assistantName is string)\n        && (!('startTime' in data) || data.startTime is string)\n        && (!('endTime' in data) || data.endTime is string)\n        && (!('durationMinutes' in data) || data.durationMinutes is int)\n        && (!('status' in data) || data.status is string)\n        && (!('notes' in data) || data.notes is string);\n    }\n\n    function validStandaloneAssignmentData(data, congregationId) {\n      return hasOnlyKeys(data, allowedAssignmentKeys())\n        && hasAllKeys(data, ['congregationId', 'category', 'type', 'title'])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.category)\n        && isNonEmptyString(data.type)\n        && isNonEmptyString(data.title)\n        && (!('meetingId' in data) || data.meetingId is string)\n        && (!('section' in data) || data.section is string)\n        && (!('description' in data) || data.description is string)\n        && (!('priority' in data) || data.priority is string)\n        && (!('assignedToUid' in data) || data.assignedToUid is string)\n        && (!('assignedByUid' in data) || data.assignedByUid is string)\n        && (!('assignedByName' in data) || data.assignedByName is string)\n        && (!('createdBy' in data) || data.createdBy is string)\n        && (!('updatedBy' in data) || data.updatedBy is string)\n        && (!('cleaningGroupId' in data) || data.cleaningGroupId is string)\n        && (!('cleaningGroupName' in data) || data.cleaningGroupName is string)\n        && (!('assignedUsers' in data) || data.assignedUsers is list)\n        && (!('assignedToUserId' in data) || data.assignedToUserId is string)\n        && (!('assignedToPersonId' in data) || data.assignedToPersonId is string)\n        && (!('assignedToName' in data) || data.assignedToName is string)\n        && (!('assistantUserId' in data) || data.assistantUserId is string)\n        && (!('assistantPersonId' in data) || data.assistantPersonId is string)\n        && (!('assistantName' in data) || data.assistantName is string)\n        && (!('startTime' in data) || data.startTime is string)\n        && (!('endTime' in data) || data.endTime is string)\n        && (!('durationMinutes' in data) || data.durationMinutes is int)\n        && (!('status' in data) || data.status is string)\n        && (!('notes' in data) || data.notes is string);\n    }\n\n    // =========================================================================\n    // CLEANING GROUPS\n    // =========================================================================\n\n    function allowedCleaningGroupKeys() {\n      return [\n        'name',\n        'description',\n        'congregationId',\n        'groupType',\n        'memberIds',\n        'memberCount',\n        'isActive',\n        'createdBy',\n        'createdAt',\n        'updatedAt'\n      ];\n    }\n\n    function validCleaningGroupData(data, congregationId) {\n      return hasOnlyKeys(data, allowedCleaningGroupKeys())\n        && hasAllKeys(data, [\n          'name',\n          'congregationId',\n          'groupType',\n          'memberIds',\n          'memberCount',\n          'isActive',\n          'createdBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.name)\n        && data.name.size() <= 80\n        && data.groupType in ['standard', 'family']\n        && data.memberIds is list\n        && data.memberIds.size() <= 200\n        && data.memberCount is int\n        && data.memberCount >= 0\n        && data.memberCount <= 200\n        && data.memberCount == data.memberIds.size()\n        && data.isActive is bool\n        && data.createdBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && (!('description' in data) || (data.description is string && data.description.size() <= 300));\n    }\n\n    // =========================================================================\n    // NOTIFICATIONS\n    // =========================================================================\n\n    function allowedNotificationKeys() {\n      return [\n        'congregationId',\n        'userId',\n        'title',\n        'body',\n        'type',\n        'isRead',\n        'relatedId',\n        'createdAt',\n        'readAt'\n      ];\n    }\n\n    function validNotificationData(data, congregationId) {\n      return hasOnlyKeys(data, allowedNotificationKeys())\n        && hasAllKeys(data, ['congregationId', 'title', 'body', 'type', 'isRead'])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.title)\n        && isNonEmptyString(data.body)\n        && isNonEmptyString(data.type)\n        && data.isRead is bool\n        && (!('userId' in data) || data.userId is string)\n        && (!('relatedId' in data) || data.relatedId is string);\n    }\n\n    function validOutgoingTalkStatus(status) {\n      return status is string && status in ['scheduled', 'cancelled', 'completed'];\n    }\n\n    function validDateKey(value) {\n      return value is string\n        && value.matches('^\\\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');\n    }\n\n    function validTimeKey(value) {\n      return value is string\n        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');\n    }\n\n    function validOutgoingTalkData(data, congregationId) {\n      return hasOnlyKeys(data, [\n          'congregationId',\n          'speakerUserId',\n          'speakerName',\n          'destinationCongregationName',\n          'talkDate',\n          'talkTime',\n          'weekStartDate',\n          'weekEndDate',\n          'status',\n          'notes',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && hasAllKeys(data, [\n          'congregationId',\n          'speakerUserId',\n          'speakerName',\n          'destinationCongregationName',\n          'talkDate',\n          'talkTime',\n          'weekStartDate',\n          'weekEndDate',\n          'status',\n          'createdBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == congregationId\n        && isNonEmptyString(data.speakerUserId)\n        && isNonEmptyString(data.speakerName)\n        && isNonEmptyString(data.destinationCongregationName)\n        && validDateKey(data.talkDate)\n        && validTimeKey(data.talkTime)\n        && validDateKey(data.weekStartDate)\n        && validDateKey(data.weekEndDate)\n        && data.weekStartDate <= data.talkDate\n        && data.talkDate <= data.weekEndDate\n        && validOutgoingTalkStatus(data.status)\n        && data.createdBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && (!('updatedBy' in data) || data.updatedBy is string)\n        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));\n    }\n\n    // =========================================================================\n    // CHANGE LOGS\n    // =========================================================================\n\n    function allowedChangeLogKeys() {\n      return [\n        'congregationId',\n        'actorUserId',\n        'actorName',\n        'action',\n        'entityType',\n        'entityId',\n        'description',\n        'metadata',\n        'createdAt'\n      ];\n    }\n\n    function validChangeLogData(data, congregationId) {\n      return hasOnlyKeys(data, allowedChangeLogKeys())\n        && hasAllKeys(data, ['congregationId', 'actorUserId', 'action', 'entityType', 'entityId', 'createdAt'])\n        && data.congregationId == congregationId\n        && data.actorUserId == currentUid()\n        && isNonEmptyString(data.action)\n        && isNonEmptyString(data.entityType)\n        && isNonEmptyString(data.entityId)\n        && (!('actorName' in data) || data.actorName is string)\n        && (!('description' in data) || data.description is string)\n        && (!('metadata' in data) || data.metadata is map);\n    }\n\n    function validMonthId(monthId) {\n      return monthId is string\n        && monthId.matches('^\\\\d{4}-(0[1-9]|1[0-2])$');\n    }\n\n    function allowedPreachingReportKeys() {\n      return [\n        'userId',\n        'userName',\n        'congregationId',\n        'congregationName',\n        'monthId',\n        'monthName',\n        'participated',\n        'bibleStudies',\n        'returnVisits',\n        'comments',\n        'isPioneer',\n        'pioneerType',\n        'hours',\n        'submittedAt',\n        'updatedAt',\n        'submittedBy'\n      ];\n    }\n\n    function validPreachingReportWrite(data, congregationId, monthId, userId) {\n      return hasOnlyKeys(data, allowedPreachingReportKeys())\n        && hasAllKeys(data, [\n          'userId',\n          'userName',\n          'congregationId',\n          'monthId',\n          'monthName',\n          'participated',\n          'bibleStudies',\n          'returnVisits',\n          'isPioneer',\n          'submittedAt',\n          'updatedAt',\n          'submittedBy'\n        ])\n        && validMonthId(monthId)\n        && data.userId == userId\n        && data.userId == currentUid()\n        && data.submittedBy == currentUid()\n        && data.congregationId == congregationId\n        && data.monthId == monthId\n        && data.userName is string\n        && data.monthName is string\n        && (!('congregationName' in data) || data.congregationName is string)\n        && data.participated is bool\n        && data.bibleStudies is int\n        && data.bibleStudies >= 0\n        && data.returnVisits is int\n        && data.returnVisits >= 0\n        && (\n          !('comments' in data)\n          || data.comments == null\n          || (data.comments is string && data.comments.size() <= 500)\n        )\n        && data.isPioneer is bool\n        && data.isPioneer == isPioneer()\n        && (\n          !('pioneerType' in data)\n          || data.pioneerType == null\n          || data.pioneerType in ['regular', 'auxiliary']\n        )\n        && data.submittedAt is timestamp\n        && data.updatedAt is timestamp\n        && (\n          isPioneer()\n          || !('hours' in data)\n          || data.hours == null\n        )\n        && (\n          !isPioneer()\n          || data.hours is number\n          || data.hours == null\n        )\n        && (\n          !isPioneer()\n          || data.hours == null\n          || data.hours >= 0\n        );\n    }\n\n    // =========================================================================\n    // REGLAS: SYSTEM\n    // Solo lectura para usuarios autenticados.\n    // Usado por cache-control-service.ts para leer system/cacheControl.\n    // Escritura reservada exclusivamente para Cloud Functions / consola admin.\n    // =========================================================================\n\n    match /system/{docId} {\n      allow read: if isAuthenticated();\n      allow write: if false;\n    }\n\n    // =========================================================================\n    // REGLAS: USERS\n    // =========================================================================\n\n    match /events/{eventId} {\n      allow get, list: if isActive()\n        && resource.data.congregationId == myCongregationId()\n        && canAccessCongregationData(resource.data.congregationId);\n      allow create: if validEventCreate();\n      allow update: if validEventUpdate();\n      allow delete: if isAdminOrSupervisor()\n        && resource.data.congregationId == myCongregationId();\n    }\n\n    match /users/{userId} {\n      allow get: if isSameUser(userId)\n        || (canListCongregationUsers() && storedDocInMyCongregation());\n\n      // list sólo dentro de la propia congregación.\n      // Firestore Security Rules no permiten inspeccionar filtros de query,\n      // por lo que la restricción real se aplica en la app (siempre filtra por congregationId).\n      // myCongregationId() != null garantiza que el solicitante tiene perfil activo con congregación.\n      allow list: if canListCongregationUsers() && myCongregationId() != null;\n\n      allow create: if isAdmin()\n        && validUserCreate(userId)\n        && targetDocInMyCongregation();\n\n      allow update: if (\n          isAdmin()\n          && storedDocInMyCongregation()\n          && targetDocInMyCongregation()\n          && validUserUpdateByAdmin(userId)\n        ) || (\n          validSelfUserUpdate(userId)\n        ) || (\n          // Registro de token push: el propio usuario actualiza SOLO su token.\n          // Llamado desde registerPushTokenForUser() en notifications-service.ts.\n          validPushTokenUpdate(userId)\n        ) || (\n          // Gestion de grupos de limpieza: solo campos de membresia de limpieza.\n          validCleaningMembershipUserUpdate()\n        );\n\n      allow delete: if isAdmin() && storedDocInMyCongregation();\n\n      match /pushTokens/{tokenDocId} {\n        allow get, list: if isSameUser(userId);\n        allow create, update: if validExpoPushTokenDoc(userId);\n        allow delete: if isSameUser(userId);\n      }\n    }\n\n    // =========================================================================\n    // REGLAS: CONGREGATIONS\n    // =========================================================================\n\n    match /congregations/{congregationId} {\n      allow get: if sameCongregation(congregationId);\n      allow list: if false;\n\n      allow create: if isAdmin()\n        && canAccessCongregationData(congregationId)\n        && validCongregationData(request.resource.data);\n\n      allow update: if isAdmin()\n        && canAccessCongregationData(congregationId)\n        && validCongregationData(request.resource.data)\n        && preservesCreatedAt();\n\n      allow delete: if false;\n\n      match /private/{privateDocId} {\n        allow get, list: if sameCongregation(congregationId)\n          && canAccessCongregationData(congregationId)\n          && isElder();\n        allow write: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // PERSONS\n      // -----------------------------------------------------------------------\n      match /persons/{personId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validPersonData(request.resource.data, congregationId);\n\n        allow update: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validPersonData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin();\n      }\n\n      // -----------------------------------------------------------------------\n      // MEETINGS\n      // -----------------------------------------------------------------------\n      match /meetings/{meetingId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validMeetingData(request.resource.data, congregationId);\n\n        allow update: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validMeetingData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin();\n\n        // ---------------------------------------------------------------------\n        // ASSIGNMENTS\n        // ---------------------------------------------------------------------\n        match /assignments/{assignmentId} {\n          allow get, list: if canAccessCongregationData(congregationId);\n\n          allow create, update: if false;\n\n          allow delete: if isAdmin();\n        }\n      }\n\n      // -----------------------------------------------------------------------\n      // ASSIGNMENTS (congregation scoped: limpieza, hospitalidad u otras tareas)\n      // -----------------------------------------------------------------------\n      match /assignments/{assignmentId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validStandaloneAssignmentData(request.resource.data, congregationId);\n\n        allow update: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validStandaloneAssignmentData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin();\n      }\n\n      // -----------------------------------------------------------------------\n      // OUTGOING TALKS\n      // Escritura directa cerrada: las altas/cambios pasan por Cloud Functions.\n      // -----------------------------------------------------------------------\n      match /outgoingTalks/{outgoingTalkId} {\n        allow get, list: if canAccessCongregationData(congregationId)\n          && isOutgoingTalksManager();\n\n        allow create, update: if false\n          && canAccessCongregationData(congregationId)\n          && isOutgoingTalksManager()\n          && validOutgoingTalkData(request.resource.data, congregationId);\n\n        allow delete: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // CLEANING GROUPS\n      // -----------------------------------------------------------------------\n      match /cleaningGroups/{groupId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && validCleaningGroupData(request.resource.data, congregationId);\n\n        allow update: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId\n          && validCleaningGroupData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId;\n      }\n\n      // Compatibilidad con el nombre legacy usado por versiones anteriores.\n      match /cleaning_groups/{groupId} {\n        allow get, list: if canAccessCongregationData(congregationId);\n\n        allow create: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && validCleaningGroupData(request.resource.data, congregationId);\n\n        allow update: if isCleaningManager()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId\n          && validCleaningGroupData(request.resource.data, congregationId)\n          && preservesCreatedAt();\n\n        allow delete: if isAdmin()\n          && canAccessCongregationData(congregationId)\n          && resource.data.congregationId == congregationId;\n      }\n\n      // -----------------------------------------------------------------------\n      // NOTIFICATIONS\n      // -----------------------------------------------------------------------\n      match /notifications/{notificationId} {\n        allow get: if canAccessCongregationData(congregationId)\n          && (\n            !('userId' in resource.data)\n            || resource.data.userId == currentUid()\n            || isAdminOrSupervisor()\n          );\n\n        allow list: if canAccessCongregationData(congregationId) && isAdminOrSupervisor();\n\n        allow create: if isAdminOrSupervisor()\n          && canAccessCongregationData(congregationId)\n          && validNotificationData(request.resource.data, congregationId);\n\n        allow update: if (\n            isAdminOrSupervisor()\n            && canAccessCongregationData(congregationId)\n            && validNotificationData(request.resource.data, congregationId)\n          ) || (\n            canAccessCongregationData(congregationId)\n            && resource.data.userId == currentUid()\n            && request.resource.data.congregationId == resource.data.congregationId\n            && request.resource.data.userId == resource.data.userId\n            && request.resource.data.title == resource.data.title\n            && request.resource.data.body == resource.data.body\n            && request.resource.data.type == resource.data.type\n            && request.resource.data.relatedId == resource.data.relatedId\n            && sameKeysOnUpdate(['isRead', 'readAt'])\n            && request.resource.data.isRead is bool\n            && (!('readAt' in request.resource.data) || request.resource.data.readAt is string)\n          );\n\n        allow delete: if isAdmin();\n      }\n\n      // -----------------------------------------------------------------------\n      // PREACHING REPORTS\n      // -----------------------------------------------------------------------\n      match /preachingReports/{monthId}/submissions/{userId} {\n        allow get: if canAccessCongregationData(congregationId)\n          && (\n            isSameUser(userId)\n            || isPreachingManager()\n            || isAdminOrSupervisor()\n          );\n\n        allow list: if canAccessCongregationData(congregationId)\n          && (\n            isPreachingManager()\n            || isAdminOrSupervisor()\n          );\n\n        allow create, update: if canAccessCongregationData(congregationId)\n          && isSameUser(userId)\n          && validPreachingReportWrite(request.resource.data, congregationId, monthId, userId);\n\n        allow delete: if false;\n      }\n\n      // -----------------------------------------------------------------------\n      // CHANGE LOGS\n      // -----------------------------------------------------------------------\n      match /changeLogs/{logId} {\n        allow get, list: if isAdminOrSupervisor() && canAccessCongregationData(congregationId);\n\n        allow create: if isActive()\n          && canAccessCongregationData(congregationId)\n          && validChangeLogData(request.resource.data, congregationId);\n\n        allow update, delete: if false;\n      }\n    }\n\n    // =========================================================================\n    // REGLAS: DASHBOARD SUMMARY\n    // Documento de resumen pre-calculado por Cloud Functions.\n    // Solo lectura para usuarios activos de la misma congregación.\n    // Escritura reservada exclusivamente para Cloud Functions.\n    // =========================================================================\n\n    match /dashboardSummary/{congregationId} {\n      allow read: if canAccessCongregationData(congregationId);\n      allow write: if false;\n    }\n\n    // =========================================================================\n    // REGLAS: CLEANING GROUPS\n    // Grupos de limpieza — acceso por congregación.\n    // =========================================================================\n\n    match /cleaningGroups/{groupId} {\n      allow get: if isActive()\n        && resource.data.congregationId is string\n        && canAccessCongregationData(resource.data.congregationId);\n\n      // list restringido a usuarios activos de la misma congregación que el documento.\n      // myCongregationId() != null garantiza que el solicitante tiene congregación asignada.\n      allow list: if isActive() && canAccessCongregationData(myCongregationId());\n\n      allow create: if isCleaningManager()\n        && targetDocInMyCongregation()\n        && validCleaningGroupData(request.resource.data, request.resource.data.congregationId);\n\n      allow update: if isCleaningManager()\n        && storedDocInMyCongregation()\n        && targetDocInMyCongregation()\n        && validCleaningGroupData(request.resource.data, request.resource.data.congregationId)\n        && preservesCreatedAt();\n\n      allow delete: if isAdmin() && storedDocInMyCongregation();\n    }\n\n    // =========================================================================\n    // REGLAS: NOTIFICATIONS (colección raíz)\n    // Nota: las notificaciones de congregación están en\n    // /congregations/{id}/notifications. Esta colección raíz es para\n    // notificaciones globales o de sistema (si se usan).\n    // =========================================================================\n\n    match /notifications/{notificationId} {\n      allow read: if isAuthenticated()\n        && (\n          !('userId' in resource.data)\n          || resource.data.userId == currentUid()\n          || isAdminOrSupervisor()\n        );\n\n      allow create: if isAdminOrSupervisor();\n\n      allow update: if isAuthenticated()\n        && resource.data.userId == currentUid()\n        && sameKeysOnUpdate(['isRead', 'readAt']);\n\n      allow delete: if isAdmin();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-11T03:36:36.782623Z","metadata":{"services":["cloud.firestore"]}}
