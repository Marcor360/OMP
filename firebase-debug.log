   return isSameUser(userId)\n        && isActive()\n        && sameKeysOnUpdate(['notificationTokens', 'pushTokenUpdatedAt', 'updatedAt', 'uid']);\n    }\n\n    function isValidEventType(type) {\n      return type in [\n        'conmemoracion',\n        'asamblea_circuito',\n        'asamblea_regional',\n        'visita_superintendente',\n        'reunion_especial',\n        'capacitacion',\n        'reunion_anual_precursores',\n        'reunion_precursores_visita_superintendente',\n        'reunion_ancianos_siervos_ministeriales'\n      ];\n    }\n\n    function validEventData(data) {\n      return hasOnlyKeys(data, [\n          'congregationId',\n          'type',\n          'title',\n          'superintendentName',\n          'superintendentWifeName',\n          'startDate',\n          'endDate',\n          'deleteAt',\n          'location',\n          'color',\n          'createdBy',\n          'updatedBy',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.congregationId == myCongregationId()\n        && isValidEventType(data.type)\n        && data.startDate is timestamp\n        && data.endDate is timestamp\n        && data.deleteAt is timestamp\n        && data.color is string\n        && data.createdBy is string\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp\n        && (\n          !('updatedBy' in data)\n          || data.updatedBy is string\n        )\n        && (\n          !('location' in data)\n          || data.location is string\n        )\n        && (\n          !('superintendentWifeName' in data)\n          || data.superintendentWifeName is string\n        )\n        && (\n          data.type == 'visita_superintendente'\n          ? (\n            isNonEmptyString(data.superintendentName)\n            && !('title' in data)\n          )\n          : (\n            isNonEmptyString(data.title)\n            && !('superintendentName' in data)\n            && !('superintendentWifeName' in data