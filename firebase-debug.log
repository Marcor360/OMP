\n        && preservesCreatedAt()\r\n        && exists(/databases/$(database)/documents/users/$(data.userId))\r\n        && get(/databases/$(database)/documents/users/$(data.userId)).data.congregationId == data.congregationId\r\n        && (\r\n          data.isActive == false\r\n          || get(/databases/$(database)/documents/users/$(data.userId)).data.isActive == true\r\n        );\r\n    }\r\n\r\n    // =========================================================================\r\n    // CLEANING GROUPS\r\n    // =========================================================================\r\n\r\n    function allowedCleaningGroupKeys() {\r\n      return [\r\n        'name',\r\n        'description',\r\n        'congregationId',\r\n        'groupType',\r\n        'memberIds',\r\n        'memberCount',\r\n        'isActive',\r\n        'createdBy',\r\n        'createdAt',\r\n        'updatedAt'\r\n      ];\r\n    }\r\n\r\n    function validCleaningGroupData(data, congregationId) {\r\n      return hasOnlyKeys(data, allowedCleaningGroupKeys())\r\n        && hasAllKeys(data, [\r\n          'name',\r\n          'congregationId',\r\n          'groupType',\r\n          'memberIds',\r\n          'memberCount',\r\n          'isActive',\r\n          'createdBy',\r\n          'createdAt',\r\n          'updatedAt'\r\n        ])\r\n        && data.congregationId == congregationId\r\n        && isNonEmptyString(data.name)\r\n        && data.name.size() <= 80\r\n        && data.groupType in ['standard', 'family']\r\n        && data.memberIds is list\r\n        && data.memberIds.size() <= 200\r\n        && data.memberCount is int\r\n        && data.memberCount >= 0\r\n        && data.memberCount <= 200\r\n        && data.memberCount == data.memberIds.size()\r\n        && data.isActive is bool\r\n        && data.createdBy is string\r\n        && data.createdAt is timestamp\r\n        && data.updatedAt is timestamp\r\n        && (!('description' in data) || (data.description is string && data.description.size() <= 300));\r\n    }\r\n\r\n    // =========================================================================\r\n    // NOTIFICATIONS\r\n    // =========================================================================\r\n\r\n    function allowedNotificationKeys() {\r\n      return [\r\n        'congregationId',\r\n        'userId',\r\n        'title',\r\n        'body',\r\n        'type',\r\n        'isRead',\r\n        'relatedId',\r\n        'createdAt',\r\n        'readAt'\r\n      ];\r\n    }\r\n\r\n    function validNotificationData(data, congregationId) {\r\n      return hasOnlyKeys(data, allowedNotificationKeys())\r\n        && hasAllKeys(data, ['congregationId', 'title', 'body', 'type', 'isRead'])\r\n        && data.congregationId == congregationId\r\n        && isNonEmptyString(data.title)\r\n        && isNonEmptyString(data.body)\r\n        && isNonEmptyString(data.type)\r\n        && data.isRead is bool\r\n        && (!('userId' in data) || data.userId is string)\r\n        && (!('relatedId' in data) || data.relatedId is string);\r\n    }\r\n\r\n    function validOutgoingTalkStatus(status) {\r\n      return status is string && status in ['scheduled', 'cancelled', 'completed'];\r\n    }\r\n\r\n    function validDateKey(value) {\r\n      return value is string\r\n        && value.matches('^\\\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');\r\n    }\r\n\r\n    function validTimeKey(value) {\r\n      return value is string\r\n        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');\r\n    }\r\n\r\n    function validOutgoingTalkData(data, congregationId) {\r\n      return hasOnlyKeys(data, [\r\n          'congregationId',\r\n          'speakerUserId',\r\n          'speakerName',\r\n          'destinationCongregationName',\r\n          'talkDate',\r\n          'talkTime',\r\n          'weekStartDate',\r\n          'weekEndDate',\r\n          'status',\r\n          'notes',\r\n          'createdBy',\r\n          'updatedBy',\r\n          'createdAt',\r\n          'updatedAt'\r\n        ])\r\n        && hasAllKeys(data, [\r\n          'congregationId',\r\n          'speakerUserId',\r\n          'speakerName',\r\n          'destinationCongregationName',\r\n          'talkDate',\r\n          'talkTime',\r\n          'weekStartDate',\r\n          'weekEndDate',\r\n          'status',\r\n          'createdBy',\r\n          'createdAt',\r\n          'updatedAt'\r\n        ])\r\n        && data.congregationId == congregationId\r\n        && isNonEmptyString(data.speakerUserId)\r\n        && isNonEmptyString(data.speakerName)\r\n        && isNonEmptyString(data.destinationCongregationName)\r\n        && validDateKey(data.talkDate)\r\n        && validTimeKey(data.talkTime)\r\n        && validDateKey(data.weekStartDate)\r\n        && validDateKey(data.weekEndDate)\r\n        && data.weekStartDate <= data.talkDate\r\n        && data.talkDate <= data.weekEndDate\r\n        && validOutgoingTalkStatus(data.status)\r\n        && data.createdBy is string\r\n        && data.createdAt is timestamp\r\n        && data.updatedAt is timestamp\r\n        && (!('updatedBy' in data) || data.updatedBy is string)\r\n        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));\r\n    }\r\n\r\n    // =========================================================================\r\n    // CHANGE LOGS\r\n    // =========================================================================\r\n\r\n    function allowedChangeLogKeys() {\r\n      return [\r\n        'congregationId',\r\n        'actorUserId',\r\n        'actorName',\r\n        'action',\r\n        'entityType',\r\n        'entityId',\r\n        'description',\r\n        'metadata',\r\n        'createdAt'\r\n      ];\r\n    }\r\n\r\n    function validChangeLogData(data, congregationId) {\r\n      return hasOnlyKeys(data, allowedChangeLogKeys())\r\n        && hasAllKeys(data, ['congregationId', 'actorUserId', 'action', 'entityType', 'entityId', 'createdAt'])\r\n        && data.congregationId == congregationId\r\n        && data.actorUserId == currentUid()\r\n        && isNonEmptyString(data.action)\r\n        && isNonEmptyString(data.entityType)\r\n        && isNonEmptyString(data.entityId)\r\n        && (!('actorName' in data) || data.actorName is string)\r\n        && (!('description' in data) || data.description is string)\r\n        && (!('metadata' in data) || data.metadata is map);\r\n    }\r\n\r\n    function validMonthId(monthId) {\r\n      return monthId is string\r\n        && monthId.matches('^\\\\d{4}-(0[1-9]|1[0-2])$');\r\n    }\r\n\r\n    function allowedPreachingReportKeys() {\r\n      return [\r\n        'userId',\r\n        'userName',\r\n        'congregationId',\r\n        'congregationName',\r\n        'monthId',\r\n        'monthName',\r\n        'participated',\r\n        'bibleStudies',\r\n        'returnVisits',\r\n        'comments',\r\n        'isPioneer',\r\n        'pioneerType',\r\n        'hours',\r\n        'submittedAt',\r\n        'updatedAt',\r\n        'submittedBy'\r\n      ];\r\n    }\r\n\r\n    function validPreachingReportWrite(data, congregationId, monthId, userId) {\r\n      return hasOnlyKeys(data, allowedPreachingReportKeys())\r\n        && hasAllKeys(data, [\r\n          'userId',\r\n          'userName',\r\n          'congregationId',\r\n          'monthId',\r\n          'monthName',\r\n          'participated',\r\n          'bibleStudies',\r\n          'returnVisits',\r\n          'isPioneer',\r\n          'submittedAt',\r\n          'updatedAt',\r\n          'submittedBy'\r\n        ])\r\n        && validMonthId(monthId)\r\n        && data.userId == userId\r\n        && data.userId == currentUid()\r\n        && data.submittedBy == currentUid()\r\n        && data.congregationId == congregationId\r\n        && data.monthId == monthId\r\n        && data.userName is string\r\n        && data.monthName is string\r\n        && (!('congregationName' in data) || data.congregationName is string)\r\n        && data.participated is bool\r\n        && data.bibleStudies is int\r\n        && data.bibleStudies >= 0\r\n        && data.returnVisits is int\r\n        && data.returnVisits >= 0\r\n        && (\r\n          !('comments' in data)\r\n          || data.comments == null\r\n          || (data.comments is string && data.comments.size() <= 500)\r\n        )\r\n        && data.isPioneer is bool\r\n        && data.isPioneer == isPioneer()\r\n        && (\r\n          !('pioneerType' in data)\r\n          || data.pioneerType == null\r\n          || data.pioneerType in ['regular', 'auxiliary']\r\n        )\r\n        && data.submittedAt is timestamp\r\n        && data.updatedAt is timestamp\r\n        && (\r\n          isPioneer()\r\n          || !('hours' in data)\r\n          || data.hours == null\r\n        )\r\n        && (\r\n          !isPioneer()\r\n          || data.hours is number\r\n          || data.hours == null\r\n        )\r\n        && (\r\n          !isPioneer()\r\n          || data.hours == null\r\n          || data.hours >= 0\r\n        );\r\n    }\r\n\r\n    // =========================================================================\r\n    // REGLAS: SYSTEM\r\n    // Solo lectura para usuarios autenticados.\r\n    // Usado por cache-control-service.ts para leer system/cacheControl.\r\n    // Escritura reservada exclusivamente para Cloud Functions / consola admin.\r\n    // =========================================================================\r\n\r\n    match /system/{docId} {\r\n      allow read: if isAuthenticated();\r\n      allow write: if false;\r\n    }\r\n\r\n    // =========================================================================\r\n    // REGLAS: SYSTEM ANNOUNCEMENTS\r\n    // Avisos globales administrados desde la app administrativa.\r\n    // =========================================================================\r\n\r\n    match /systemAnnouncements/{announcementId} {\r\n      allow read: if isAuthenticated();\r\n      allow create, update, delete: if isSuperAdmin();\r\n    }\r\n\r\n    // =========================================================================\r\n    // REGLAS: SUPER ADMINS\r\n    // =========================================================================\r\n\r\n    match /superAdmins/{userId} {\r\n      allow read: if request.auth != null && request.auth.uid == userId;\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    // =========================================================================\r\n    // REGLAS: USERS\r\n    // =========================================================================\r\n\r\n    match /events/{eventId} {\r\n      allow get, list: if isActive()\r\n        && resource.data.congregationId == myCongregationId()\r\n        && canAccessCongregationData(resource.data.congregationId);\r\n      allow create: if validEventCreate();\r\n      allow update: if validEventUpdate();\r\n      allow delete: if canManageEvents()\r\n        && resource.data.congregationId == myCongregationId();\r\n    }\r\n\r\n    match /users/{userId} {\r\n      allow get: if isSuperAdmin() \r\n        || isSameUser(userId)\r\n        || (canReadUsers() && storedDocInMyCongregation());\r\n\r\n      // list sÃ³lo dentro de la propia congregaciÃ³n.\r\n      // Firestore Security Rules no permiten inspeccionar filtros de query,\r\n      // por lo que la restricciÃ³n real se aplica en la app (siempre filtra por congregationId).\r\n      // myCongregationId() != null garantiza que el solicitante tiene perfil activo con congregaciÃ³n.\r\n      allow list: if isSuperAdmin() \r\n        || (canListCongregationUsers() && myCongregationId() != null);\r\n\r\n      allow create: if isSuperAdmin() || (canCreateUsers()\r\n        && validUserCreate(userId)\r\n        && targetDocInMyCongregation()\r\n        && safeDelegatedUserCreate());\r\n\r\n      allow update: if isSuperAdmin() || (\r\n          canEditUsers()\r\n          && storedDocInMyCongregation()\r\n          && targetDocInMyCongregation()\r\n          && validUserUpdateByAdmin(userId)\r\n          && safeDelegatedUserUpdate()\r\n        ) || (\r\n          validSelfUserUpdate(userId)\r\n        ) || (\r\n          // Registro de token push: el propio usuario actualiza SOLO su token.\r\n          validPushTokenUpdate(userId)\r\n        ) || (\r\n          // Gestion de grupos de limpieza: solo campos de membresia de limpieza.\r\n          validCleaningMembershipUserUpdate()\r\n        ) || (\r\n          // Sincronizacion del organigrama congregacional: solo cargos de servicio.\r\n          validOrganizationServiceAssignmentSync()\r\n        );\r\n\r\n      allow delete: if isSuperAdmin() || (\r\n          canDeleteUsers()\r\n          && storedDocInMyCongregation()\r\n          && resource.data.role != 'admin'\r\n          && resource.data.role != 'administrador'\r\n          && !isSystemPrincipalUserData(resource.data)\r\n        );\r\n\r\n      match /pushTokens/{tokenDocId} {\r\n        allow get, list: if isSameUser(userId);\r\n        allow create, update: if validExpoPushTokenDoc(userId);\r\n        allow delete: if isSameUser(userId);\r\n      }\r\n\r\n      match /viewedAnnouncements/{announcementId} {\r\n        allow get, list: if isSameUser(userId);\r\n        allow create, update: if isSameUser(userId)\r\n          && validViewedAnnouncementData(announcementId);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n\r\n    // =========================================================================\r\n    // REGLAS: CONGREGATIONS\r\n    // =========================================================================\r\n\r\n    match /congregations/{congregationId} {\r\n      allow get: if isSuperAdmin() || sameCongregation(congregationId);\r\n      allow list: if isSuperAdmin();\r\n\r\n      allow create: if isSuperAdmin() || (isAdmin()\r\n        && canAccessCongregationData(congregationId)\r\n        && validCongregationData(request.resource.data));\r\n\r\n      allow update: if isSuperAdmin() || (isAdmin()\r\n        && canAccessCongregationData(congregationId)\r\n        && validCongregationData(request.resource.data)\r\n        && preservesCreatedAt());\r\n\r\n      allow delete: if false;\r\n\r\n      match /private/{privateDocId} {\r\n        allow get, list: if sameCongregation(congregationId)\r\n          && canAccessCongregationData(congregationId)\r\n          && isAdmin();\r\n        allow write: if false;\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // PERSONS\r\n      // -----------------------------------------------------------------------\r\n      match /persons/{personId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManagePersons()\r\n          && canAccessCongregationData(congregationId)\r\n          && validPersonData(request.resource.data, congregationId);\r\n\r\n        allow update: if canManagePersons()\r\n          && canAccessCongregationData(congregationId)\r\n          && validPersonData(request.resource.data, congregationId)\r\n          && preservesCreatedAt();\r\n\r\n        allow delete: if isAdmin();\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // MEETINGS\r\n      // -----------------------------------------------------------------------\r\n      match /meetings/{meetingId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if isMeetingsManager()\r\n          && canAccessCongregationData(congregationId)\r\n          && validMeetingData(request.resource.data, congregationId);\r\n\r\n        allow update: if isMeetingsManager()\r\n          && canAccessCongregationData(congregationId)\r\n          && validMeetingData(request.resource.data, congregationId)\r\n          && preservesCreatedAt();\r\n\r\n        allow delete: if isAdmin();\r\n\r\n        // ---------------------------------------------------------------------\r\n        // ASSIGNMENTS\r\n        // ---------------------------------------------------------------------\r\n        match /assignments/{assignmentId} {\r\n          allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n          allow create, update: if false;\r\n\r\n          allow delete: if isAdmin();\r\n        }\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // ASSIGNMENTS (congregation scoped: limpieza, hospitalidad u otras tareas)\r\n      // -----------------------------------------------------------------------\r\n      match /assignments/{assignmentId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManageAssignments()\r\n          && canAccessCongregationData(congregationId)\r\n          && validStandaloneAssignmentData(request.resource.data, congregationId);\r\n\r\n        allow update: if canManageAssignments()\r\n          && canAccessCongregationData(congregationId)\r\n          && validStandaloneAssignmentData(request.resource.data, congregationId)\r\n          && preservesCreatedAt();\r\n\r\n        allow delete: if isAdmin();\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // TERRITORIES\r\n      // -----------------------------------------------------------------------\r\n      match /territories/{territoryId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canCreateTerritories()\r\n          && canAccessCongregationData(congregationId)\r\n          && validTerritoryCreate(request.resource.data, congregationId);\r\n\r\n        allow update: if (\r\n            (resource.data.status == 'active' && request.resource.data.status == 'inactive' && canDeactivateTerritories())\r\n            || (\r\n              request.resource.data.status == resource.data.status\r\n              && canEditTerritories()\r\n            )\r\n          )\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && validTerritoryUpdate(request.resource.data, congregationId);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /preachingGroups/{groupId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManagePreachingGroups()\r\n          && canAccessCongregationData(congregationId)\r\n          && validPreachingGroupCreate(request.resource.data, congregationId);\r\n\r\n        allow update: if canManagePreachingGroups()\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && validPreachingGroupUpdate(request.resource.data, congregationId);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /monthlyTerritoryAssignments/{monthId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManageTerritorySchedule()\r\n          && canAccessCongregationData(congregationId)\r\n          && validMonthlyTerritoryAssignmentCreate(request.resource.data, congregationId, monthId);\r\n\r\n        allow update: if canManageTerritorySchedule()\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && validMonthlyTerritoryAssignmentUpdate(request.resource.data, congregationId, monthId);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /territorySchedule/{scheduleId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManageTerritorySchedule()\r\n          && canAccessCongregationData(congregationId)\r\n          && validTerritoryScheduleCreate(request.resource.data, scheduleId);\r\n\r\n        allow update: if canManageTerritorySchedule()\r\n          && canAccessCongregationData(congregationId)\r\n          && validTerritoryScheduleUpdate(request.resource.data, scheduleId);\r\n\r\n        allow delete: if canManageTerritorySchedule()\r\n          && canAccessCongregationData(congregationId);\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // OUTGOING TALKS\r\n      // Escritura directa cerrada: las altas/cambios pasan por Cloud Functions.\r\n      // -----------------------------------------------------------------------\r\n      match /outgoingTalks/{outgoingTalkId} {\r\n        allow get, list: if canAccessCongregationData(congregationId)\r\n          && isOutgoingTalksManager();\r\n\r\n        allow create, update: if false\r\n          && canAccessCongregationData(congregationId)\r\n          && isOutgoingTalksManager()\r\n          && validOutgoingTalkData(request.resource.data, congregationId);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // CLEANING GROUPS\r\n      // -----------------------------------------------------------------------\r\n      match /cleaningGroups/{groupId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if isCleaningManager()\r\n          && canAccessCongregationData(congregationId)\r\n          && validCleaningGroupData(request.resource.data, congregationId);\r\n\r\n        allow update: if isCleaningManager()\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && validCleaningGroupData(request.resource.data, congregationId)\r\n          && preservesCreatedAt();\r\n\r\n        allow delete: if isAdmin()\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId;\r\n      }\r\n\r\n      // Compatibilidad con el nombre legacy usado por versiones anteriores.\r\n      match /cleaning_groups/{groupId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if isCleaningManager()\r\n          && canAccessCongregationData(congregationId)\r\n          && validCleaningGroupData(request.resource.data, congregationId);\r\n\r\n        allow update: if isCleaningManager()\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && validCleaningGroupData(request.resource.data, congregationId)\r\n          && preservesCreatedAt();\r\n\r\n        allow delete: if isAdmin()\r\n          && canAccessCongregationData(congregationId)\r\n          && resource.data.congregationId == congregationId;\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // DEPARTMENTS / ORG CHART\r\n      // -----------------------------------------------------------------------\r\n      match /departments/{departmentId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManageDepartments(congregationId)\r\n          && request.resource.data.congregationId == congregationId\r\n          && validDepartmentCreate(request.resource.data);\r\n\r\n        allow update: if canManageDepartments(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && request.resource.data.congregationId == congregationId\r\n          && validDepartmentUpdate(request.resource.data);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      match /departmentAssignments/{assignmentId} {\r\n        allow get, list: if canAccessCongregationData(congregationId);\r\n\r\n        allow create: if canManageDepartments(congregationId)\r\n          && request.resource.data.congregationId == congregationId\r\n          && validDepartmentAssignmentCreate(request.resource.data);\r\n\r\n        allow update: if canManageDepartments(congregationId)\r\n          && resource.data.congregationId == congregationId\r\n          && request.resource.data.congregationId == congregationId\r\n          && validDepartmentAssignmentUpdate(request.resource.data);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // NOTIFICATIONS\r\n      // -----------------------------------------------------------------------\r\n      match /notifications/{notificationId} {\r\n        allow get: if canAccessCongregationData(congregationId)\r\n          && (\r\n            !('userId' in resource.data)\r\n            || resource.data.userId == currentUid()\r\n            || isAdminOrSupervisor()\r\n            || isGlobalScreenAccess()\r\n          );\r\n\r\n        allow list: if canAccessCongregationData(congregationId)\r\n          && (isAdminOrSupervisor() || isGlobalScreenAccess());\r\n\r\n        allow create: if (isAdmin() || isGlobalScreenAccess() || hasPermission('avisos', 'create') || hasPermission('avisos', 'manage'))\r\n          && canAccessCongregationData(congregationId)\r\n          && validNotificationData(request.resource.data, congregationId);\r\n\r\n        allow update: if (\r\n            (isAdmin() || isGlobalScreenAccess() || hasPermission('avisos', 'edit') || hasPermission('avisos', 'manage'))\r\n            && canAccessCongregationData(congregationId)\r\n            && validNotificationData(request.resource.data, congregationId)\r\n          ) || (\r\n            canAccessCongregationData(congregationId)\r\n            && resource.data.userId == currentUid()\r\n            && request.resource.data.congregationId == resource.data.congregationId\r\n            && request.resource.data.userId == resource.data.userId\r\n            && request.resource.data.title == resource.data.title\r\n            && request.resource.data.body == resource.data.body\r\n            && request.resource.data.type == resource.data.type\r\n            && request.resource.data.relatedId == resource.data.relatedId\r\n            && sameKeysOnUpdate(['isRead', 'readAt'])\r\n            && request.resource.data.isRead is bool\r\n            && (!('readAt' in request.resource.data) || request.resource.data.readAt is string)\r\n          );\r\n\r\n        allow delete: if isAdmin();\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // PREACHING REPORTS\r\n      // -----------------------------------------------------------------------\r\n      match /preachingReports/{monthId}/submissions/{userId} {\r\n        allow get: if canAccessCongregationData(congregationId)\r\n          && (\r\n            isSameUser(userId)\r\n            || isPreachingManager()\r\n            || isAdminOrSupervisor()\r\n            || isGlobalScreenAccess()\r\n          );\r\n\r\n        allow list: if canAccessCongregationData(congregationId)\r\n          && (\r\n            isPreachingManager()\r\n            || isAdminOrSupervisor()\r\n            || isGlobalScreenAccess()\r\n          );\r\n\r\n        allow create, update: if canAccessCongregationData(congregationId)\r\n          && isSameUser(userId)\r\n          && validPreachingReportWrite(request.resource.data, congregationId, monthId, userId);\r\n\r\n        allow delete: if false;\r\n      }\r\n\r\n      // -----------------------------------------------------------------------\r\n      // CHANGE LOGS\r\n      // -----------------------------------------------------------------------\r\n      match /changeLogs/{logId} {\r\n        allow get, list: if (isAdminOrSupervisor() || isGlobalScreenAccess())\r\n          && canAccessCongregationData(congregationId);\r\n\r\n        allow create: if isActive()\r\n          && canAccessC