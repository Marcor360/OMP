[debug] [2026-06-03T04:47:19.360Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ormeprassig-public/rulesets {"name":"projects/ormeprassig-public/rulesets/06719243-a5ff-42d0-8d95-50234d425c73","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // =========================================================================\r\n    // AUTENTICACIÃ“N Y USUARIO ACTUAL\r\n    // =========================================================================\r\n\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function currentUid() {\r\n      return request.auth != null ? request.auth.uid : null;\r\n    }\r\n\r\n    function currentUserPath() {\r\n      return /databases/$(database)/documents/users/$(currentUid());\r\n    }\r\n\r\n    function hasCurrentUserDoc() {\r\n      return isAuthenticated() && exists(currentUserPath());\r\n    }\r\n\r\n    function currentUserData() {\r\n      return get(currentUserPath()).data;\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return request.auth != null\r\n        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data.isActive == true;\r\n    }\r\n\r\n    // =========================================================================\r\n    // VALIDACIONES BASE\r\n    // =========================================================================\r\n\r\n    function isNonEmptyString(value) {\r\n      return value is string && value.size() > 0;\r\n    }\r\n\r\n    function isValidRole(role) {\r\n      return role is string && role in ['admin', 'administrador', 'supervisor', 'user', 'usuario'];\r\n    }\r\n\r\n    function hasOnlyKeys(data, allowed) {\r\n      return data.keys().hasOnly(allowed);\r\n    }\r\n\r\n    function hasAllKeys(data, required) {\r\n      return data.keys().hasAll(required);\r\n    }\r\n\r\n    function sameKeysOnUpdate(allowedChangedKeys) {\r\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedChangedKeys);\r\n    }\r\n\r\n    function preservesCreatedAt() {\r\n      return !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt;\r\n    }\r\n\r\n    // =========================================================================\r\n    // ESTADO DEL USUARIO ACTUAL\r\n    // =========================================================================\r\n\r\n    function currentUserHasRequiredShape() {\r\n      return hasCurrentUserDoc()\r\n        && isValidRole(currentUserData().role)\r\n        && isNonEmptyString(currentUserData().congregationId)\r\n        && currentUserData().isActive is bool;\r\n    }\r\n\r\n    function isActive() {\r\n      return currentUserHasRequiredShape()\r\n        && currentUserData().isActive == true;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return isActive()\r\n        && (currentUserData().role == 'admin' || currentUserData().role == 'administrador');\r\n    }\r\n\r\n    function isSupervisor() {\r\n      return isActive() && currentUserData().role == 'supervisor';\r\n    }\r\n\r\n    function isAdminOrSupervisor() {\r\n      return isAdmin() || isSupervisor();\r\n    }\r\n\r\n    function hasServicePosition(position) {\r\n      return isActive()\r\n        && (\r\n          currentUserData().servicePosition == position\r\n          || (\r\n            currentUserData().serviceAssignments is list\r\n            && (\r\n              currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'label': 'Coordinador' },\r\n                { 'position': position, 'label': 'Secretario' }\r\n              ])\r\n              || currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'department': 'limpieza', 'label': 'Encargado de Limpieza' },\r\n                { 'position': position, 'department': 'limpieza', 'label': 'Auxiliar de Limpieza' },\r\n                { 'position': position, 'department': 'tesoreria', 'label': 'Encargado de Tesoreria' },\r\n                { 'position': position, 'department': 'tesoreria', 'label': 'Auxiliar de Tesoreria' },\r\n                { 'position': position, 'department': 'predicacion', 'label': 'Encargado de Predicacion' },\r\n                { 'position': position, 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' },\r\n                { 'position': position, 'department': 'reuniones', 'label': 'Encargado de Reuniones' },\r\n                { 'position': position, 'department': 'reuniones', 'label': 'Auxiliar de Reuniones' },\r\n                { 'position': position, 'department': 'discursos', 'label': 'Encargado de Discursos' },\r\n                { 'position': position, 'department': 'discursos', 'label': 'Auxiliar de Discursos' }\r\n              ])\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function isCoordinatorOrSecretary() {\r\n      return hasServicePosition('coordinador') || hasServicePosition('secretario');\r\n    }\r\n\r\n    function isGlobalScreenAccess() {\r\n      return isSuperAdmin()\r\n        || isCoordinatorOrSecretary()\r\n        || (\r\n          isActive()\r\n          && (\r\n            currentUserData().protectedFromDeletion == true\r\n            || currentUserData().isSystemUser == true\r\n            || currentUserData().isPrimaryAdmin == true\r\n            || currentUserData().isRootAdmin == true\r\n            || currentUserData().systemProtected == true\r\n          )\r\n        );\r\n    }\r\n\r\n    function isCleaningManager() {\r\n      return isAdmin()\r\n        || hasPermission('limpieza', 'manage')\r\n        || (\r\n          hasPermission('limpieza', 'create')\r\n          && hasPermission('limpieza', 'edit')\r\n        )\r\n        || (\r\n          isActive()\r\n          && (\r\n            (\r\n              currentUserData().servicePosition == 'encargado'\r\n              && (\r\n                !('serviceDepartment' in currentUserData())\r\n                || currentUserData().serviceDepartment == 'limpieza'\r\n              )\r\n            )\r\n            || (\r\n              currentUserData().serviceAssignments is list\r\n              && currentUserData().serviceAssignments.hasAny([\r\n                { 'position': 'encargado', 'department': 'limpieza', 'label': 'Encargado de Limpieza' }\r\n              ])\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function isPreachingManager() {\r\n      return isActive()\r\n        && (\r\n          (\r\n            (\r\n              currentUserData().serviceDepartment == 'predicacion'\r\n              || currentUserData().serviceDepartment == 'territorios'\r\n            )\r\n            && (\r\n              (\r\n                currentUserData().servicePosition == 'encargado'\r\n                && currentUserData().privileges is map\r\n                && currentUserData().privileges.isElder == true\r\n              )\r\n              || currentUserData().servicePosition == 'auxiliar'\r\n            )\r\n          )\r\n          || (\r\n            currentUserData().serviceAssignments is list\r\n            && (\r\n              (\r\n                currentUserData().privileges is map\r\n                && currentUserData().privileges.isElder == true\r\n                && currentUserData().serviceAssignments.hasAny([\r\n                  { 'position': 'encargado', 'department': 'predicacion', 'label': 'Encargado de Predicacion' }\r\n                ])\r\n              )\r\n              || currentUserData().serviceAssignments.hasAny([\r\n                { 'position': 'auxiliar', 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }\r\n              ])\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function isOutgoingTalksManager() {\r\n      return isAdmin()\r\n        || (\r\n          isActive()\r\n          && (\r\n            (\r\n              currentUserData().servicePosition == 'encargado'\r\n              && currentUserData().serviceDepartment == 'discursos'\r\n            )\r\n            || (\r\n              currentUserData().serviceAssignments is list\r\n              && currentUserData().serviceAssignments.hasAny([\r\n                { 'position': 'encargado', 'department': 'discursos', 'label': 'Encargado de Discursos' }\r\n              ])\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function isMeetingsManager() {\r\n      return isAdmin()\r\n        || isGlobalScreenAccess()\r\n        || hasPermission('reuniones', 'manage')\r\n        || (\r\n          hasPermission('reuniones', 'create')\r\n          && hasPermission('reuniones', 'edit')\r\n        )\r\n        || (\r\n          isActive()\r\n          && (\r\n            (\r\n              currentUserData().servicePosition == 'encargado'\r\n              && currentUserData().serviceDepartment == 'reuniones'\r\n            )\r\n            || (\r\n              currentUserData().serviceAssignments is list\r\n              && currentUserData().serviceAssignments.hasAny([\r\n                { 'position': 'encargado', 'department': 'reuniones', 'label': 'Encargado de Reuniones' }\r\n              ])\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function isPioneer() {\r\n      return isActive()\r\n        && currentUserData().privileges is map\r\n        && (\r\n          currentUserData().privileges.isRegularPioneer == true\r\n          || currentUserData().privileges.isAuxiliaryPioneer == true\r\n        );\r\n    }\r\n\r\n    function hasPermission(department, action) {\r\n      return isActive()\r\n        && currentUserData().permissions is map\r\n        && currentUserData().permissions[department] is map\r\n        && (\r\n          currentUserData().permissions[department][action] == true\r\n          || (\r\n            action != 'manage'\r\n            && currentUserData().permissions[department].manage == true\r\n          )\r\n        );\r\n    }\r\n\r\n    function hasTerritoryPermission(action) {\r\n      return isActive()\r\n        && currentUserData().permissions is map\r\n        && currentUserData().permissions.predicacion is map\r\n        && (\r\n          currentUserData().permissions.predicacion.manageTerritories == true\r\n          || (\r\n            currentUserData().permissions.predicacion.territories is map\r\n            && (\r\n              currentUserData().permissions.predicacion.territories[action] == true\r\n              || currentUserData().permissions.predicacion.territories.manage == true\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function hasPreachingAssignment(position) {\r\n      return isActive()\r\n        && (\r\n          (\r\n            currentUserData().servicePosition == position\r\n            && (\r\n              currentUserData().serviceDepartment == 'predicacion'\r\n              || currentUserData().serviceDepartment == 'territorios'\r\n            )\r\n          )\r\n          || (\r\n            currentUserData().serviceAssignments is list\r\n            && (\r\n              currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'department': 'predicacion', 'label': 'Encargado de Predicacion' }\r\n              ])\r\n              || currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }\r\n              ])\r\n              || currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'department': 'territorios', 'label': 'Territorios' }\r\n              ])\r\n              || currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'department': 'territorios', 'label': 'Encargado de Predicacion' }\r\n              ])\r\n              || currentUserData().serviceAssignments.hasAny([\r\n                { 'position': position, 'department': 'territorios', 'label': 'Auxiliar de Predicacion' }\r\n              ])\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    function canCreateTerritories() {\r\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('create');\r\n    }\r\n\r\n    function canEditTerritories() {\r\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('edit');\r\n    }\r\n\r\n    function canDeactivateTerritories() {\r\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('delete');\r\n    }\r\n\r\n    function canManageDepartments(congregationId) {\r\n      return canAccessCongregationData(congregationId)\r\n        && (\r\n          isAdmin()\r\n          || hasServicePosition('coordinador')\r\n          || hasServicePosition('secretario')\r\n          || hasPermission('departments', 'manage')\r\n          || hasPermission('organigrama', 'manage')\r\n        );\r\n    }\r\n\r\n    function canManageTerritorySchedule() {\r\n      return isAdmin()\r\n        || hasPreachingAssignment('encargado')\r\n        || hasPermission('predicacion', 'manage')\r\n        || hasTerritoryPermission('manage')\r\n        || hasTerritoryPermission('assign');\r\n    }\r\n\r\n    function canManagePreachingGroups() {\r\n      return isAdmin()\r\n        || hasPreachingAssignment('encargado')\r\n        || hasTerritoryPermission('manage');\r\n    }\r\n\r\n    function canReadUsers() {\r\n      return isAdmin()\r\n        || isSupervisor()\r\n        || isGlobalScreenAccess()\r\n        || (\r\n          currentUserData().permissions is map\r\n          && currentUserData().permissions.departments is map\r\n          && currentUserData().permissions.departments.manage == true\r\n        )\r\n        || hasPermission('usuarios', 'view')\r\n        || hasPermission('usuarios', 'manage');\r\n    }\r\n\r\n    function canCreateUsers() {\r\n      return isAdmin() || hasPermission('usuarios', 'create') || hasPermission('usuarios', 'manage');\r\n    }\r\n\r\n    function canEditUsers() {\r\n      return isAdmin() || hasPermission('usuarios', 'edit') || hasPermission('usuarios', 'manage');\r\n    }\r\n\r\n    function canDeleteUsers() {\r\n      return isAdmin() || hasPermission('usuarios', 'delete') || hasPermission('usuarios', 'manage');\r\n    }\r\n\r\n    function canManageEvents() {\r\n      return isAdmin()\r\n        || isGlobalScreenAccess()\r\n        || hasPermission('avisos', 'manage')\r\n        || (\r\n          hasPermission('avisos', 'create')\r\n          && hasPermission('avisos', 'edit')\r\n        );\r\n    }\r\n\r\n    function canManagePersons() {\r\n      return isAdmin()\r\n        || isGlobalScreenAccess()\r\n        || hasPermission('usuarios', 'manage')\r\n        || (\r\n          hasPermission('usuarios', 'create')\r\n          && hasPermission('usuarios', 'edit')\r\n        );\r\n    }\r\n\r\n    function canManageAssignments() {\r\n      return isAdmin()\r\n        || isGlobalScreenAccess()\r\n        || hasPermission('asignaciones', 'manage')\r\n        || (\r\n          hasPermission('asignaciones', 'create')\r\n          && hasPermission('asignaciones', 'edit')\r\n        );\r\n    }\r\n\r\n    function safeDelegatedUserCreate() {\r\n      return isAdmin()\r\n        || (\r\n          request.resource.data.role == 'user'\r\n          && !('permissions' in request.resource.data)\r\n          && !('privileges' in request.resource.data)\r\n          && !('responsibilities' in request.resource.data)\r\n          && !('serviceAssignments' in request.resource.data)\r\n          && !('servicePosition' in request.resource.data)\r\n          && !('serviceDepartment' in request.resource.data)\r\n        );\r\n    }\r\n\r\n    function safeDelegatedUserUpdate() {\r\n      return isAdmin()\r\n        || (\r\n          request.resource.data.role == resource.data.role\r\n          && request.resource.data.congregationId == resource.data.congregationId\r\n          && (\r\n            !('permissions' in request.resource.data) && !('permissions' in resource.data)\r\n            || request.resource.data.permissions == resource.data.permissions\r\n          )\r\n          && (\r\n            !('privileges' in request.resource.data) && !('privileges' in resource.data)\r\n            || request.resource.data.privileges == resource.data.privileges\r\n          )\r\n          && (\r\n            !('responsibilities' in request.resource.data) && !('responsibilities' in resource.data)\r\n            || request.resource.data.responsibilities == resource.data.responsibilities\r\n          )\r\n          && (\r\n            !('serviceAssignments' in request.resource.data) && !('serviceAssignments' in resource.data)\r\n            || request.resource.data.serviceAssignments == resource.data.serviceAssignments\r\n          )\r\n          && (\r\n            !('servicePosition' in request.resource.data) && !('servicePosition' in resource.data)\r\n            || request.resource.data.servicePosition == resource.data.servicePosition\r\n          )\r\n          && (\r\n            !('serviceDepartment' in request.resource.data) && !('serviceDepartment' in resource.data)\r\n            || request.resource.data.serviceDepartment == resource.data.serviceDepartment\r\n          )\r\n        );\r\n    }\r\n\r\n    function canListCongregationUsers() {\r\n      return canAccessCongregationData(myCongregationId())\r\n        && canReadUsers();\r\n    }\r\n\r\n    function isSameUser(userId) {\r\n      return isAuthenticated() && currentUid() == userId;\r\n    }\r\n\r\n    function myCongregationId() {\r\n      return hasCurrentUserDoc() ? currentUserData().congregationId : null;\r\n    }\r\n\r\n    function sameCongregation(congregationId) {\r\n      return isActive()\r\n        && isNonEmptyString(congregationId)\r\n        && myCongregationId() == congregationId;\r\n    }\r\n\r\n    function congregationPath(congregationId) {\r\n      return /databases/$(database)/documents/congregations/$(congregationId);\r\n    }\r\n\r\n    function congregationAccessBlocked(congregationId) {\r\n      return exists(congregationPath(congregationId))\r\n        && !accessBlockExpired(get(congregationPath(congregationId)).data)\r\n        && (\r\n          get(congregationPath(congregationId)).data.disabled == true\r\n          || get(congregationPath(congregationId)).data.deactivated == true\r\n          || get(congregationPath(congregationId)).data.accessDisabled == true\r\n          || get(congregationPath(congregationId)).data.isActive == false\r\n          || get(congregationPath(congregationId)).data.active == false\r\n          || get(congregationPath(congregationId)).data.enabled == false\r\n          || get(congregationPath(congregationId)).data.status in [\r\n            'inactive',\r\n            'inactivo',\r\n            'disabled',\r\n            'desactivada',\r\n            'suspended',\r\n            'suspendida',\r\n            'maintenance',\r\n            'mantenimiento'\r\n          ]\r\n        );\r\n    }\r\n\r\n    function systemMaintenanceBlocked() {\r\n      return systemMaintenanceDocBlocked(/databases/$(database)/documents/system/maintenance)\r\n        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/congregationAccess)\r\n        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/platform);\r\n    }\r\n\r\n    function systemMaintenanceDocBlocked(systemDocPath) {\r\n      return exists(systemDocPath)\r\n        && !accessBlockExpired(get(systemDocPath).data)\r\n        && (\r\n          get(systemDocPath).data.maintenanceMode == true\r\n          || get(systemDocPath).data.systemMaintenance == true\r\n          || get(systemDocPath).data.disableCongregations == true\r\n          || get(systemDocPath).data.allCongregationsDisabled == true\r\n          || get(systemDocPath).data.congregationsDisabled == true\r\n          || get(systemDocPath).data.enabled == false\r\n          || get(systemDocPath).data.isActive == false\r\n        );\r\n    }\r\n\r\n    function accessBlockExpired(data) {\r\n      return explicitAccessBlockExpired(data)\r\n        || maxAccessBlockExpired(data);\r\n    }\r\n\r\n    function explicitAccessBlockExpired(data) {\r\n      return (\r\n        ('blockedUntil' in data)\r\n        && data.blockedUntil is timestamp\r\n        && data.blockedUntil <= request.time\r\n      ) || (\r\n        ('disabledUntil' in data)\r\n        && data.disabledUntil is timestamp\r\n        && data.disabledUntil <= request.time\r\n      ) || (\r\n        ('deactivatedUntil' in data)\r\n        && data.deactivatedUntil is timestamp\r\n        && data.deactivatedUntil <= request.time\r\n      ) || (\r\n        ('maintenanceUntil' in data)\r\n        && data.maintenanceUntil is timestamp\r\n        && data.maintenanceUntil <= request.time\r\n      ) || (\r\n        ('maintenanceEndsAt' in data)\r\n        && data.maintenanceEndsAt is timestamp\r\n        && data.maintenanceEndsAt <= request.time\r\n      ) || (\r\n        ('unlockAt' in data)\r\n        && data.unlockAt is timestamp\r\n        && data.unlockAt <= request.time\r\n      ) || (\r\n        ('reactivateAt' in data)\r\n        && data.reactivateAt is timestamp\r\n        && data.reactivateAt <= request.time\r\n      ) || (\r\n        ('reactivationAt' in data)\r\n        && data.reactivationAt is timestamp\r\n        && data.reactivationAt <= request.time\r\n      ) || (\r\n        ('expiresAt' in data)\r\n        && data.expiresAt is timestamp\r\n        && data.expiresAt <= request.time\r\n      ) || (\r\n        ('endsAt' in data)\r\n        && data.endsAt is timestamp\r\n        && data.endsAt <= request.time\r\n      );\r\n    }\r\n\r\n    function maxAccessBlockExpired(data) {\r\n      return accessStartExpired(data, 'deactivatedAt')\r\n        || accessStartExpired(data, 'disabledAt')\r\n        || accessStartExpired(data, 'blockedAt')\r\n        || accessStartExpired(data, 'maintenanceStartedAt')\r\n        || accessStartExpired(data, 'startedAt')\r\n        || accessStartExpired(data, 'updatedAt')\r\n        || accessStartExpired(data, 'createdAt');\r\n    }\r\n\r\n    function accessStartExpired(data, field) {\r\n      return field in data\r\n        && data[field] is timestamp\r\n        && data[field] + duration.value(5, 'h') <= request.time;\r\n    }\r\n\r\n    function canAccessCongregationData(congregationId) {\r\n      return sameCongregation(congregationId)\r\n        && !congregationAccessBlocked(congregationId)\r\n        && !systemMaintenanceBlocked();\r\n    }\r\n\r\n    function storedDocInMyCongregation() {\r\n      return resource.data.congregationId is string\r\n        && canAccessCongregationData(resource.data.congregationId);\r\n    }\r\n\r\n    function targetDocInMyCongregation() {\r\n      return request.resource.data.congregationId is string\r\n        && canAccessCongregationData(request.resource.data.congregationId);\r\n    }\r\n\r\n    // =========================================================================\r\n    // USERS\r\n    // =========================================================================\r\n\r\n    function allowedUserKeys() {\r\n      return [\r\n        'uid',\r\n        'email',\r\n        'firstName',\r\n        'middleName',\r\n        'lastName',\r\n        'secondLastName',\r\n        'displayName',\r\n        'phone',\r\n        'gender',\r\n        'photoURL',\r\n        'role',\r\n        'isActive',\r\n        // 'status' es gestionado exclusivamente por Cloud Functions (createUserByAdmin / updateUserByAdmin).\r\n        // Se incluye aquÃ­ para que validUserData no rechace documentos que ya lo contienen\r\n        // cuando el cliente realiza actualizaciones parciales.\r\n        'status',\r\n        'congregationId',\r\n        'congregationDomain',\r\n        // Campos de asignaciÃ³n de servicio â€” escritura por Cloud Functions.\r\n        'servicePosition',\r\n        'serviceDepartment',\r\n        'serviceAssignments',\r\n        'department',\r\n        'privileges',\r\n        'responsibilities',\r\n        'permissions',\r\n        'isElder',\r\n        'isMinisterialServant',\r\n        'createdAt',\r\n        'updatedAt',\r\n        // Campos de notificaciones push â€” escritura controlada por validPushTokenUpdate()\r\n        'notificationTokens',\r\n        'pushTokenUpdatedAt',\r\n        // Campos de preferencias de notificaciÃ³n\r\n        'notificationsEnabled',\r\n        'platformNotifications',\r\n        'cleaningNotifications',\r\n        'hospitalityNotifications',\r\n        // Campos de mÃ³dulo de limpieza\r\n        'cleaningEligible',\r\n        'cleaningGroupId',\r\n        'cleaningGroupName',\r\n        'createdBy',\r\n        'createdByName',\r\n        'createdByEmail',\r\n        'updatedBy',\r\n        'updatedByName',\r\n        'updatedByEmail'\r\n      ];\r\n    }\r\n\r\n    function requiredUserKeys() {\r\n      return [\r\n        'email',\r\n        'firstName',\r\n        'lastName',\r\n        'role',\r\n        'isActive',\r\n        'congregationId'\r\n      ];\r\n    }\r\n\r\n    function validUserData(data, userId) {\r\n      return hasOnlyKeys(data, allowedUserKeys())\r\n        && hasAllKeys(data, requiredUserKeys())\r\n        && isNonEmptyString(data.email)\r\n        && isNonEmptyString(data.firstName)\r\n        && isNonEmptyString(data.lastName)\r\n        && isValidRole(data.role)\r\n        && data.isActive is bool\r\n        && isNonEmptyString(data.congregationId)\r\n        && (\r\n          !('uid' in data)\r\n          || (data.uid is string && data.uid == userId)\r\n        )\r\n        && (\r\n          !('displayName' in data)\r\n          || data.displayName is string\r\n        )