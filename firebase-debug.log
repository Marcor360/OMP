[debug] [2026-05-22T03:06:53.798Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ormeprassig-public/rulesets {"name":"projects/ormeprassig-public/rulesets/8d96c47f-5008-46d4-94f8-996b1a2ce85f","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =========================================================================\n    // AUTENTICACIÓN Y USUARIO ACTUAL\n    // =========================================================================\n\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function currentUid() {\n      return request.auth != null ? request.auth.uid : null;\n    }\n\n    function currentUserPath() {\n      return /databases/$(database)/documents/users/$(currentUid());\n    }\n\n    function hasCurrentUserDoc() {\n      return isAuthenticated() && exists(currentUserPath());\n    }\n\n    function currentUserData() {\n      return get(currentUserPath()).data;\n    }\n\n    function isSuperAdmin() {\n      return request.auth != null\n        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))\n        && get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data.isActive == true;\n    }\n\n    // =========================================================================\n    // VALIDACIONES BASE\n    // =========================================================================\n\n    function isNonEmptyString(value) {\n      return value is string && value.size() > 0;\n    }\n\n    function isValidRole(role) {\n      return role is string && role in ['admin', 'administrador', 'supervisor', 'user', 'usuario'];\n    }\n\n    function hasOnlyKeys(data, allowed) {\n      return data.keys().hasOnly(allowed);\n    }\n\n    function hasAllKeys(data, required) {\n      return data.keys().hasAll(required);\n    }\n\n    function sameKeysOnUpdate(allowedChangedKeys) {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedChangedKeys);\n    }\n\n    function preservesCreatedAt() {\n      return !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt;\n    }\n\n    // =========================================================================\n    // ESTADO DEL USUARIO ACTUAL\n    // =========================================================================\n\n    function currentUserHasRequiredShape() {\n      return hasCurrentUserDoc()\n        && isValidRole(currentUserData().role)\n        && isNonEmptyString(currentUserData().congregationId)\n        && currentUserData().isActive is bool;\n    }\n\n    function isActive() {\n      return currentUserHasRequiredShape()\n        && currentUserData().isActive == true;\n    }\n\n    function isAdmin() {\n      return isActive()\n        && (currentUserData().role == 'admin' || currentUserData().role == 'administrador');\n    }\n\n    function isSupervisor() {\n      return isActive() && currentUserData().role == 'supervisor';\n    }\n\n    function isAdminOrSupervisor() {\n      return isAdmin() || isSupervisor();\n    }\n\n    function isElder() {\n      return isActive()\n        && (\n          currentUserData().isElder == true\n          || (\n            currentUserData().privileges is map\n            && currentUserData().privileges.isElder == true\n          )\n        );\n    }\n\n    function isCleaningManager() {\n      return isAdmin()\n        || hasPermission('limpieza', 'manage')\n        || (\n          hasPermission('limpieza', 'create')\n          && hasPermission('limpieza', 'edit')\n        )\n        || (\n          isActive()\n          && (\n            (\n              currentUserData().servicePosition == 'encargado'\n              && (\n                !('serviceDepartment' in currentUserData())\n                || currentUserData().serviceDepartment == 'limpieza'\n              )\n            )\n            || (\n              currentUserData().serviceAssignments is list\n              && currentUserData().serviceAssignments.hasAny([\n                { 'position': 'encargado', 'department': 'limpieza', 'label': 'Encargado de Limpieza' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isPreachingManager() {\n      return isActive()\n        && (\n          (\n            currentUserData().serviceDepartment == 'predicacion'\n            && (\n              (\n                currentUserData().servicePosition == 'encargado'\n                && currentUserData().privileges is map\n                && currentUserData().privileges.isElder == true\n              )\n              || currentUserData().servicePosition == 'auxiliar'\n            )\n          )\n          || (\n            currentUserData().serviceAssignments is list\n            && (\n              (\n                currentUserData().privileges is map\n                && currentUserData().privileges.isElder == true\n                && currentUserData().serviceAssignments.hasAny([\n                  { 'position': 'encargado', 'department': 'predicacion', 'label': 'Encargado de Predicacion' }\n                ])\n              )\n              || currentUserData().serviceAssignments.hasAny([\n                { 'position': 'auxiliar', 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isOutgoingTalksManager() {\n      return isAdmin()\n        || (\n          isActive()\n          && (\n            (\n              currentUserData().servicePosition == 'encargado'\n              && currentUserData().serviceDepartment == 'discursos'\n            )\n            || (\n              currentUserData().serviceAssignments is list\n              && currentUserData().serviceAssignments.hasAny([\n                { 'position': 'encargado', 'department': 'discursos', 'label': 'Encargado de Discursos' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isMeetingsManager() {\n      return isAdminOrSupervisor()\n        || hasPermission('reuniones', 'manage')\n        || (\n          hasPermission('reuniones', 'create')\n          && hasPermission('reuniones', 'edit')\n        )\n        || (\n          isActive()\n          && (\n            (\n              currentUserData().servicePosition == 'encargado'\n              && currentUserData().serviceDepartment == 'reuniones'\n            )\n            || (\n              currentUserData().serviceAssignments is list\n              && currentUserData().serviceAssignments.hasAny([\n                { 'position': 'encargado', 'department': 'reuniones', 'label': 'Encargado de Reuniones' }\n              ])\n            )\n          )\n        );\n    }\n\n    function isPioneer() {\n      return isActive()\n        && currentUserData().privileges is map\n        && (\n          currentUserData().privileges.isRegularPioneer == true\n          || currentUserData().privileges.isAuxiliaryPioneer == true\n        );\n    }\n\n    function hasPermission(department, action) {\n      return isActive()\n        && currentUserData().permissions is map\n        && currentUserData().permissions[department] is map\n        && currentUserData().permissions[department][action] == true;\n    }\n\n    function hasTerritoryPermission(action) {\n      return isActive()\n        && currentUserData().permissions is map\n        && currentUserData().permissions.predicacion is map\n        && currentUserData().permissions.predicacion.territories is map\n        && currentUserData().permissions.predicacion.territories[action] == true;\n    }\n\n    function hasPreachingAssignment(position) {\n      return isActive()\n        && (\n          (\n            currentUserData().servicePosition == position\n            && currentUserData().serviceDepartment == 'predicacion'\n          )\n          || (\n            currentUserData().serviceAssignments is list\n            && (\n              currentUserData().serviceAssignments.hasAny([\n                { 'position': position, 'department': 'predicacion', 'label': 'Encargado de Predicacion' }\n              ])\n              || currentUserData().serviceAssignments.hasAny([\n                { 'position': position, 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }\n              ])\n            )\n          )\n        );\n    }\n\n    function canCreateTerritories() {\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('create');\n    }\n\n    function canEditTerritories() {\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('edit');\n    }\n\n    function canDeactivateTerritories() {\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('delete');\n    }\n\n    function canAssignTerritories() {\n      return isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('assign');\n    }\n\n    function canReadUsers() {\n      return isAdmin() || hasPermission('usuarios', 'view') || hasPermission('usuarios', 'manage');\n    }\n\n    function canCreateUsers() {\n      return isAdmin() || hasPermission('usuarios', 'create') || hasPermission('usuarios', 'manage');\n    }\n\n    function canEditUsers() {\n      return isAdmin() || hasPermission('usuarios', 'edit') || hasPermission('usuarios', 'manage');\n    }\n\n    function canDeleteUsers() {\n      return isAdmin() || hasPermission('usuarios', 'delete') || hasPermission('usuarios', 'manage');\n    }\n\n    function safeDelegatedUserCreate() {\n      return isAdmin()\n        || (\n          request.resource.data.role == 'user'\n          && !('permissions' in request.resource.data)\n          && !('privileges' in request.resource.data)\n          && !('responsibilities' in request.resource.data)\n          && !('serviceAssignments' in request.resource.data)\n          && !('servicePosition' in request.resource.data)\n          && !('serviceDepartment' in request.resource.data)\n        );\n    }\n\n    function safeDelegatedUserUpdate() {\n      return isAdmin()\n        || (\n          request.resource.data.role == resource.data.role\n          && request.resource.data.congregationId == resource.data.congregationId\n          && (\n            !('permissions' in request.resource.data) && !('permissions' in resource.data)\n            || request.resource.data.permissions == resource.data.permissions\n          )\n          && (\n            !('privileges' in request.resource.data) && !('privileges' in resource.data)\n            || request.resource.data.privileges == resource.data.privileges\n          )\n          && (\n            !('responsibilities' in request.resource.data) && !('responsibilities' in resource.data)\n            || request.resource.data.responsibilities == resource.data.responsibilities\n          )\n          && (\n            !('serviceAssignments' in request.resource.data) && !('serviceAssignments' in resource.data)\n            || request.resource.data.serviceAssignments == resource.data.serviceAssignments\n          )\n          && (\n            !('servicePosition' in request.resource.data) && !('servicePosition' in resource.data)\n            || request.resource.data.servicePosition == resource.data.servicePosition\n          )\n          && (\n            !('serviceDepartment' in request.resource.data) && !('serviceDepartment' in resource.data)\n            || request.resource.data.serviceDepartment == resource.data.serviceDepartment\n          )\n        );\n    }\n\n    function canListCongregationUsers() {\n      return canAccessCongregationData(myCongregationId())\n        && canReadUsers();\n    }\n\n    function isSameUser(userId) {\n      return isAuthenticated() && currentUid() == userId;\n    }\n\n    function myCongregationId() {\n      return hasCurrentUserDoc() ? currentUserData().congregationId : null;\n    }\n\n    function sameCongregation(congregationId) {\n      return isActive()\n        && isNonEmptyString(congregationId)\n        && myCongregationId() == congregationId;\n    }\n\n    function congregationPath(congregationId) {\n      return /databases/$(database)/documents/congregations/$(congregationId);\n    }\n\n    function congregationAccessBlocked(congregationId) {\n      return exists(congregationPath(congregationId))\n        && !accessBlockExpired(get(congregationPath(congregationId)).data)\n        && (\n          get(congregationPath(congregationId)).data.disabled == true\n          || get(congregationPath(congregationId)).data.deactivated == true\n          || get(congregationPath(congregationId)).data.accessDisabled == true\n          || get(congregationPath(congregationId)).data.isActive == false\n          || get(congregationPath(congregationId)).data.active == false\n          || get(congregationPath(congregationId)).data.enabled == false\n          || get(congregationPath(congregationId)).data.status in [\n            'inactive',\n            'inactivo',\n            'disabled',\n            'desactivada',\n            'suspended',\n            'suspendida',\n            'maintenance',\n            'mantenimiento'\n          ]\n        );\n    }\n\n    function systemMaintenanceBlocked() {\n      return systemMaintenanceDocBlocked(/databases/$(database)/documents/system/maintenance)\n        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/congregationAccess)\n        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/platform);\n    }\n\n    function systemMaintenanceDocBlocked(systemDocPath) {\n      return exists(systemDocPath)\n        && !accessBlockExpired(get(systemDocPath).data)\n        && (\n          get(systemDocPath).data.maintenanceMode == true\n          || get(systemDocPath).data.systemMaintenance == true\n          || get(systemDocPath).data.disableCongregations == true\n          || get(systemDocPath).data.allCongregationsDisabled == true\n          || get(systemDocPath).data.congregationsDisabled == true\n          || get(systemDocPath).data.enabled == false\n          || get(systemDocPath).data.isActive == false\n        );\n    }\n\n    function accessBlockExpired(data) {\n      return explicitAccessBlockExpired(data)\n        || maxAccessBlockExpired(data);\n    }\n\n    function explicitAccessBlockExpired(data) {\n      return (\n        ('blockedUntil' in data)\n        && data.blockedUntil is timestamp\n        && data.blockedUntil <= request.time\n      ) || (\n        ('disabledUntil' in data)\n        && data.disabledUntil is timestamp\n        && data.disabledUntil <= request.time\n      ) || (\n        ('deactivatedUntil' in data)\n        && data.deactivatedUntil is timestamp\n        && data.deactivatedUntil <= request.time\n      ) || (\n        ('maintenanceUntil' in data)\n        && data.maintenanceUntil is timestamp\n        && data.maintenanceUntil <= request.time\n      ) || (\n        ('maintenanceEndsAt' in data)\n        && data.maintenanceEndsAt is timestamp\n        && data.maintenanceEndsAt <= request.time\n      ) || (\n        ('unlockAt' in data)\n        && data.unlockAt is timestamp\n        && data.unlockAt <= request.time\n      ) || (\n        ('reactivateAt' in data)\n        && data.reactivateAt is timestamp\n        && data.reactivateAt <= request.time\n      ) || (\n        ('reactivationAt' in data)\n        && data.reactivationAt is timestamp\n        && data.reactivationAt <= request.time\n      ) || (\n        ('expiresAt' in data)\n        && data.expiresAt is timestamp\n        && data.expiresAt <= request.time\n      ) || (\n        ('endsAt' in data)\n        && data.endsAt is timestamp\n        && data.endsAt <= request.time\n      );\n    }\n\n    function maxAccessBlockExpired(data) {\n      return accessStartExpired(data, 'deactivatedAt')\n        || accessStartExpired(data, 'disabledAt')\n        || accessStartExpired(data, 'blockedAt')\n        || accessStartExpired(data, 'maintenanceStartedAt')\n        || accessStartExpired(data, 'startedAt')\n        || accessStartExpired(data, 'updatedAt')\n        || accessStartExpired(data, 'createdAt');\n    }\n\n    function accessStartExpired(data, field) {\n      return field in data\n        && data[field] is timestamp\n        && data[field] + duration.value(5, 'h') <= request.time;\n    }\n\n    function canAccessCongregationData(congregationId) {\n      return sameCongregation(congregationId)\n        && !congregationAccessBlocked(congregationId)\n        && !systemMaintenanceBlocked();\n    }\n\n    function storedDocInMyCongregation() {\n      return resource.data.congregationId is string\n        && canAccessCongregationData(resource.data.congregationId);\n    }\n\n    function targetDocInMyCongregation() {\n      return request.resource.data.congregationId is string\n        && canAccessCongregationData(request.resource.data.congregationId);\n    }\n\n    // =========================================================================\n    // USERS\n    // =========================================================================\n\n    function allowedUserKeys() {\n      return [\n        'uid',\n        'email',\n        'firstName',\n        'middleName',\n        'lastName',\n        'secondLastName',\n        'displayName',\n        'phone',\n        'gender',\n        'photoURL',\n        'role',\n        'isActive',\n        // 'status' es gestionado exclusivamente por Cloud Functions (createUserByAdmin / updateUserByAdmin).\n        // Se incluye aquí para que validUserData no rechace documentos que ya lo contienen\n        // cuando el cliente realiza actualizaciones parciales.\n        'status',\n        'congregationId',\n        'congregationDomain',\n        // Campos de asignación de servicio — escritura por Cloud Functions.\n        'servicePosition',\n        'serviceDepartment',\n        'serviceAssignments',\n        'department',\n        'privileges',\n        'responsibilities',\n        'permissions',\n        'isElder',\n        'isMinisterialServant',\n        'createdAt',\n        'updatedAt',\n        // Campos de notificaciones push — escritura controlada por validPushTokenUpdate()\n        'notificationTokens',\n        'pushTokenUpdatedAt',\n        // Campos de preferencias de notificación\n        'notificationsEnabled',\n        'platformNotifications',\n        'cleaningNotifications',\n        'hospitalityNotifications',\n        // Campos de módulo de limpieza\n        'cleaningEligible',\n        'cleaningGroupId',\n        'cleaningGroupName',\n        'createdBy',\n        'createdByName',\n        'createdByEmail',\n        'updatedBy',\n        'updatedByName',\n        'updatedByEmail'\n      ];\n    }\n\n    function requiredUserKeys() {\n      return [\n        'email',\n        'firstName',\n        'lastName',\n        'role',\n        'isActive',\n        'congregationId'\n      ];\n    }\n\n    function validUserData(data, userId) {\n      return hasOnlyKeys(data, allowedUserKeys())\n        && hasAllKeys(data, requiredUserKeys())\n        && isNonEmptyString(data.email)\n        && isNonEmptyString(data.firstName)\n        && isNonEmptyString(data.lastName)\n        && isValidRole(data.role)\n        && data.isActive is bool\n        && isNonEmptyString(data.congregationId)\n        && (\n          !('uid' in data)\n          || (data.uid is string && data.uid == userId)\n        )\n        && (\n          !('displayName' in data)\n          || data.displayName is string\n        )\n        && (\n          !('phone' in data)\n          || data.phone is string\n        )\n        && (\n          !('gender' in data)\n          || data.gender in ['masculino', 'femenino']\n        )\n        && (\n          !('photoURL' in data)\n          || data.photoURL is string\n        )\n        && (