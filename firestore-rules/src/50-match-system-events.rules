    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // REGLAS: SYSTEM ANNOUNCEMENTS
    // Avisos globales administrados desde la app administrativa.
    // =========================================================================

    match /systemAnnouncements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // REGLAS: SUPER ADMINS
    // =========================================================================

    match /superAdmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // REGLAS: USERS
    // =========================================================================

    match /events/{eventId} {
      allow get, list: if isActive()
        && resource.data.congregationId == myCongregationId()
        && canAccessCongregationData(resource.data.congregationId);
      allow create: if validEventCreate();
      allow update: if validEventUpdate();
      allow delete: if canManageEvents()
        && resource.data.congregationId == myCongregationId();
    }

