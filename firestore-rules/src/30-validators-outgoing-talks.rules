    function validOutgoingTalkStatus(status) {
      return status is string && status in ['scheduled', 'cancelled', 'completed'];
    }

    function validDateKey(value) {
      return value is string
        && value.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validTimeKey(value) {
      return value is string
        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validOutgoingTalkData(data, congregationId) {
      return hasOnlyKeys(data, [
          'congregationId',
          'speakerUserId',
          'speakerName',
          'destinationCongregationName',
          'talkDate',
          'talkTime',
          'weekStartDate',
          'weekEndDate',
          'status',
          'notes',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'speakerUserId',
          'speakerName',
          'destinationCongregationName',
          'talkDate',
          'talkTime',
          'weekStartDate',
          'weekEndDate',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && isNonEmptyString(data.speakerUserId)
        && isNonEmptyString(data.speakerName)
        && isNonEmptyString(data.destinationCongregationName)
        && validDateKey(data.talkDate)
        && validTimeKey(data.talkTime)
        && validDateKey(data.weekStartDate)
        && validDateKey(data.weekEndDate)
        && data.weekStartDate <= data.talkDate
        && data.talkDate <= data.weekEndDate
        && validOutgoingTalkStatus(data.status)
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

