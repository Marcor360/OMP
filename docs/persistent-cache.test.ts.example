import AsyncStorage from '@react-native-async-storage/async-storage';

import {
  buildCongregationCacheKey,
  buildUserCacheKey,
  clearAllPersistentCache,
  clearPersistentCacheByPrefix,
  clearPersistentCachedValue,
  getAnnualCacheCycleKey,
  getPersistentCachedValue,
  initializePersistentCacheCycle,
  setPersistentCachedValue,
} from '@/src/services/repositories/persistent-cache';

jest.mock('@react-native-async-storage/async-storage', () => {
  const store = new Map<string, string>();

  return {
    getItem: jest.fn((key: string) => Promise.resolve(store.get(key) ?? null)),
    setItem: jest.fn((key: string, value: string) => {
      store.set(key, value);
      return Promise.resolve();
    }),
    removeItem: jest.fn((key: string) => {
      store.delete(key);
      return Promise.resolve();
    }),
    multiGet: jest.fn((keys: string[]) =>
      Promise.resolve(keys.map((key) => [key, store.get(key) ?? null]))
    ),
    multiRemove: jest.fn((keys: string[]) => {
      keys.forEach((key) => store.delete(key));
      return Promise.resolve();
    }),
    getAllKeys: jest.fn(() => Promise.resolve(Array.from(store.keys()))),
    __store: store,
  };
});

const mockedStorage = AsyncStorage as typeof AsyncStorage & {
  __store: Map<string, string>;
};

beforeEach(() => {
  mockedStorage.__store.clear();
  jest.useRealTimers();
});

describe('persistent-cache', () => {
  it('resolves annual cycle boundaries', () => {
    expect(getAnnualCacheCycleKey(new Date('2026-08-31T12:00:00'))).toBe('2025-2026');
    expect(getAnnualCacheCycleKey(new Date('2026-09-01T12:00:00'))).toBe('2026-2027');
    expect(getAnnualCacheCycleKey(new Date('2027-01-10T12:00:00'))).toBe('2026-2027');
  });

  it('builds scoped cache keys', () => {
    expect(buildCongregationCacheKey('abc', 'query:meetings:week')).toBe(
      'congregation:abc:query:meetings:week'
    );
    expect(buildUserCacheKey('uid-1', 'profile')).toBe('user:uid-1:profile');
  });

  it('sets and gets cached values', async () => {
    await initializePersistentCacheCycle();
    await setPersistentCachedValue('doc:users/u1', { name: 'User 1' });

    await expect(getPersistentCachedValue('doc:users/u1')).resolves.toEqual({ name: 'User 1' });
  });

  it('respects maxAgeMs', async () => {
    jest.useFakeTimers().setSystemTime(new Date('2026-09-01T12:00:00').getTime());
    await setPersistentCachedValue('doc:users/u1', { name: 'User 1' });

    jest.setSystemTime(new Date('2026-09-01T12:01:00').getTime());
    await expect(getPersistentCachedValue('doc:users/u1', 1)).resolves.toBeUndefined();
  });

  it('clears a single value', async () => {
    await setPersistentCachedValue('doc:users/u1', { name: 'User 1' });
    await clearPersistentCachedValue('doc:users/u1');

    await expect(getPersistentCachedValue('doc:users/u1')).resolves.toBeUndefined();
  });

  it('clears by prefix', async () => {
    await setPersistentCachedValue('query:meetings/c1/week/a', ['a']);
    await setPersistentCachedValue('query:meetings/c2/week/a', ['b']);
    await clearPersistentCacheByPrefix('query:meetings/c1/');

    await expect(getPersistentCachedValue('query:meetings/c1/week/a')).resolves.toBeUndefined();
    await expect(getPersistentCachedValue('query:meetings/c2/week/a')).resolves.toEqual(['b']);
  });

  it('clears only OMP persistent cache keys', async () => {
    await setPersistentCachedValue('doc:users/u1', { name: 'User 1' });
    await AsyncStorage.setItem('@omp/theme-mode', 'dark');
    await clearAllPersistentCache();

    await expect(AsyncStorage.getItem('@omp/theme-mode')).resolves.toBe('dark');
    await expect(getPersistentCachedValue('doc:users/u1')).resolves.toBeUndefined();
  });
});
