{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "noUnusedLocals": false,
    "strict": true,
    "isolatedModules": true,
    "allowArbitraryExtensions": true
  },
  "include": [
    "src/__tests__"
  ],
  "exclude": []
}
