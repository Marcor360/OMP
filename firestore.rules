rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // AUTENTICACION Y USUARIO ACTUAL
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth != null ? request.auth.uid : null;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(currentUid());
    }

    function hasCurrentUserDoc() {
      return isAuthenticated() && exists(currentUserPath());
    }

    function currentUserData() {
      return get(currentUserPath()).data;
    }

    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data.isActive == true;
    }

    // =========================================================================
    // VALIDACIONES BASE
    // =========================================================================

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isValidRole(role) {
      return role is string && role in ['admin', 'administrador', 'supervisor', 'user', 'usuario'];
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function hasAllKeys(data, required) {
      return data.keys().hasAll(required);
    }

    function sameKeysOnUpdate(allowedChangedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedChangedKeys);
    }

    function preservesCreatedAt() {
      return !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt;
    }

    // =========================================================================
    // ESTADO DEL USUARIO ACTUAL
    // =========================================================================

    function currentUserHasRequiredShape() {
      return hasCurrentUserDoc()
        && isValidRole(currentUserData().role)
        && isNonEmptyString(currentUserData().congregationId)
        && currentUserData().isActive is bool;
    }

    function isActive() {
      return currentUserHasRequiredShape()
        && currentUserData().isActive == true;
    }

    function isAdmin() {
      return isActive()
        && (currentUserData().role == 'admin' || currentUserData().role == 'administrador');
    }

    function isSupervisor() {
      return isActive() && currentUserData().role == 'supervisor';
    }

    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    function hasServicePosition(position) {
      return isActive()
        && (
          currentUserData().servicePosition == position
          || (
            currentUserData().serviceAssignments is list
            && (
              currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'label': 'Coordinador' },
                { 'position': position, 'label': 'Secretario' }
              ])
              || currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'department': 'limpieza', 'label': 'Encargado de Limpieza' },
                { 'position': position, 'department': 'limpieza', 'label': 'Auxiliar de Limpieza' },
                { 'position': position, 'department': 'tesoreria', 'label': 'Encargado de Tesoreria' },
                { 'position': position, 'department': 'tesoreria', 'label': 'Auxiliar de Tesoreria' },
                { 'position': position, 'department': 'predicacion', 'label': 'Encargado de Predicacion' },
                { 'position': position, 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' },
                { 'position': position, 'department': 'reuniones', 'label': 'Encargado de Reuniones' },
                { 'position': position, 'department': 'reuniones', 'label': 'Auxiliar de Reuniones' },
                { 'position': position, 'department': 'discursos', 'label': 'Encargado de Discursos' },
                { 'position': position, 'department': 'discursos', 'label': 'Auxiliar de Discursos' }
              ])
            )
          )
        );
    }

    function isCoordinatorOrSecretary() {
      return hasServicePosition('coordinador') || hasServicePosition('secretario');
    }

    function isGlobalScreenAccess() {
      return isSuperAdmin()
        || isCoordinatorOrSecretary()
        || (
          isActive()
          && (
            currentUserData().protectedFromDeletion == true
            || currentUserData().isSystemUser == true
            || currentUserData().isPrimaryAdmin == true
            || currentUserData().isRootAdmin == true
            || currentUserData().systemProtected == true
          )
        );
    }

    function isCleaningManager() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || hasPermission('limpieza', 'manage')
          || (
            hasPermission('limpieza', 'create')
            && hasPermission('limpieza', 'edit')
          )
          || (
            isActive()
            && (
              (
                currentUserData().servicePosition == 'encargado'
                && (
                  !('serviceDepartment' in currentUserData())
                  || currentUserData().serviceDepartment == 'limpieza'
                )
              )
              || (
                currentUserData().serviceAssignments is list
                && currentUserData().serviceAssignments.hasAny([
                  { 'position': 'encargado', 'department': 'limpieza', 'label': 'Encargado de Limpieza' }
                ])
              )
            )
          )
        );
    }

    function isHospitalityMicrophonesManager() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || hasPermission('acomodadores_microfonos', 'manage')
          || (
            hasPermission('acomodadores_microfonos', 'create')
            && hasPermission('acomodadores_microfonos', 'edit')
          )
          || (
            isActive()
            && (
              (
                currentUserData().servicePosition == 'encargado'
                && currentUserData().serviceDepartment == 'acomodadores_microfonos'
              )
              || (
                currentUserData().serviceAssignments is list
                && currentUserData().serviceAssignments.hasAny([
                  { 'position': 'encargado', 'department': 'acomodadores_microfonos', 'label': 'Encargado de Acomodadores y Microfonos' },
                  { 'position': 'auxiliar', 'department': 'acomodadores_microfonos', 'label': 'Auxiliar de Acomodadores y Microfonos' }
                ])
              )
            )
          )
        );
    }

    function isPreachingManager() {
      return isActive()
        && (
          (
            (
              currentUserData().serviceDepartment == 'predicacion'
              || currentUserData().serviceDepartment == 'territorios'
            )
            && (
              (
                currentUserData().servicePosition == 'encargado'
                && currentUserData().privileges is map
                && currentUserData().privileges.isElder == true
              )
              || currentUserData().servicePosition == 'auxiliar'
            )
          )
          || (
            currentUserData().serviceAssignments is list
            && (
              (
                currentUserData().privileges is map
                && currentUserData().privileges.isElder == true
                && currentUserData().serviceAssignments.hasAny([
                  { 'position': 'encargado', 'department': 'predicacion', 'label': 'Encargado de Predicacion' }
                ])
              )
              || currentUserData().serviceAssignments.hasAny([
                { 'position': 'auxiliar', 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }
              ])
            )
          )
        );
    }

    function isOutgoingTalksManager() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || (
            isActive()
            && (
              (
                currentUserData().servicePosition == 'encargado'
                && currentUserData().serviceDepartment == 'discursos'
              )
              || (
                currentUserData().serviceAssignments is list
                && currentUserData().serviceAssignments.hasAny([
                  { 'position': 'encargado', 'department': 'discursos', 'label': 'Encargado de Discursos' }
                ])
              )
            )
          )
        );
    }

    function isMeetingsManager() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || isGlobalScreenAccess()
          || hasPermission('reuniones', 'manage')
          || (
            hasPermission('reuniones', 'create')
            && hasPermission('reuniones', 'edit')
          )
          || (
            isActive()
            && (
              (
                currentUserData().servicePosition == 'encargado'
                && currentUserData().serviceDepartment == 'reuniones'
              )
              || (
                currentUserData().serviceAssignments is list
                && currentUserData().serviceAssignments.hasAny([
                  { 'position': 'encargado', 'department': 'reuniones', 'label': 'Encargado de Reuniones' }
                ])
              )
            )
          )
        );
    }

    function isPioneer() {
      return isActive()
        && currentUserData().privileges is map
        && (
          currentUserData().privileges.isRegularPioneer == true
          || currentUserData().privileges.isAuxiliaryPioneer == true
        );
    }

    function hasPermission(department, action) {
      return isActive()
        && currentUserData().permissions is map
        && currentUserData().permissions[department] is map
        && (
          currentUserData().permissions[department][action] == true
          || (
            action != 'manage'
            && currentUserData().permissions[department].manage == true
          )
        );
    }

    function hasTerritoryPermission(action) {
      return isActive()
        && currentUserData().permissions is map
        && currentUserData().permissions.predicacion is map
        && (
          currentUserData().permissions.predicacion.manageTerritories == true
          || (
            currentUserData().permissions.predicacion.territories is map
            && (
              currentUserData().permissions.predicacion.territories[action] == true
              || currentUserData().permissions.predicacion.territories.manage == true
            )
          )
        );
    }

    function hasPreachingAssignment(position) {
      return isActive()
        && (
          (
            currentUserData().servicePosition == position
            && (
              currentUserData().serviceDepartment == 'predicacion'
              || currentUserData().serviceDepartment == 'territorios'
            )
          )
          || (
            currentUserData().serviceAssignments is list
            && (
              currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'department': 'predicacion', 'label': 'Encargado de Predicacion' }
              ])
              || currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'department': 'predicacion', 'label': 'Auxiliar de Predicacion' }
              ])
              || currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'department': 'territorios', 'label': 'Territorios' }
              ])
              || currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'department': 'territorios', 'label': 'Encargado de Predicacion' }
              ])
              || currentUserData().serviceAssignments.hasAny([
                { 'position': position, 'department': 'territorios', 'label': 'Auxiliar de Predicacion' }
              ])
            )
          )
        );
    }

    function canCreateTerritories() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('create'));
    }

    function canEditTerritories() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('edit'));
    }

    function canDeactivateTerritories() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('delete'));
    }

    function canManageDepartments(congregationId) {
      return canAccessCongregationData(congregationId)
        && administrativeWritesAllowed(congregationId)
        && (
          isAdmin()
          || hasServicePosition('coordinador')
          || hasServicePosition('secretario')
          || hasPermission('departments', 'manage')
          || hasPermission('organigrama', 'manage')
        );
    }

    function canManageTerritorySchedule() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || hasPreachingAssignment('encargado')
          || hasPermission('predicacion', 'manage')
          || hasTerritoryPermission('manage')
          || hasTerritoryPermission('assign')
        );
    }

    function canManagePreachingGroups() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || hasPreachingAssignment('encargado')
          || hasTerritoryPermission('manage')
        );
    }

    function canReadUsers() {
      return isAdmin()
        || isSupervisor()
        || hasPermission('usuarios', 'view')
        || hasPermission('usuarios', 'manage')
        || isGlobalScreenAccess()
        || (
          currentUserData().permissions is map
          && currentUserData().permissions.departments is map
          && currentUserData().permissions.departments.manage == true
        );
    }

    function canCreateUsers() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPermission('usuarios', 'create') || hasPermission('usuarios', 'manage'));
    }

    function canEditUsers() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPermission('usuarios', 'edit') || hasPermission('usuarios', 'manage'));
    }

    function canDeleteUsers() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPermission('usuarios', 'delete') || hasPermission('usuarios', 'manage'));
    }

    function canManageEvents() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || isGlobalScreenAccess()
          || hasPermission('avisos', 'manage')
          || (
            hasPermission('avisos', 'create')
            && hasPermission('avisos', 'edit')
          )
        );
    }

    function canManagePersons() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || isGlobalScreenAccess()
          || hasPermission('usuarios', 'manage')
          || (
            hasPermission('usuarios', 'create')
            && hasPermission('usuarios', 'edit')
          )
        );
    }

    function canManageAssignments() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || isGlobalScreenAccess()
          || hasPermission('asignaciones', 'manage')
          || (
            hasPermission('asignaciones', 'create')
            && hasPermission('asignaciones', 'edit')
          )
        );
    }

    function safeDelegatedUserCreate() {
      return isAdmin()
        || (
          request.resource.data.role == 'user'
          && !('permissions' in request.resource.data)
          && !('privileges' in request.resource.data)
          && !('responsibilities' in request.resource.data)
          && !('serviceAssignments' in request.resource.data)
          && !('servicePosition' in request.resource.data)
          && !('serviceDepartment' in request.resource.data)
        );
    }

    function safeDelegatedUserUpdate() {
      return isAdmin()
        || (
          request.resource.data.role == resource.data.role
          && request.resource.data.congregationId == resource.data.congregationId
          && (
            !('permissions' in request.resource.data) && !('permissions' in resource.data)
            || request.resource.data.permissions == resource.data.permissions
          )
          && (
            !('privileges' in request.resource.data) && !('privileges' in resource.data)
            || request.resource.data.privileges == resource.data.privileges
          )
          && (
            !('responsibilities' in request.resource.data) && !('responsibilities' in resource.data)
            || request.resource.data.responsibilities == resource.data.responsibilities
          )
          && (
            !('serviceAssignments' in request.resource.data) && !('serviceAssignments' in resource.data)
            || request.resource.data.serviceAssignments == resource.data.serviceAssignments
          )
          && (
            !('servicePosition' in request.resource.data) && !('servicePosition' in resource.data)
            || request.resource.data.servicePosition == resource.data.servicePosition
          )
          && (
            !('serviceDepartment' in request.resource.data) && !('serviceDepartment' in resource.data)
            || request.resource.data.serviceDepartment == resource.data.serviceDepartment
          )
        );
    }

    function canListCongregationUsers() {
      return canAccessCongregationData(myCongregationId())
        && canReadUsers();
    }

    function isSameUser(userId) {
      return isAuthenticated() && currentUid() == userId;
    }

    function myCongregationId() {
      return hasCurrentUserDoc() ? currentUserData().congregationId : null;
    }

    function sameCongregation(congregationId) {
      return isActive()
        && isNonEmptyString(congregationId)
        && myCongregationId() == congregationId;
    }

    function congregationPath(congregationId) {
      return /databases/$(database)/documents/congregations/$(congregationId);
    }

    function congregationAccessBlocked(congregationId) {
      return exists(congregationPath(congregationId))
        && !accessBlockExpired(get(congregationPath(congregationId)).data)
        && (
          get(congregationPath(congregationId)).data.disabled == true
          || get(congregationPath(congregationId)).data.deactivated == true
          || get(congregationPath(congregationId)).data.accessDisabled == true
          || get(congregationPath(congregationId)).data.isActive == false
          || get(congregationPath(congregationId)).data.active == false
          || get(congregationPath(congregationId)).data.enabled == false
          || get(congregationPath(congregationId)).data.status in [
            'inactive',
            'inactivo',
            'disabled',
            'desactivada',
            'suspended',
            'suspendida',
            'maintenance',
            'mantenimiento'
          ]
        );
    }

    function billingExemptionActive(data) {
      return 'billingExemption' in data
        && data.billingExemption is map
        && data.billingExemption.exempt == true
        && (
          !('expiresAt' in data.billingExemption)
          || data.billingExemption.expiresAt == null
          || (
            data.billingExemption.expiresAt is timestamp
            && data.billingExemption.expiresAt > request.time
          )
        );
    }

    function congregationBillingAdministrativeRestricted(congregationId) {
      return isNonEmptyString(congregationId)
        && exists(congregationPath(congregationId))
        && !billingExemptionActive(get(congregationPath(congregationId)).data)
        && 'billing' in get(congregationPath(congregationId)).data
        && get(congregationPath(congregationId)).data.billing is map
        && get(congregationPath(congregationId)).data.billing.provider == 'stripe'
        && (
          get(congregationPath(congregationId)).data.billing.adminRestricted == true
          || get(congregationPath(congregationId)).data.billing.status in [
            'unpaid',
            'canceled',
            'incomplete_expired'
          ]
          || (
            get(congregationPath(congregationId)).data.billing.status in [
              'past_due',
              'payment_action_required',
              'incomplete'
            ]
            && 'graceUntil' in get(congregationPath(congregationId)).data.billing
            && get(congregationPath(congregationId)).data.billing.graceUntil is timestamp
            && get(congregationPath(congregationId)).data.billing.graceUntil <= request.time
          )
        );
    }

    function administrativeWritesAllowed(congregationId) {
      return !isNonEmptyString(congregationId)
        || !congregationBillingAdministrativeRestricted(congregationId);
    }

    function systemMaintenanceBlocked() {
      return systemMaintenanceDocBlocked(/databases/$(database)/documents/system/maintenance)
        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/congregationAccess)
        || systemMaintenanceDocBlocked(/databases/$(database)/documents/system/platform);
    }

    function systemMaintenanceDocBlocked(systemDocPath) {
      return exists(systemDocPath)
        && !accessBlockExpired(get(systemDocPath).data)
        && (
          get(systemDocPath).data.maintenanceMode == true
          || get(systemDocPath).data.systemMaintenance == true
          || get(systemDocPath).data.disableCongregations == true
          || get(systemDocPath).data.allCongregationsDisabled == true
          || get(systemDocPath).data.congregationsDisabled == true
          || get(systemDocPath).data.enabled == false
          || get(systemDocPath).data.isActive == false
        );
    }

    function accessBlockExpired(data) {
      return explicitAccessBlockExpired(data)
        || maxAccessBlockExpired(data);
    }

    function explicitAccessBlockExpired(data) {
      return (
        ('blockedUntil' in data)
        && data.blockedUntil is timestamp
        && data.blockedUntil <= request.time
      ) || (
        ('disabledUntil' in data)
        && data.disabledUntil is timestamp
        && data.disabledUntil <= request.time
      ) || (
        ('deactivatedUntil' in data)
        && data.deactivatedUntil is timestamp
        && data.deactivatedUntil <= request.time
      ) || (
        ('maintenanceUntil' in data)
        && data.maintenanceUntil is timestamp
        && data.maintenanceUntil <= request.time
      ) || (
        ('maintenanceEndsAt' in data)
        && data.maintenanceEndsAt is timestamp
        && data.maintenanceEndsAt <= request.time
      ) || (
        ('unlockAt' in data)
        && data.unlockAt is timestamp
        && data.unlockAt <= request.time
      ) || (
        ('reactivateAt' in data)
        && data.reactivateAt is timestamp
        && data.reactivateAt <= request.time
      ) || (
        ('reactivationAt' in data)
        && data.reactivationAt is timestamp
        && data.reactivationAt <= request.time
      ) || (
        ('expiresAt' in data)
        && data.expiresAt is timestamp
        && data.expiresAt <= request.time
      ) || (
        ('endsAt' in data)
        && data.endsAt is timestamp
        && data.endsAt <= request.time
      );
    }

    function maxAccessBlockExpired(data) {
      return accessStartExpired(data, 'deactivatedAt')
        || accessStartExpired(data, 'disabledAt')
        || accessStartExpired(data, 'blockedAt')
        || accessStartExpired(data, 'maintenanceStartedAt')
        || accessStartExpired(data, 'startedAt')
        || accessStartExpired(data, 'updatedAt')
        || accessStartExpired(data, 'createdAt');
    }

    function accessStartExpired(data, field) {
      return field in data
        && data[field] is timestamp
        && data[field] + duration.value(5, 'h') <= request.time;
    }

    function canAccessCongregationData(congregationId) {
      return sameCongregation(congregationId)
        && !congregationAccessBlocked(congregationId)
        && !systemMaintenanceBlocked();
    }

    function storedDocInMyCongregation() {
      return resource.data.congregationId is string
        && canAccessCongregationData(resource.data.congregationId);
    }

    function targetDocInMyCongregation() {
      return request.resource.data.congregationId is string
        && canAccessCongregationData(request.resource.data.congregationId);
    }

    // =========================================================================
    // USERS
    // =========================================================================

    function allowedUserKeys() {
      return [
        'uid',
        'email',
        'firstName',
        'middleName',
        'lastName',
        'secondLastName',
        'displayName',
        'phone',
        'gender',
        'photoURL',
        'role',
        'isActive',
        // 'status' es gestionado exclusivamente por Cloud Functions (createUserByAdmin / updateUserByAdmin).
        // Se incluye aqui para que validUserData no rechace documentos que ya lo contienen
        // cuando el cliente realiza actualizaciones parciales.
        'status',
        'congregationId',
        'congregationDomain',
        // Campos de asignacion de servicio - escritura por Cloud Functions.
        'servicePosition',
        'serviceDepartment',
        'serviceAssignments',
        'department',
        'privileges',
        'responsibilities',
        'permissions',
        'isElder',
        'isMinisterialServant',
        'createdAt',
        'updatedAt',
        // Campos de notificaciones push - escritura controlada por validPushTokenUpdate()
        'notificationTokens',
        'pushTokenUpdatedAt',
        // Campos de preferencias de notificacion
        'notificationsEnabled',
        'platformNotifications',
        'cleaningNotifications',
        'hospitalityNotifications',
        // Campos de modulo de limpieza
        'cleaningEligible',
        'cleaningGroupId',
        'cleaningGroupName',
        'createdBy',
        'createdByName',
        'createdByEmail',
        'updatedBy',
        'updatedByName',
        'updatedByEmail'
      ];
    }

    function requiredUserKeys() {
      return [
        'email',
        'firstName',
        'lastName',
        'role',
        'isActive',
        'congregationId'
      ];
    }

    function validUserData(data, userId) {
      return hasOnlyKeys(data, allowedUserKeys())
        && hasAllKeys(data, requiredUserKeys())
        && isNonEmptyString(data.email)
        && isNonEmptyString(data.firstName)
        && isNonEmptyString(data.lastName)
        && isValidRole(data.role)
        && data.isActive is bool
        && isNonEmptyString(data.congregationId)
        && (
          !('uid' in data)
          || (data.uid is string && data.uid == userId)
        )
        && (
          !('displayName' in data)
          || data.displayName is string
        )
        && (
          !('phone' in data)
          || data.phone is string
        )
        && (
          !('gender' in data)
          || data.gender in ['masculino', 'femenino']
        )
        && (
          !('photoURL' in data)
          || data.photoURL is string
        )
        && (
          !('notificationTokens' in data)
          || data.notificationTokens is list
        )
        && (
          !('pushTokenUpdatedAt' in data)
          || data.pushTokenUpdatedAt is timestamp
        )
        && (
          !('cleaningEligible' in data)
          || data.cleaningEligible is bool
        )
        && (
          !('cleaningGroupId' in data)
          || data.cleaningGroupId == null
          || data.cleaningGroupId is string
        )
        && (
          !('cleaningGroupName' in data)
          || data.cleaningGroupName == null
          || data.cleaningGroupName is string
        )
        && (
          !('privileges' in data)
          || validUserPrivileges(data.privileges)
        )
        && (
          !('responsibilities' in data)
          || validUserResponsibilities(data.responsibilities)
        )
        && (
          !('permissions' in data)
          || validUserPermissions(data.permissions)
        )
        && (
          !('serviceAssignments' in data)
          || validUserServiceAssignments(data.serviceAssignments)
        )
        && (
          !('isElder' in data)
          || data.isElder is bool
        )
        && (
          !('isMinisterialServant' in data)
          || data.isMinisterialServant is bool
        )
        && (
          !('createdBy' in data)
          || data.createdBy is string
        )
        && (
          !('createdByName' in data)
          || data.createdByName is string
        )
        && (
          !('createdByEmail' in data)
          || data.createdByEmail is string
        )
        && (
          !('updatedBy' in data)
          || data.updatedBy is string
        )
        && (
          !('updatedByName' in data)
          || data.updatedByName is string
        )
        && (
          !('updatedByEmail' in data)
          || data.updatedByEmail is string
        );
    }

    function isSystemPrincipalUserData(data) {
      return (
          ('protectedFromDeletion' in data && data.protectedFromDeletion == true)
          || ('isSystemUser' in data && data.isSystemUser == true)
          || ('isPrimaryAdmin' in data && data.isPrimaryAdmin == true)
          || ('isRootAdmin' in data && data.isRootAdmin == true)
          || ('systemProtected' in data && data.systemProtected == true)
        )
        || (
          ('createdBy' in data)
          && data.createdBy in [
            'system',
            'sistema',
            'System',
            'Sistema',
            'Sistema Sistema',
            'tu_correo@gmail.com'
          ]
        )
        || (
          ('createdByName' in data)
          && data.createdByName in [
            'system',
            'sistema',
            'System',
            'Sistema',
            'Sistema Sistema',
            'tu_correo@gmail.com'
          ]
        )
        || (
          ('createdByEmail' in data)
          && data.createdByEmail in [
            'system',
            'sistema',
            'System',
            'Sistema',
            'Sistema Sistema',
            'tu_correo@gmail.com'
          ]
        );
    }

    function validUserServiceAssignments(assignments) {
      return assignments is list
        && assignments.size() <= 20;
    }

    function validUserPrivileges(privileges) {
      return privileges is map
        && privileges.keys().hasOnly([
          'isElder',
          'isMinisterialServant',
          'isRegularPioneer',
          'isAuxiliaryPioneer'
        ])
        && (!('isElder' in privileges) || privileges.isElder is bool)
        && (!('isMinisterialServant' in privileges) || privileges.isMinisterialServant is bool)
        && (!('isRegularPioneer' in privileges) || privileges.isRegularPioneer is bool)
        && (!('isAuxiliaryPioneer' in privileges) || privileges.isAuxiliaryPioneer is bool)
        && !(privileges.isElder == true && privileges.isMinisterialServant == true)
        && !(privileges.isRegularPioneer == true && privileges.isAuxiliaryPioneer == true);
    }

    function validUserResponsibilities(responsibilities) {
      return responsibilities is map
        && responsibilities.keys().hasOnly(['isPreachingManager'])
        && (!('isPreachingManager' in responsibilities) || responsibilities.isPreachingManager is bool);
    }

    function validPermissionActions(actions) {
      return actions is map
        && actions.keys().hasOnly(['view', 'create', 'edit', 'delete', 'manage', 'approve', 'export', 'territories', 'manageTerritories'])
        && (!('view' in actions) || actions.view is bool)
        && (!('create' in actions) || actions.create is bool)
        && (!('edit' in actions) || actions.edit is bool)
        && (!('delete' in actions) || actions.delete is bool)
        && (!('manage' in actions) || actions.manage is bool)
        && (!('approve' in actions) || actions.approve is bool)
        && (!('export' in actions) || actions.export is bool)
        && (!('manageTerritories' in actions) || actions.manageTerritories is bool)
        && (!('territories' in actions) || validTerritoryPermissions(actions.territories));
    }

    function validTerritoryPermissions(territories) {
      return territories is map
        && territories.keys().hasOnly(['view', 'create', 'edit', 'delete', 'assign', 'manage'])
        && (!('view' in territories) || territories.view is bool)
        && (!('create' in territories) || territories.create is bool)
        && (!('edit' in territories) || territories.edit is bool)
        && (!('delete' in territories) || territories.delete is bool)
        && (!('assign' in territories) || territories.assign is bool)
        && (!('manage' in territories) || territories.manage is bool);
    }

    function validUserPermissions(permissions) {
      return permissions is map
        && permissions.keys().hasOnly([
          'usuarios',
          'reuniones',
          'limpieza',
          'departments',
          'predicacion',
          'tesoreria',
          'pagos',
          'configuracion',
          'avisos',
          'asignaciones',
          'organigrama'
        ])
        && (!('usuarios' in permissions) || validPermissionActions(permissions.usuarios))
        && (!('reuniones' in permissions) || validPermissionActions(permissions.reuniones))
        && (!('limpieza' in permissions) || validPermissionActions(permissions.limpieza))
        && (!('departments' in permissions) || validPermissionActions(permissions.departments))
        && (!('predicacion' in permissions) || validPermissionActions(permissions.predicacion))
        && (!('tesoreria' in permissions) || validPermissionActions(permissions.tesoreria))
        && (!('pagos' in permissions) || validPermissionActions(permissions.pagos))
        && (!('configuracion' in permissions) || validPermissionActions(permissions.configuracion))
        && (!('avisos' in permissions) || validPermissionActions(permissions.avisos))
        && (!('asignaciones' in permissions) || validPermissionActions(permissions.asignaciones))
        && (!('organigrama' in permissions) || validPermissionActions(permissions.organigrama));
    }

    function validUserCreate(userId) {
      return validUserData(request.resource.data, userId);
    }

    function validUserUpdateByAdmin(userId) {
      return validUserData(request.resource.data, userId)
        && preservesCreatedAt();
    }

    function validSelfUserUpdate(userId) {
      return isSameUser(userId)
        && validUserData(request.resource.data, userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.congregationId == resource.data.congregationId
        && preservesCreatedAt()
        && sameKeysOnUpdate([
          'firstName',
          'lastName',
          'displayName',
          'phone',
          'photoURL',
          'updatedAt'
        ]);
    }

    // Permite al propio usuario actualizar SOLO su token de notificacion push.
    // El cliente llama setDoc(..., { uid, notificationTokens: arrayUnion(token),
    //   pushTokenUpdatedAt: serverTimestamp(), updatedAt: serverTimestamp() }, { merge: true }).
    // Esta condicion es independiente de validSelfUserUpdate para no interferir
    // con las validaciones de perfil.
    function validPushTokenUpdate(userId) {
      return isSameUser(userId)
        && isActive()
        && sameKeysOnUpdate(['notificationTokens', 'pushTokenUpdatedAt', 'updatedAt', 'uid']);
    }

    function isValidEventType(type) {
      return type in [
        'conmemoracion',
        'asamblea_circuito',
        'asamblea_regional',
        'visita_superintendente',
        'reunion_especial',
        'capacitacion',
        'reunion_anual_precursores',
        'reunion_precursores_visita_superintendente',
        'reunion_ancianos_siervos_ministeriales'
      ];
    }

    function validEventData(data) {
      return hasOnlyKeys(data, [
          'congregationId',
          'type',
          'title',
          'superintendentName',
          'superintendentWifeName',
          'startDate',
          'endDate',
          'deleteAt',
          'location',
          'color',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == myCongregationId()
        && isValidEventType(data.type)
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.deleteAt is timestamp
        && data.color is string
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          !('updatedBy' in data)
          || data.updatedBy is string
        )
        && (
          !('location' in data)
          || data.location is string
        )
        && (
          !('superintendentWifeName' in data)
          || data.superintendentWifeName is string
        )
        && (
          data.type == 'visita_superintendente'
          ? (
            isNonEmptyString(data.superintendentName)
            && !('title' in data)
          )
          : (
            isNonEmptyString(data.title)
            && !('superintendentName' in data)
            && !('superintendentWifeName' in data)
          )
        );
    }

    function validEventCreate() {
      return canManageEvents()
        && validEventData(request.resource.data)
        && request.resource.data.createdBy == currentUid();
    }

    function validEventUpdate() {
      return canManageEvents()
        && resource.data.congregationId == myCongregationId()
        && validEventData(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validExpoPushTokenDoc(userId) {
      return isSameUser(userId)
        && isActive()
        && hasOnlyKeys(request.resource.data, [
          'token',
          'userId',
          'congregationId',
          'platform',
          'deviceName',
          'isActive',
          'updatedAt'
        ])
        && isNonEmptyString(request.resource.data.token)
        && request.resource.data.userId == userId
        && request.resource.data.congregationId == currentUserData().congregationId
        && request.resource.data.platform in ['ios', 'android']
        && (
          request.resource.data.deviceName == null
          || request.resource.data.deviceName is string
        )
        && request.resource.data.isActive is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function validViewedAnnouncementData(announcementId) {
      return hasOnlyKeys(request.resource.data, [
          'announcementId',
          'viewedAt'
        ])
        && request.resource.data.announcementId == announcementId
        && request.resource.data.viewedAt is timestamp;
    }

    function validCleaningMembershipUserUpdate() {
      return isCleaningManager()
        && storedDocInMyCongregation()
        && targetDocInMyCongregation()
        && preservesCreatedAt()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.congregationId == resource.data.congregationId
        && (
          !('cleaningGroupId' in request.resource.data)
          || request.resource.data.cleaningGroupId == null
          || request.resource.data.cleaningGroupId is string
        )
        && (
          !('cleaningGroupName' in request.resource.data)
          || request.resource.data.cleaningGroupName == null
          || request.resource.data.cleaningGroupName is string
        )
        && sameKeysOnUpdate([
          'cleaningGroupId',
          'cleaningGroupName',
          'updatedAt'
        ]);
    }

    function validOrganizationServiceAssignmentSync() {
      return canManageDepartments(request.resource.data.congregationId)
        && storedDocInMyCongregation()
        && targetDocInMyCongregation()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.congregationId == resource.data.congregationId
        && preservesCreatedAt()
        && sameKeysOnUpdate([
          'serviceAssignments',
          'servicePosition',
          'serviceDepartment',
          'department',
          'updatedAt'
        ]);
    }

    // =========================================================================
    // CONGREGATIONS
    // =========================================================================

    function allowedCongregationKeys() {
      return [
        'name',
        'code',
        'country',
        'state',
        'city',
        'language',
        'timezone',
        'isActive',
        'createdAt',
        'updatedAt'
      ];
    }

    function validCongregationData(data) {
      return hasOnlyKeys(data, allowedCongregationKeys())
        && hasAllKeys(data, ['name', 'isActive'])
        && isNonEmptyString(data.name)
        && data.isActive is bool
        && (!('code' in data) || data.code is string)
        && (!('country' in data) || data.country is string)
        && (!('state' in data) || data.state is string)
        && (!('city' in data) || data.city is string)
        && (!('language' in data) || data.language is string)
        && (!('timezone' in data) || data.timezone is string);
    }

    // =========================================================================
    // PERSONS
    // =========================================================================

    function allowedPersonKeys() {
      return [
        'congregationId',
        'firstName',
        'lastName',
        'displayName',
        'gender',
        'phone',
        'email',
        'isBaptized',
        'isPublisher',
        'isActive',
        'notes',
        'createdAt',
        'updatedAt'
      ];
    }

    function validPersonData(data, congregationId) {
      return hasOnlyKeys(data, allowedPersonKeys())
        && hasAllKeys(data, ['congregationId', 'firstName', 'lastName', 'isActive'])
        && data.congregationId == congregationId
        && isNonEmptyString(data.firstName)
        && isNonEmptyString(data.lastName)
        && data.isActive is bool
        && (!('displayName' in data) || data.displayName is string)
        && (!('gender' in data) || data.gender is string)
        && (!('phone' in data) || data.phone is string)
        && (!('email' in data) || data.email is string)
        && (!('isBaptized' in data) || data.isBaptized is bool)
        && (!('isPublisher' in data) || data.isPublisher is bool)
        && (!('notes' in data) || data.notes is string);
    }

    // =========================================================================
    // MEETINGS
    // =========================================================================

    function allowedMeetingKeys() {
      return [
        'congregationId',
        'type',
        'meetingCategory',
        'title',
        'description',
        'date',
        'status',
        'publicationStatus',
        'weekLabel',
        'bibleReading',
        'startDate',
        'endDate',
        'meetingDate',
        'publishedAt',
        'location',
        'meetingUrl',
        'zoomMeetingId',
        'zoomPasscode',
        'organizerUid',
        'organizerName',
        'attendees',
        'attendeeNames',
        'assignedUserIds',
        'cleaningAssignmentMode',
        'cleaningGroupIds',
        'cleaningGroupNames',
        'searchableText',
        'notes',
        'openingSong',
        'openingPrayer',
        'middleSong',
        'closingSong',
        'closingPrayer',
        'chairman',
        'sections',
        'midweekSections',
        'createdBy',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ];
    }

    function validMeetingType(value) {
      return value is string
        && value in ['midweek', 'weekend', 'internal', 'external', 'review', 'training', 'cleaning', 'hospitality'];
    }

    function validMeetingData(data, congregationId) {
      return hasOnlyKeys(data, allowedMeetingKeys())
        && hasAllKeys(data, ['type', 'title', 'startDate', 'endDate', 'meetingDate', 'status'])
        && (!('congregationId' in data) || data.congregationId == congregationId)
        && validMeetingType(data.type)
        && isNonEmptyString(data.title)
        && data.startDate is timestamp
        && data.endDate is timestamp
        && data.meetingDate is timestamp
        && data.startDate <= data.endDate
        && data.status in ['pending', 'scheduled', 'in_progress', 'completed', 'cancelled']
        && (!('meetingCategory' in data) || data.meetingCategory in ['general', 'midweek', 'weekend'])
        && (!('publicationStatus' in data) || data.publicationStatus in ['draft', 'published'])
        && (!('publishedAt' in data) || data.publishedAt is timestamp)
        && (!('date' in data) || data.date is string)
        && (!('description' in data) || data.description is string)
        && (!('weekLabel' in data) || data.weekLabel is string)
        && (!('bibleReading' in data) || data.bibleReading is string)
        && (!('location' in data) || data.location is string)
        && (!('meetingUrl' in data) || data.meetingUrl is string)
        && (!('zoomMeetingId' in data) || data.zoomMeetingId is string)
        && (!('zoomPasscode' in data) || data.zoomPasscode is string)
        && (!('organizerUid' in data) || data.organizerUid is string)
        && (!('organizerName' in data) || data.organizerName is string)
        && (!('attendees' in data) || data.attendees is list)
        && (!('attendeeNames' in data) || data.attendeeNames is list)
        && (!('assignedUserIds' in data) || data.assignedUserIds is list)
        && (!('cleaningAssignmentMode' in data) || data.cleaningAssignmentMode in ['none', 'selected', 'all'])
        && (!('cleaningGroupIds' in data) || data.cleaningGroupIds is list)
        && (!('cleaningGroupNames' in data) || data.cleaningGroupNames is list)
        && (!('searchableText' in data) || data.searchableText is string)
        && (!('notes' in data) || data.notes is string)
        && (!('openingSong' in data) || data.openingSong is string)
        && (!('openingPrayer' in data) || data.openingPrayer is string)
        && (!('middleSong' in data) || data.middleSong is string)
        && (!('closingSong' in data) || data.closingSong is string)
        && (!('closingPrayer' in data) || data.closingPrayer is string)
        && (!('chairman' in data) || data.chairman is string)
        && (!('sections' in data) || data.sections is list)
        && (!('midweekSections' in data) || data.midweekSections is list)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // =========================================================================
    // ASSIGNMENTS
    // =========================================================================

    function allowedAssignmentKeys() {
      return [
        'congregationId',
        'meetingId',
        'category',
        'type',
        'section',
        'title',
        'description',
        'priority',
        'assignedToUid',
        'assignedByUid',
        'assignedByName',
        'createdBy',
        'updatedBy',
        'cleaningGroupId',
        'cleaningGroupName',
        'assignedUsers',
        'date',
        'dueDate',
        'assignedToUserId',
        'assignedToPersonId',
        'assignedToName',
        'assistantUserId',
        'assistantPersonId',
        'assistantName',
        'startTime',
        'endTime',
        'durationMinutes',
        'status',
        'notes',
        'createdAt',
        'updatedAt'
      ];
    }

    function validStandaloneAssignmentData(data, congregationId) {
      return hasOnlyKeys(data, allowedAssignmentKeys())
        && hasAllKeys(data, ['congregationId', 'category', 'type', 'title'])
        && data.congregationId == congregationId
        && isNonEmptyString(data.category)
        && isNonEmptyString(data.type)
        && isNonEmptyString(data.title)
        && (!('meetingId' in data) || data.meetingId is string)
        && (!('section' in data) || data.section is string)
        && (!('description' in data) || data.description is string)
        && (!('priority' in data) || data.priority is string)
        && (!('assignedToUid' in data) || data.assignedToUid is string)
        && (!('assignedByUid' in data) || data.assignedByUid is string)
        && (!('assignedByName' in data) || data.assignedByName is string)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('cleaningGroupId' in data) || data.cleaningGroupId is string)
        && (!('cleaningGroupName' in data) || data.cleaningGroupName is string)
        && (!('assignedUsers' in data) || data.assignedUsers is list)
        && (!('assignedToUserId' in data) || data.assignedToUserId is string)
        && (!('assignedToPersonId' in data) || data.assignedToPersonId is string)
        && (!('assignedToName' in data) || data.assignedToName is string)
        && (!('assistantUserId' in data) || data.assistantUserId is string)
        && (!('assistantPersonId' in data) || data.assistantPersonId is string)
        && (!('assistantName' in data) || data.assistantName is string)
        && (!('startTime' in data) || data.startTime is string)
        && (!('endTime' in data) || data.endTime is string)
        && (!('durationMinutes' in data) || data.durationMinutes is int)
        && (!('status' in data) || data.status is string)
        && (!('notes' in data) || data.notes is string);
    }

    function isValidTerritoryDay(day) {
      return day in [
        'monday',
        'tuesday',
        'wednesday',
        'thursday',
        'friday',
        'saturday',
        'sunday'
      ];
    }

    function validTerritoryData(data, congregationId) {
      return hasOnlyKeys(data, [
          'id',
          'congregationId',
          'number',
          'description',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'number',
          'description',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && (!('id' in data) || data.id is string)
        && data.number is int
        && data.number > 0
        && isNonEmptyString(data.description)
        && data.description.size() <= 100
        && data.status in ['active', 'inactive']
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTerritoryCreate(data, congregationId) {
      return validTerritoryData(data, congregationId)
        && data.status == 'active'
        && data.createdBy == currentUid()
        && data.updatedBy == currentUid();
    }

    function validPreachingGroupData(data, congregationId) {
      return hasOnlyKeys(data, [
          'id',
          'congregationId',
          'name',
          'number',
          'captainUserId',
          'captainName',
          'assistantUserId',
          'assistantName',
          'memberIds',
          'memberNames',
          'memberCount',
          'isActive',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'name',
          'number',
          'captainUserId',
          'captainName',
          'memberIds',
          'memberNames',
          'memberCount',
          'isActive',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && (!('id' in data) || data.id is string)
        && isNonEmptyString(data.name)
        && data.name.size() <= 40
        && data.number is int
        && data.number > 0
        && isNonEmptyString(data.captainUserId)
        && isNonEmptyString(data.captainName)
        && (!('assistantUserId' in data) || data.assistantUserId == null || data.assistantUserId is string)
        && (!('assistantName' in data) || data.assistantName == null || data.assistantName is string)
        && data.memberIds is list
        && data.memberIds.size() > 0
        && data.memberIds.size() <= 200
        && data.memberIds.hasAny([data.captainUserId])
        && (!('assistantUserId' in data) || data.assistantUserId == null || data.memberIds.hasAny([data.assistantUserId]))
        && data.memberNames is list
        && data.memberNames.size() == data.memberIds.size()
        && data.memberCount is int
        && data.memberCount == data.memberIds.size()
        && data.isActive is bool
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPreachingGroupCreate(data, congregationId) {
      return validPreachingGroupData(data, congregationId)
        && data.isActive == true
        && data.createdBy == currentUid()
        && data.updatedBy == currentUid();
    }

    function validPreachingGroupUpdate(data, congregationId) {
      return validPreachingGroupData(data, congregationId)
        && data.congregationId == resource.data.congregationId
        && data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedBy == currentUid();
    }

    function validMonthlyTerritoryTarget(target) {
      return target is map
        && target.keys().hasOnly(['id', 'scope', 'groupId', 'groupName', 'territoryIds', 'territoryNumbers', 'notes'])
        && isNonEmptyString(target.id)
        && target.scope in ['congregation', 'group']
        && (!('groupId' in target) || target.groupId == null || target.groupId is string)
        && (!('groupName' in target) || target.groupName == null || target.groupName is string)
        && target.territoryIds is list
        && target.territoryIds.size() <= 200
        && target.territoryNumbers is list
        && target.territoryNumbers.size() == target.territoryIds.size()
        && (!('notes' in target) || target.notes == null || (target.notes is string && target.notes.size() <= 200));
    }

    function validMonthlyTerritoryTargets(targets) {
      return targets is list
        && targets.size() <= 10
        && (targets.size() < 1 || validMonthlyTerritoryTarget(targets[0]))
        && (targets.size() < 2 || validMonthlyTerritoryTarget(targets[1]))
        && (targets.size() < 3 || validMonthlyTerritoryTarget(targets[2]))
        && (targets.size() < 4 || validMonthlyTerritoryTarget(targets[3]))
        && (targets.size() < 5 || validMonthlyTerritoryTarget(targets[4]))
        && (targets.size() < 6 || validMonthlyTerritoryTarget(targets[5]))
        && (targets.size() < 7 || validMonthlyTerritoryTarget(targets[6]))
        && (targets.size() < 8 || validMonthlyTerritoryTarget(targets[7]))
        && (targets.size() < 9 || validMonthlyTerritoryTarget(targets[8]))
        && (targets.size() < 10 || validMonthlyTerritoryTarget(targets[9]));
    }

    function validMonthlyTerritoryAssignmentData(data, congregationId, monthId) {
      return hasOnlyKeys(data, [
          'id',
          'congregationId',
          'monthId',
          'assignments',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'monthId',
          'assignments',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && (!('id' in data) || data.id == monthId)
        && data.congregationId == congregationId
        && data.monthId == monthId
        && monthId.matches('^\\d{4}-\\d{2}$')
        && validMonthlyTerritoryTargets(data.assignments)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMonthlyTerritoryAssignmentCreate(data, congregationId, monthId) {
      return validMonthlyTerritoryAssignmentData(data, congregationId, monthId)
        && data.createdBy == currentUid()
        && data.updatedBy == currentUid();
    }

    function validMonthlyTerritoryAssignmentUpdate(data, congregationId, monthId) {
      return validMonthlyTerritoryAssignmentData(data, congregationId, monthId)
        && data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedBy == currentUid();
    }

    function validTerritoryUpdate(data, congregationId) {
      return validTerritoryData(data, congregationId)
        && data.congregationId == resource.data.congregationId
        && data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedBy == currentUid();
    }

    function validTerritoryScheduleItem(item) {
      return item is map
        && item.keys().hasOnly(['number', 'description', 'enabled'])
        && item.number is number
        && item.number > 0
        && item.description is string
        && item.description.size() > 0
        && item.description.size() <= 100
        && item.enabled is bool;
    }

    function validTerritoryScheduleItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 12
        && (items.size() < 1 || validTerritoryScheduleItem(items[0]))
        && (items.size() < 2 || validTerritoryScheduleItem(items[1]))
        && (items.size() < 3 || validTerritoryScheduleItem(items[2]))
        && (items.size() < 4 || validTerritoryScheduleItem(items[3]))
        && (items.size() < 5 || validTerritoryScheduleItem(items[4]))
        && (items.size() < 6 || validTerritoryScheduleItem(items[5]))
        && (items.size() < 7 || validTerritoryScheduleItem(items[6]))
        && (items.size() < 8 || validTerritoryScheduleItem(items[7]))
        && (items.size() < 9 || validTerritoryScheduleItem(items[8]))
        && (items.size() < 10 || validTerritoryScheduleItem(items[9]))
        && (items.size() < 11 || validTerritoryScheduleItem(items[10]))
        && (items.size() < 12 || validTerritoryScheduleItem(items[11]));
    }

    function validTerritoryScheduleData(data, scheduleId) {
      return hasOnlyKeys(data, [
          'dayOfWeek',
          'territories',
          'active',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'dayOfWeek',
          'territories',
          'active',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.dayOfWeek == scheduleId
        && isValidTerritoryDay(data.dayOfWeek)
        && validTerritoryScheduleItems(data.territories)
        && data.active is bool
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTerritoryScheduleCreate(data, scheduleId) {
      return validTerritoryScheduleData(data, scheduleId)
        && data.createdBy == currentUid()
        && data.updatedBy == currentUid();
    }

    function validTerritoryScheduleUpdate(data, scheduleId) {
      return validTerritoryScheduleData(data, scheduleId)
        && data.dayOfWeek == resource.data.dayOfWeek
        && data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedBy == currentUid();
    }

    function validDepartmentData(data) {
      return hasOnlyKeys(data, [
          'id',
          'congregationId',
          'name',
          'description',
          'icon',
          'color',
          'order',
          'isActive',
          'allowMultipleManagers',
          'allowMultipleAssistants',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'name',
          'order',
          'isActive',
          'allowMultipleManagers',
          'allowMultipleAssistants'
        ])
        && data.congregationId is string
        && isNonEmptyString(data.name)
        && data.name.size() <= 80
        && (!('id' in data) || data.id is string)
        && (!('description' in data) || data.description is string)
        && (!('icon' in data) || data.icon is string)
        && (!('color' in data) || data.color is string)
        && data.order is number
        && data.isActive is bool
        && data.allowMultipleManagers is bool
        && data.allowMultipleAssistants is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('updatedBy' in data) || data.updatedBy is string);
    }

    function validDepartmentCreate(data) {
      return validDepartmentData(data)
        && data.isActive == true;
    }

    function validDepartmentUpdate(data) {
      return validDepartmentData(data)
        && preservesCreatedAt();
    }

    function validOrganizationPosition(position) {
      return position in ['coordinador', 'secretario', 'encargado', 'auxiliar', 'apoyo'];
    }

    function validDepartmentAssignmentData(data) {
      return hasOnlyKeys(data, [
          'id',
          'congregationId',
          'departmentId',
          'departmentName',
          'userId',
          'displayName',
          'email',
          'position',
          'title',
          'parentAssignmentId',
          'level',
          'order',
          'isActive',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'departmentId',
          'departmentName',
          'userId',
          'displayName',
          'position',
          'title',
          'level',
          'order',
          'isActive'
        ])
        && data.congregationId is string
        && isNonEmptyString(data.departmentId)
        && isNonEmptyString(data.departmentName)
        && isNonEmptyString(data.userId)
        && isNonEmptyString(data.displayName)
        && validOrganizationPosition(data.position)
        && isNonEmptyString(data.title)
        && (!('id' in data) || data.id is string)
        && (!('email' in data) || data.email is string)
        && (!('parentAssignmentId' in data) || data.parentAssignmentId == null || data.parentAssignmentId is string)
        && data.level is number
        && data.order is number
        && data.isActive is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('createdBy' in data) || data.createdBy is string)
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (data.position != 'coordinador' || data.departmentId == 'coordinacion')
        && (data.position != 'secretario' || data.departmentId == 'secretaria');
    }

    function validDepartmentAssignmentCreate(data) {
      return validDepartmentAssignmentData(data)
        && data.isActive == true
        && exists(/databases/$(database)/documents/users/$(data.userId))
        && get(/databases/$(database)/documents/users/$(data.userId)).data.congregationId == data.congregationId
        && get(/databases/$(database)/documents/users/$(data.userId)).data.isActive == true
        && exists(/databases/$(database)/documents/congregations/$(data.congregationId)/departments/$(data.departmentId));
    }

    function validDepartmentAssignmentUpdate(data) {
      return validDepartmentAssignmentData(data)
        && data.departmentId == resource.data.departmentId
        && data.userId == resource.data.userId
        && preservesCreatedAt()
        && exists(/databases/$(database)/documents/users/$(data.userId))
        && get(/databases/$(database)/documents/users/$(data.userId)).data.congregationId == data.congregationId
        && (
          data.isActive == false
          || get(/databases/$(database)/documents/users/$(data.userId)).data.isActive == true
        );
    }

    // =========================================================================
    // CLEANING GROUPS
    // =========================================================================

    function allowedCleaningGroupKeys() {
      return [
        'name',
        'description',
        'congregationId',
        'groupType',
        'memberIds',
        'memberCount',
        'isActive',
        'createdBy',
        'createdAt',
        'updatedAt'
      ];
    }

    function validCleaningGroupData(data, congregationId) {
      return hasOnlyKeys(data, allowedCleaningGroupKeys())
        && hasAllKeys(data, [
          'name',
          'congregationId',
          'groupType',
          'memberIds',
          'memberCount',
          'isActive',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && isNonEmptyString(data.name)
        && data.name.size() <= 80
        && data.groupType in ['standard', 'family']
        && data.memberIds is list
        && data.memberIds.size() <= 200
        && data.memberCount is int
        && data.memberCount >= 0
        && data.memberCount <= 200
        && data.memberCount == data.memberIds.size()
        && data.isActive is bool
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('description' in data) || (data.description is string && data.description.size() <= 300));
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================

    function allowedNotificationKeys() {
      return [
        'congregationId',
        'userId',
        'title',
        'body',
        'type',
        'isRead',
        'relatedId',
        'createdAt',
        'readAt'
      ];
    }

    function validNotificationData(data, congregationId) {
      return hasOnlyKeys(data, allowedNotificationKeys())
        && hasAllKeys(data, ['congregationId', 'title', 'body', 'type', 'isRead'])
        && data.congregationId == congregationId
        && isNonEmptyString(data.title)
        && isNonEmptyString(data.body)
        && isNonEmptyString(data.type)
        && data.isRead is bool
        && (!('userId' in data) || data.userId is string)
        && (!('relatedId' in data) || data.relatedId is string);
    }

    function validOutgoingTalkStatus(status) {
      return status is string && status in ['scheduled', 'cancelled', 'completed'];
    }

    function validDateKey(value) {
      return value is string
        && value.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validTimeKey(value) {
      return value is string
        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validOutgoingTalkData(data, congregationId) {
      return hasOnlyKeys(data, [
          'congregationId',
          'speakerUserId',
          'speakerName',
          'destinationCongregationName',
          'talkDate',
          'talkTime',
          'weekStartDate',
          'weekEndDate',
          'status',
          'notes',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'speakerUserId',
          'speakerName',
          'destinationCongregationName',
          'talkDate',
          'talkTime',
          'weekStartDate',
          'weekEndDate',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && isNonEmptyString(data.speakerUserId)
        && isNonEmptyString(data.speakerName)
        && isNonEmptyString(data.destinationCongregationName)
        && validDateKey(data.talkDate)
        && validTimeKey(data.talkTime)
        && validDateKey(data.weekStartDate)
        && validDateKey(data.weekEndDate)
        && data.weekStartDate <= data.talkDate
        && data.talkDate <= data.weekEndDate
        && validOutgoingTalkStatus(data.status)
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('updatedBy' in data) || data.updatedBy is string)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function validPlanningMonthIds(value) {
      return value is list
        && value.size() > 0
        && value.size() <= 2;
    }

    function validScheduleStatus(value) {
      return value is string && value in ['draft', 'published', 'archived'];
    }

    function validScheduleItemStatus(value) {
      return value is string && value in ['scheduled', 'cancelled', 'completed'];
    }

    function validPlanningMeetingType(value) {
      return value is string && value in ['midweek', 'weekend'];
    }

    function validHospitalityRoleKey(value) {
      return value is string
        && value in [
          'microphoneOne',
          'microphoneTwo',
          'attendantDoor',
          'attendantAuditorium',
          'watchtowerReader',
          'midweekBibleStudyReader',
          'audioVideo'
        ];
    }

    function validPlanningScheduleData(data, congregationId) {
      return hasOnlyKeys(data, [
          'congregationId',
          'title',
          'startDate',
          'endDate',
          'monthIds',
          'totalMeetings',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt',
          'publishedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'title',
          'startDate',
          'endDate',
          'monthIds',
          'totalMeetings',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && isNonEmptyString(data.title)
        && data.title.size() <= 120
        && validDateKey(data.startDate)
        && validDateKey(data.endDate)
        && data.startDate <= data.endDate
        && validPlanningMonthIds(data.monthIds)
        && data.totalMeetings is int
        && data.totalMeetings >= 1
        && data.totalMeetings <= 20
        && validScheduleStatus(data.status)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('publishedAt' in data) || data.publishedAt is timestamp);
    }

    function validCleaningScheduleItemData(data, congregationId, scheduleId) {
      return hasOnlyKeys(data, [
          'congregationId',
          'scheduleId',
          'meetingId',
          'meetingDate',
          'meetingType',
          'cleaningGroupId',
          'cleaningGroupName',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'scheduleId',
          'meetingDate',
          'meetingType',
          'cleaningGroupId',
          'cleaningGroupName',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && data.scheduleId == scheduleId
        && validDateKey(data.meetingDate)
        && validPlanningMeetingType(data.meetingType)
        && isNonEmptyString(data.cleaningGroupId)
        && isNonEmptyString(data.cleaningGroupName)
        && data.cleaningGroupName.size() <= 120
        && validScheduleItemStatus(data.status)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('meetingId' in data) || data.meetingId is string);
    }

    function validHospitalityScheduleItemData(data, congregationId, scheduleId) {
      return hasOnlyKeys(data, [
          'congregationId',
          'scheduleId',
          'meetingId',
          'meetingDate',
          'meetingType',
          'roleKey',
          'roleLabel',
          'userId',
          'userNameSnapshot',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && hasAllKeys(data, [
          'congregationId',
          'scheduleId',
          'meetingDate',
          'meetingType',
          'roleKey',
          'roleLabel',
          'userId',
          'userNameSnapshot',
          'status',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.congregationId == congregationId
        && data.scheduleId == scheduleId
        && validDateKey(data.meetingDate)
        && validPlanningMeetingType(data.meetingType)
        && validHospitalityRoleKey(data.roleKey)
        && isNonEmptyString(data.roleLabel)
        && data.roleLabel.size() <= 120
        && isNonEmptyString(data.userId)
        && isNonEmptyString(data.userNameSnapshot)
        && data.userNameSnapshot.size() <= 160
        && validScheduleItemStatus(data.status)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('meetingId' in data) || data.meetingId is string);
    }

    // =========================================================================
    // CHANGE LOGS
    // =========================================================================

    function allowedChangeLogKeys() {
      return [
        'congregationId',
        'actorUserId',
        'actorName',
        'action',
        'entityType',
        'entityId',
        'description',
        'metadata',
        'createdAt'
      ];
    }

    function validChangeLogData(data, congregationId) {
      return hasOnlyKeys(data, allowedChangeLogKeys())
        && hasAllKeys(data, ['congregationId', 'actorUserId', 'action', 'entityType', 'entityId', 'createdAt'])
        && data.congregationId == congregationId
        && data.actorUserId == currentUid()
        && isNonEmptyString(data.action)
        && isNonEmptyString(data.entityType)
        && isNonEmptyString(data.entityId)
        && (!('actorName' in data) || data.actorName is string)
        && (!('description' in data) || data.description is string)
        && (!('metadata' in data) || data.metadata is map);
    }

    function validMonthId(monthId) {
      return monthId is string
        && monthId.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function allowedPreachingReportKeys() {
      return [
        'userId',
        'userName',
        'congregationId',
        'congregationName',
        'monthId',
        'monthName',
        'participated',
        'bibleStudies',
        'returnVisits',
        'comments',
        'isPioneer',
        'pioneerType',
        'hours',
        'submittedAt',
        'updatedAt',
        'submittedBy'
      ];
    }

    function validPreachingReportWrite(data, congregationId, monthId, userId) {
      return hasOnlyKeys(data, allowedPreachingReportKeys())
        && hasAllKeys(data, [
          'userId',
          'userName',
          'congregationId',
          'monthId',
          'monthName',
          'participated',
          'bibleStudies',
          'returnVisits',
          'isPioneer',
          'submittedAt',
          'updatedAt',
          'submittedBy'
        ])
        && validMonthId(monthId)
        && data.userId == userId
        && data.userId == currentUid()
        && data.submittedBy == currentUid()
        && data.congregationId == congregationId
        && data.monthId == monthId
        && data.userName is string
        && data.monthName is string
        && (!('congregationName' in data) || data.congregationName is string)
        && data.participated is bool
        && data.bibleStudies is int
        && data.bibleStudies >= 0
        && data.returnVisits is int
        && data.returnVisits >= 0
        && (
          !('comments' in data)
          || data.comments == null
          || (data.comments is string && data.comments.size() <= 500)
        )
        && data.isPioneer is bool
        && data.isPioneer == isPioneer()
        && (
          !('pioneerType' in data)
          || data.pioneerType == null
          || data.pioneerType in ['regular', 'auxiliary']
        )
        && data.submittedAt is timestamp
        && data.updatedAt is timestamp
        && (
          isPioneer()
          || !('hours' in data)
          || data.hours == null
        )
        && (
          !isPioneer()
          || data.hours is number
          || data.hours == null
        )
        && (
          !isPioneer()
          || data.hours == null
          || data.hours >= 0
        );
    }

    // =========================================================================
    // REGLAS: SYSTEM
    // Solo lectura para usuarios autenticados.
    // Usado por cache-control-service.ts para leer system/cacheControl.
    // Escritura reservada exclusivamente para Cloud Functions / consola admin.
    // =========================================================================

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =========================================================================
    // REGLAS: SYSTEM ANNOUNCEMENTS
    // Avisos globales administrados desde la app administrativa.
    // =========================================================================

    match /systemAnnouncements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // REGLAS: SUPER ADMINS
    // =========================================================================

    match /superAdmins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // REGLAS: USERS
    // =========================================================================

    match /events/{eventId} {
      allow get, list: if isActive()
        && resource.data.congregationId == myCongregationId()
        && canAccessCongregationData(resource.data.congregationId);
      allow create: if validEventCreate();
      allow update: if validEventUpdate();
      allow delete: if canManageEvents()
        && resource.data.congregationId == myCongregationId();
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() 
        || isSameUser(userId)
        || (canReadUsers() && storedDocInMyCongregation());

      allow list: if isSuperAdmin() 
        || (
          canListCongregationUsers()
          && resource.data.congregationId == myCongregationId()
        );

      allow create: if isSuperAdmin() || (canCreateUsers()
        && validUserCreate(userId)
        && targetDocInMyCongregation()
        && safeDelegatedUserCreate());

      allow update: if isSuperAdmin() || (
          canEditUsers()
          && storedDocInMyCongregation()
          && targetDocInMyCongregation()
          && validUserUpdateByAdmin(userId)
          && safeDelegatedUserUpdate()
        ) || (
          validSelfUserUpdate(userId)
        ) || (
          // Registro de token push: el propio usuario actualiza SOLO su token.
          validPushTokenUpdate(userId)
        ) || (
          // Gestion de grupos de limpieza: solo campos de membresia de limpieza.
          validCleaningMembershipUserUpdate()
        ) || (
          // Sincronizacion del organigrama congregacional: solo cargos de servicio.
          validOrganizationServiceAssignmentSync()
        );

      allow delete: if isSuperAdmin() || (
          canDeleteUsers()
          && storedDocInMyCongregation()
          && resource.data.role != 'admin'
          && resource.data.role != 'administrador'
          && !isSystemPrincipalUserData(resource.data)
        );

      match /pushTokens/{tokenDocId} {
        allow get, list: if isSameUser(userId);
        allow create, update: if validExpoPushTokenDoc(userId);
        allow delete: if isSameUser(userId);
      }

      match /viewedAnnouncements/{announcementId} {
        allow get, list: if isSameUser(userId);
        allow create, update: if isSameUser(userId)
          && validViewedAnnouncementData(announcementId);
        allow delete: if false;
      }
    }

    // =========================================================================
    // REGLAS: CONGREGATIONS
    // =========================================================================

    match /congregations/{congregationId} {
      allow get: if isSuperAdmin() || sameCongregation(congregationId);
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() || (isAdmin()
        && canAccessCongregationData(congregationId)
        && validCongregationData(request.resource.data));

      allow update: if isSuperAdmin() || (isAdmin()
        && canAccessCongregationData(congregationId)
        && validCongregationData(request.resource.data)
        && preservesCreatedAt());

      allow delete: if false;

      match /private/{privateDocId} {
        allow get, list: if sameCongregation(congregationId)
          && canAccessCongregationData(congregationId)
          && isAdmin();
        allow write: if false;
      }

      // -----------------------------------------------------------------------
      // PERSONS
      // -----------------------------------------------------------------------
      match /persons/{personId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManagePersons()
          && canAccessCongregationData(congregationId)
          && validPersonData(request.resource.data, congregationId);

        allow update: if canManagePersons()
          && canAccessCongregationData(congregationId)
          && validPersonData(request.resource.data, congregationId)
          && preservesCreatedAt();

        allow delete: if isAdmin();
      }

      // -----------------------------------------------------------------------
      // MEETINGS
      // -----------------------------------------------------------------------
      match /meetings/{meetingId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if isMeetingsManager()
          && canAccessCongregationData(congregationId)
          && validMeetingData(request.resource.data, congregationId);

        allow update: if isMeetingsManager()
          && canAccessCongregationData(congregationId)
          && validMeetingData(request.resource.data, congregationId)
          && preservesCreatedAt();

        allow delete: if isAdmin();

        // ---------------------------------------------------------------------
        // ASSIGNMENTS
        // ---------------------------------------------------------------------
        match /assignments/{assignmentId} {
          allow get, list: if canAccessCongregationData(congregationId);

          allow create, update: if false;

          allow delete: if isAdmin();
        }
      }

      // -----------------------------------------------------------------------
      // ASSIGNMENTS (congregation scoped: limpieza, hospitalidad u otras tareas)
      // -----------------------------------------------------------------------
      match /assignments/{assignmentId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManageAssignments()
          && canAccessCongregationData(congregationId)
          && validStandaloneAssignmentData(request.resource.data, congregationId);

        allow update: if canManageAssignments()
          && canAccessCongregationData(congregationId)
          && validStandaloneAssignmentData(request.resource.data, congregationId)
          && preservesCreatedAt();

        allow delete: if isAdmin();
      }

      // -----------------------------------------------------------------------
      // TERRITORIES
      // -----------------------------------------------------------------------
      match /territories/{territoryId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canCreateTerritories()
          && canAccessCongregationData(congregationId)
          && validTerritoryCreate(request.resource.data, congregationId);

        allow update: if (
            (resource.data.status == 'active' && request.resource.data.status == 'inactive' && canDeactivateTerritories())
            || (
              request.resource.data.status == resource.data.status
              && canEditTerritories()
            )
          )
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId
          && validTerritoryUpdate(request.resource.data, congregationId);

        allow delete: if false;
      }

      match /preachingGroups/{groupId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManagePreachingGroups()
          && canAccessCongregationData(congregationId)
          && validPreachingGroupCreate(request.resource.data, congregationId);

        allow update: if canManagePreachingGroups()
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId
          && validPreachingGroupUpdate(request.resource.data, congregationId);

        allow delete: if false;
      }

      match /monthlyTerritoryAssignments/{monthId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManageTerritorySchedule()
          && canAccessCongregationData(congregationId)
          && validMonthlyTerritoryAssignmentCreate(request.resource.data, congregationId, monthId);

        allow update: if canManageTerritorySchedule()
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId
          && validMonthlyTerritoryAssignmentUpdate(request.resource.data, congregationId, monthId);

        allow delete: if false;
      }

      match /territorySchedule/{scheduleId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManageTerritorySchedule()
          && canAccessCongregationData(congregationId)
          && validTerritoryScheduleCreate(request.resource.data, scheduleId);

        allow update: if canManageTerritorySchedule()
          && canAccessCongregationData(congregationId)
          && validTerritoryScheduleUpdate(request.resource.data, scheduleId);

        allow delete: if canManageTerritorySchedule()
          && canAccessCongregationData(congregationId);
      }

      // -----------------------------------------------------------------------
      // OUTGOING TALKS
      // Escritura directa cerrada: las altas/cambios pasan por Cloud Functions.
      // -----------------------------------------------------------------------
      match /outgoingTalks/{outgoingTalkId} {
        allow get, list: if canAccessCongregationData(congregationId)
          && isOutgoingTalksManager();

        allow create, update: if false
          && canAccessCongregationData(congregationId)
          && isOutgoingTalksManager()
          && validOutgoingTalkData(request.resource.data, congregationId);

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // CLEANING GROUPS
      // -----------------------------------------------------------------------
      match /cleaningGroups/{groupId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if isCleaningManager()
          && canAccessCongregationData(congregationId)
          && validCleaningGroupData(request.resource.data, congregationId);

        allow update: if isCleaningManager()
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId
          && validCleaningGroupData(request.resource.data, congregationId)
          && preservesCreatedAt();

        allow delete: if isAdmin()
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId;
      }

      // Compatibilidad con el nombre legacy usado por versiones anteriores.
      match /cleaning_groups/{groupId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if isCleaningManager()
          && canAccessCongregationData(congregationId)
          && validCleaningGroupData(request.resource.data, congregationId);

        allow update: if isCleaningManager()
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId
          && validCleaningGroupData(request.resource.data, congregationId)
          && preservesCreatedAt();

        allow delete: if isAdmin()
          && canAccessCongregationData(congregationId)
          && resource.data.congregationId == congregationId;
      }

      // -----------------------------------------------------------------------
      // CLEANING SCHEDULES
      // -----------------------------------------------------------------------
      match /cleaningSchedules/{scheduleId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canAccessCongregationData(congregationId)
          && isCleaningManager()
          && validPlanningScheduleData(request.resource.data, congregationId)
          && request.resource.data.createdBy == currentUid()
          && request.resource.data.updatedBy == currentUid();

        allow update: if canAccessCongregationData(congregationId)
          && isCleaningManager()
          && resource.data.congregationId == congregationId
          && validPlanningScheduleData(request.resource.data, congregationId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == currentUid();

        allow delete: if false;

        match /items/{itemId} {
          allow get, list: if canAccessCongregationData(congregationId);

          allow create: if canAccessCongregationData(congregationId)
            && isCleaningManager()
            && validCleaningScheduleItemData(request.resource.data, congregationId, scheduleId)
            && request.resource.data.createdBy == currentUid()
            && request.resource.data.updatedBy == currentUid();

          allow update: if canAccessCongregationData(congregationId)
            && isCleaningManager()
            && resource.data.congregationId == congregationId
            && validCleaningScheduleItemData(request.resource.data, congregationId, scheduleId)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedBy == currentUid();

          allow delete: if false;
        }
      }

      // -----------------------------------------------------------------------
      // HOSPITALITY / MICROPHONES SCHEDULES
      // -----------------------------------------------------------------------
      match /hospitalitySchedules/{scheduleId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canAccessCongregationData(congregationId)
          && isHospitalityMicrophonesManager()
          && validPlanningScheduleData(request.resource.data, congregationId)
          && request.resource.data.createdBy == currentUid()
          && request.resource.data.updatedBy == currentUid();

        allow update: if canAccessCongregationData(congregationId)
          && isHospitalityMicrophonesManager()
          && resource.data.congregationId == congregationId
          && validPlanningScheduleData(request.resource.data, congregationId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == currentUid();

        allow delete: if false;

        match /items/{itemId} {
          allow get, list: if canAccessCongregationData(congregationId);

          allow create: if canAccessCongregationData(congregationId)
            && isHospitalityMicrophonesManager()
            && validHospitalityScheduleItemData(request.resource.data, congregationId, scheduleId)
            && request.resource.data.createdBy == currentUid()
            && request.resource.data.updatedBy == currentUid();

          allow update: if canAccessCongregationData(congregationId)
            && isHospitalityMicrophonesManager()
            && resource.data.congregationId == congregationId
            && validHospitalityScheduleItemData(request.resource.data, congregationId, scheduleId)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedBy == currentUid();

          allow delete: if false;
        }
      }

      // -----------------------------------------------------------------------
      // DEPARTMENTS / ORG CHART
      // -----------------------------------------------------------------------
      match /departments/{departmentId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManageDepartments(congregationId)
          && request.resource.data.congregationId == congregationId
          && validDepartmentCreate(request.resource.data);

        allow update: if canManageDepartments(congregationId)
          && resource.data.congregationId == congregationId
          && request.resource.data.congregationId == congregationId
          && validDepartmentUpdate(request.resource.data);

        allow delete: if false;
      }

      match /departmentAssignments/{assignmentId} {
        allow get, list: if canAccessCongregationData(congregationId);

        allow create: if canManageDepartments(congregationId)
          && request.resource.data.congregationId == congregationId
          && validDepartmentAssignmentCreate(request.resource.data);

        allow update: if canManageDepartments(congregationId)
          && resource.data.congregationId == congregationId
          && request.resource.data.congregationId == congregationId
          && validDepartmentAssignmentUpdate(request.resource.data);

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // NOTIFICATIONS
      // -----------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get: if canAccessCongregationData(congregationId)
          && (
            !('userId' in resource.data)
            || resource.data.userId == currentUid()
            || (
              'userIds' in resource.data
              && resource.data.userIds is list
              && currentUid() in resource.data.userIds
            )
            || isAdminOrSupervisor()
            || isGlobalScreenAccess()
          );

        allow list: if canAccessCongregationData(congregationId)
          && (
            (
              'userId' in resource.data
              && resource.data.userId == currentUid()
            )
            || (
              'userIds' in resource.data
              && resource.data.userIds is list
              && currentUid() in resource.data.userIds
            )
            || isAdminOrSupervisor()
            || isGlobalScreenAccess()
          );

        allow create: if (isAdmin() || isGlobalScreenAccess() || hasPermission('avisos', 'create') || hasPermission('avisos', 'manage'))
          && canAccessCongregationData(congregationId)
          && validNotificationData(request.resource.data, congregationId);

        allow update: if (
            (isAdmin() || isGlobalScreenAccess() || hasPermission('avisos', 'edit') || hasPermission('avisos', 'manage'))
            && canAccessCongregationData(congregationId)
            && validNotificationData(request.resource.data, congregationId)
          ) || (
            canAccessCongregationData(congregationId)
            && resource.data.userId == currentUid()
            && request.resource.data.congregationId == resource.data.congregationId
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.title == resource.data.title
            && request.resource.data.body == resource.data.body
            && request.resource.data.type == resource.data.type
            && (
              !('relatedId' in resource.data)
              || request.resource.data.relatedId == resource.data.relatedId
            )
            && sameKeysOnUpdate(['isRead', 'readAt'])
            && request.resource.data.isRead is bool
            && (!('readAt' in request.resource.data) || request.resource.data.readAt is string)
          );

        allow delete: if isAdmin();
      }

      // -----------------------------------------------------------------------
      // PREACHING REPORTS
      // -----------------------------------------------------------------------
      match /preachingReports/{monthId}/submissions/{userId} {
        allow get: if canAccessCongregationData(congregationId)
          && (
            isSameUser(userId)
            || isPreachingManager()
            || isAdminOrSupervisor()
            || isGlobalScreenAccess()
          );

        allow list: if canAccessCongregationData(congregationId)
          && (
            isPreachingManager()
            || isAdminOrSupervisor()
            || isGlobalScreenAccess()
          );

        allow create, update: if canAccessCongregationData(congregationId)
          && isSameUser(userId)
          && validPreachingReportWrite(request.resource.data, congregationId, monthId, userId);

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // BILLING HISTORY
      // Historial de eventos Stripe. Escritura exclusiva de Cloud Functions.
      // -----------------------------------------------------------------------
      match /billingHistory/{eventId} {
        allow get, list: if canAccessCongregationData(congregationId)
          && (
            isAdminOrSupervisor()
            || isGlobalScreenAccess()
            || hasPermission('pagos', 'view')
            || hasPermission('pagos', 'manage')
          );

        allow create, update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // CHANGE LOGS
      // -----------------------------------------------------------------------
      match /changeLogs/{logId} {
        allow get, list: if (isAdminOrSupervisor() || isGlobalScreenAccess())
          && canAccessCongregationData(congregationId);

        allow create: if isActive()
          && canAccessCongregationData(congregationId)
          && validChangeLogData(request.resource.data, congregationId);

        allow update, delete: if false;
      }
    }

    // =========================================================================
    // REGLAS: DASHBOARD SUMMARY
    // Documento de resumen pre-calculado por Cloud Functions.
    // Solo lectura para usuarios activos de la misma congregacion.
    // Escritura reservada exclusivamente para Cloud Functions.
    // =========================================================================

    match /dashboardSummary/{congregationId} {
      allow read: if isSuperAdmin() || canAccessCongregationData(congregationId);
      allow write: if false;
    }

    // =========================================================================
    // REGLAS: CLEANING GROUPS
    // Grupos de limpieza - acceso por congregacion.
    // =========================================================================

    match /cleaningGroups/{groupId} {
      // Coleccion raiz legacy cerrada para mantener el aislamiento por
      // congregacion en /congregations/{id}/cleaningGroups.
      allow read, write: if false;
    }

    match /cleaning_groups/{groupId} {
      // Coleccion raiz legacy cerrada para evitar duplicar reglas y mantener
      // el acceso moderno en /congregations/{id}/cleaningGroups.
      allow read, write: if false;
    }

    // =========================================================================
    // REGLAS: NOTIFICATIONS (coleccion raiz)
    // Nota: las notificaciones de congregacion estan en
    // /congregations/{id}/notifications. Esta coleccion raiz es para
    // notificaciones globales o de sistema (si se usan).
    // =========================================================================

    match /notifications/{notificationId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
