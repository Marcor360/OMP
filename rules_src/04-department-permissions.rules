    // Fase 0: helper compartido por permissions (otorgado a mano) y
    // derivedPermissions (calculado del cargo por
    // functions/src/users/derived-permissions-trigger.ts). 'manage' sigue
    // siendo superconjunto de las demas acciones, pero DENTRO de cada mapa por
    // separado -- un 'manage' en permissions no se filtra a derivedPermissions
    // ni viceversa, cada fuente se evalua de forma independiente.
    function permissionFlag(source, department, action) {
      return source is map
        && source[department] is map
        && (
          source[department][action] == true
          || (
            action != 'manage'
            && source[department].manage == true
          )
        );
    }

    // Espejo en functions/src/shared/permissions.ts. Si cambia alla, cambia
    // aqui tambien.
    function hasPermission(department, action) {
      return isActive()
        && (
          permissionFlag(currentUserData().permissions, department, action)
          || permissionFlag(currentUserData().derivedPermissions, department, action)
        );
    }

    function hasTerritoryPermission(action) {
      return isActive()
        && currentUserData().permissions is map
        && currentUserData().permissions.predicacion is map
        && currentUserData().permissions.predicacion.territories is map
        && (
          currentUserData().permissions.predicacion.territories[action] == true
          || currentUserData().permissions.predicacion.territories.manage == true
        );
    }

    function hasPreachingAssignment(position) {
      return isActive()
        && (
          (
            currentUserData().servicePosition == position
            && (
              currentUserData().serviceDepartment == 'predicacion'
              || currentUserData().serviceDepartment == 'territorios'
            )
          )
          || hasServiceAssignmentKey(position, 'predicacion')
          || hasServiceAssignmentKey(position, 'territorios')
        );
    }

    function canCreateTerritories() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('create'));
    }

    function canEditTerritories() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('edit'));
    }

    function canDeactivateTerritories() {
      return administrativeWritesAllowed(myCongregationId())
        && (isAdmin() || hasPreachingAssignment('encargado') || hasTerritoryPermission('delete'));
    }

    function canManageDepartments(congregationId) {
      return canAccessCongregationData(congregationId)
        && administrativeWritesAllowed(congregationId)
        && (
          isGlobalScreenAccess()
          || hasServicePosition('coordinador')
          || hasServicePosition('secretario')
        );
    }

    function canManageTerritorySchedule() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || hasPreachingAssignment('encargado')
          || hasPermission('predicacion', 'manage')
          || hasTerritoryPermission('manage')
          || hasTerritoryPermission('assign')
        );
    }

    function canManagePreachingGroups() {
      return administrativeWritesAllowed(myCongregationId())
        && (
          isAdmin()
          || hasPreachingAssignment('encargado')
          || hasTerritoryPermission('manage')
        );
    }

    // Espejo en rules de canViewBilling() de functions/src/shared/billing-access.ts.
    // Si cambia alla, cambia aqui. Son la misma decision escrita dos veces
    // porque las rules no pueden importar TypeScript.
