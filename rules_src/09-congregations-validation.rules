    // =========================================================================
    // CONGREGATIONS
    // =========================================================================

    // Reservado para validación futura desde Functions: ya no se usa en
    // rules_src/21-congregations-people-meetings.rules porque create/update
    // del documento de congregación está cerrado a cliente (allow if false).
    // No borrar; hasOnlyKeys() aquí no puede validar mapas gestionados por el
    // backend (billing, billingExemption) porque request.resource.data es el
    // documento resultante completo, no el delta del update.
    function allowedCongregationKeys() {
      return [
        'name',
        'code',
        'country',
        'state',
        'city',
        'language',
        'timezone',
        'isActive',
        'createdAt',
        'updatedAt'
      ];
    }

    function validCongregationData(data) {
      return hasOnlyKeys(data, allowedCongregationKeys())
        && hasAllKeys(data, ['name', 'isActive'])
        && isNonEmptyString(data.name)
        && data.isActive is bool
        && (!('code' in data) || data.code is string)
        && (!('country' in data) || data.country is string)
        && (!('state' in data) || data.state is string)
        && (!('city' in data) || data.city is string)
        && (!('language' in data) || data.language is string)
        && (!('timezone' in data) || data.timezone is string);
    }

