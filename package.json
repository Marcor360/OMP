{
  "name": "omp",
  "main": "expo-router/entry",
  "version": "1.34.3",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/copy-web-htaccess.js",
    "preview:web": "npx serve dist --single",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:rules": "node build-rules.js",
    "check:rules": "node build-rules.js --check",
    "test:rules": "npm run build:rules && firebase emulators:exec --only firestore --project demo-omp \"jest --config jest.rules.config.js --runInBand\"",
    "check:indexes": "node scripts/check-collection-group-indexes.mjs",
    "validate": "npm run check:indexes && npm run lint && tsc --noEmit && npm test -- --runInBand && npm --prefix functions run lint && npm --prefix functions run build && npm --prefix functions test -- --runInBand && npx expo-doctor",
    "deploy:rules": "npm run build:rules && node scripts/firebase-deploy-retry.js --only firestore:rules,firestore:indexes",
    "deploy:functions": "node scripts/firebase-deploy-retry.js --only functions",
    "deploy:all": "npm run deploy:rules && npm run deploy:functions",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.15",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "^57.0.9",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "^57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "^57.0.9",
    "expo-router": "^57.0.11",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.17.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "firebase-tools": "^14.23.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "postcss": "^8.5.25",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "brace-expansion@<1.1.18": "^1.1.18",
    "postcss@<8.5.25": "^8.5.25"
  }
}
